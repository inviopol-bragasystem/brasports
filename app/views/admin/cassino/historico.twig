{% extends layout %}

{% block main %}

    <!-- Resumo Rápido -->
    <div class="row">
        <div class="col-md-4 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter text-primary">{{ stats.total_rodadas }}</p>
                        <span class="info-box-title">Total de Rodadas Realizadas</span>
                    </div>
                    <div class="info-box-icon"><i class="fa fa-refresh text-primary"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter text-success">R$ {{ stats.total_apostado|number_format(2, ',', '.') }}</p>
                        <span class="info-box-title">Volume Total Apostado</span>
                    </div>
                    <div class="info-box-icon"><i class="fa fa-money text-success"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter text-info">{{ stats.total_jogadores }}</p>
                        <span class="info-box-title">Jogadores Distintos</span>
                    </div>
                    <div class="info-box-icon"><i class="fa fa-users text-info"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Histórico -->
    <div class="panel panel-white">
        <div class="panel-heading clearfix">
            <h4 class="panel-title"><i class="fa fa-history"></i> Histórico Recente de Giros & Transações</h4>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Data & Hora</th>
                            <th>Jogador</th>
                            <th>Jogo</th>
                            <th>Ação</th>
                            <th class="text-right">Valor</th>
                            <th class="text-right">Saldo Anterior</th>
                            <th class="text-right">Saldo Posterior</th>
                            <th>TxID</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for h in historico %}
                            <tr>
                                <td>#{{ h.id }}</td>
                                <td><small>{{ h.created_at|date('d/m/Y H:i:s') }}</small></td>
                                <td>
                                    <b>{{ h.user_nome ?: 'Usuário #' ~ h.user_id }}</b><br>
                                    <small class="text-muted">{{ h.user_login }}</small>
                                </td>
                                <td>
                                    <span class="font-weight-bold">{{ h.game_titulo ?: h.game_code }}</span><br>
                                    <small class="text-muted">{{ h.provider }}</small>
                                </td>
                                <td>
                                    {% if h.action == 'bet' %}
                                        <span class="label label-danger"><i class="fa fa-arrow-down"></i> Aposta</span>
                                    {% elseif h.action == 'win' %}
                                        <span class="label label-success"><i class="fa fa-arrow-up"></i> Prêmio</span>
                                    {% else %}
                                        <span class="label label-warning">{{ h.action|upper }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-right font-weight-bold {{ h.action == 'win' ? 'text-success' : 'text-danger' }}">
                                    R$ {{ h.amount|number_format(2, ',', '.') }}
                                </td>
                                <td class="text-right text-muted">R$ {{ h.balance_before|number_format(2, ',', '.') }}</td>
                                <td class="text-right font-weight-bold">R$ {{ h.balance_after|number_format(2, ',', '.') }}</td>
                                <td><code class="small">{{ h.txn_id|slice(0, 16) }}...</code></td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9" class="text-center text-muted p-20">Nenhuma rodada registrada ainda. Quando os usuários jogarem, as apostas aparecerão aqui em tempo real.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            <div class="row m-t-15">
                <div class="col-xs-6">
                    {% if page > 1 %}
                        <a href="{{ url('admin/cassino/historico') }}?page={{ page - 1 }}" class="btn btn-default btn-sm"><i class="fa fa-arrow-left"></i> Página Anterior</a>
                    {% endif %}
                </div>
                <div class="col-xs-6 text-right">
                    {% if historico|length == 50 %}
                        <a href="{{ url('admin/cassino/historico') }}?page={{ page + 1 }}" class="btn btn-default btn-sm">Próxima Página <i class="fa fa-arrow-right"></i></a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
