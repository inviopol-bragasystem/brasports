{% extends layout %}

{% block main %}

    <!-- Cards de Métricas Financeiras e GGR -->
    <div class="row">
        <div class="col-md-3 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter text-primary">R$ {{ stats.total_apostado|number_format(2, ',', '.') }}</p>
                        <span class="info-box-title">Total Apostado (Volume)</span>
                    </div>
                    <div class="info-box-icon"><i class="fa fa-money text-primary"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter text-danger">R$ {{ stats.total_pago|number_format(2, ',', '.') }}</p>
                        <span class="info-box-title">Total Pago (Prêmios)</span>
                    </div>
                    <div class="info-box-icon"><i class="fa fa-gift text-danger"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter text-success">R$ {{ stats.ggr_lucro|number_format(2, ',', '.') }}</p>
                        <span class="info-box-title">Lucro Bruto (GGR da Banca)</span>
                    </div>
                    <div class="info-box-icon"><i class="fa fa-bank text-success"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter text-warning">{{ stats.rtp_real > 0 ? stats.rtp_real : settings.rtp_default }}%</p>
                        <span class="info-box-title">RTP Efetivo Atual</span>
                    </div>
                    <div class="info-box-icon"><i class="fa fa-pie-chart text-warning"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Painel de Controle de RTP -->
    <div class="row">
        <div class="col-md-7 col-xs-12">
            <div class="panel panel-white">
                <div class="panel-heading clearfix">
                    <h4 class="panel-title"><i class="fa fa-sliders text-primary"></i> Ajuste Geral de Retorno ao Jogador (RTP)</h4>
                </div>
                <div class="panel-body">
                    <form id="form-rtp">
                        <div class="form-group">
                            <label class="font-weight-bold">RTP Padrão para Jogadores Comuns (%)</label>
                            <div class="input-group">
                                <input type="number" step="0.1" name="rtp_default" id="rtp_default_input" class="form-control font-weight-bold" value="{{ settings.rtp_default }}" min="1" max="100" required>
                                <span class="input-group-addon">%</span>
                            </div>
                            <input type="range" class="form-control m-t-10" min="70" max="99" step="0.5" value="{{ settings.rtp_default }}" oninput="$('#rtp_default_input').val(this.value)">
                            <small class="help-block">Média padrão de retorno das apostas aos jogadores. (Padrão de mercado: 95% a 97%).</small>
                        </div>

                        <div class="form-group m-t-20">
                            <label class="font-weight-bold">RTP para Contas Influenciadores / Demos (%)</label>
                            <div class="input-group">
                                <input type="number" step="0.1" name="rtp_influencer" id="rtp_influencer_input" class="form-control font-weight-bold" value="{{ settings.rtp_influencer }}" min="1" max="100" required>
                                <span class="input-group-addon">%</span>
                            </div>
                            <input type="range" class="form-control m-t-10" min="80" max="100" step="0.5" value="{{ settings.rtp_influencer }}" oninput="$('#rtp_influencer_input').val(this.value)">
                            <small class="help-block">Probabilidade turbinada para contas marcadas como influencers ou streamers.</small>
                        </div>

                        <div class="text-right m-t-20">
                            <button type="submit" class="btn btn-primary font-weight-bold"><i class="fa fa-save"></i> Salvar Parâmetros de RTP</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-5 col-xs-12">
            <div class="panel panel-white">
                <div class="panel-heading">
                    <h4 class="panel-title"><i class="fa fa-question-circle text-info"></i> O que é RTP (Return to Player)?</h4>
                </div>
                <div class="panel-body">
                    <p class="small text-muted">
                        O <b>RTP</b> define a porcentagem teórica que as máquinas pagam de volta aos apostadores ao longo de milhares de rodadas.
                    </p>
                    <ul class="small text-muted p-l-20">
                        <li><b>RTP de 95%:</b> A cada R$ 1.000 apostados, cerca de R$ 950 retornam em prêmios e R$ 50 ficam de lucro bruto (GGR) para a sua banca.</li>
                        <li><b>RTP de 97%:</b> Jogos mais soltos e com premiações mais frequentes.</li>
                        <li><b>Controle de Volatilidade:</b> O motor PGV4 equilibra os ganhos baseado no percentual configurado acima.</li>
                    </ul>
                    <div class="m-t-15">
                        <a href="{{ url('admin/cassino/historico') }}" class="btn btn-sm btn-default btn-block">
                            <i class="fa fa-history"></i> Ver Histórico Detalhado de Rodadas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block script %}
    <script>
        $('#form-rtp').submit(function(e) {
            e.preventDefault();
            $.post('{{ url("admin/cassino/rtp/salvar") }}', $(this).serialize(), function(res) {
                if (res.result) {
                    swal('Sucesso!', res.message, 'success');
                } else {
                    swal('Erro', res.message || 'Falha ao salvar.', 'error');
                }
            }, 'json');
        });
    </script>
{% endblock %}
