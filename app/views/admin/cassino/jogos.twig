{% extends layout %}

{% block main %}

    <!-- Cabeçalho Informativo & Resumo -->
    <div class="row">
        <div class="col-md-3 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter">{{ jogos|length }}</p>
                        <span class="info-box-title">Jogos Listados</span>
                    </div>
                    <div class="info-box-icon">
                        <i class="fa fa-gamepad text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter">{{ providers|length }} Provedores</p>
                        <span class="info-box-title">Agregador Ativo</span>
                    </div>
                    <div class="info-box-icon">
                        <i class="fa fa-server text-success"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p class="counter">{{ settings.rtp_default }}%</p>
                        <span class="info-box-title">RTP Padrão</span>
                    </div>
                    <div class="info-box-icon">
                        <i class="fa fa-percent text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="panel info-box panel-white">
                <div class="panel-body">
                    <div class="info-box-stats">
                        <p><span class="badge {{ settings.active ? 'badge-success' : 'badge-danger' }}">{{ settings.active ? 'ONLINE' : 'PAUSADO' }}</span></p>
                        <span class="info-box-title">Status da API</span>
                    </div>
                    <div class="info-box-icon">
                        <i class="fa fa-power-off {{ settings.active ? 'text-success' : 'text-danger' }}"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros de Provedor, Categoria e Pesquisa -->
    <div class="panel panel-white m-b-15">
        <div class="panel-body">
            <form method="get" class="row">
                <div class="col-md-3 col-sm-6 m-b-xs">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Buscar jogo..." value="{{ search }}">
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="submit"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 m-b-xs">
                    <select name="provider" class="form-control" onchange="this.form.submit()">
                        <option value="all" {% if not provider or provider == 'all' %}selected{% endif %}>Todos os Provedores (Todos)</option>
                        <option value="PRAGMATIC" {% if provider == 'PRAGMATIC' %}selected{% endif %}>Pragmatic Play (Slots & Ao Vivo)</option>
                        <option value="PGSOFT" {% if provider == 'PGSOFT' %}selected{% endif %}>PG Soft (Fortune Tiger, Ox, Rabbit...)</option>
                        <option value="TADA" {% if provider == 'TADA' %}selected{% endif %}>TaDa Gaming</option>
                        <option value="CPGAMES" {% if provider == 'CPGAMES' %}selected{% endif %}>CP Games</option>
                        <option value="POPOK" {% if provider == 'POPOK' %}selected{% endif %}>PopOK Gaming</option>
                        <option value="WG" {% if provider == 'WG' %}selected{% endif %}>World Games (WG)</option>
                        <option value="CRASH" {% if provider == 'CRASH' %}selected{% endif %}>Crash Games (Aviator, Mines, etc.)</option>
                        <option value="G759" {% if provider == 'G759' %}selected{% endif %}>G759</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6 m-b-xs">
                    <select name="category" class="form-control" onchange="this.form.submit()">
                        <option value="all" {% if not category or category == 'all' %}selected{% endif %}>Todas Categorias</option>
                        <option value="Fortune" {% if category == 'Fortune' %}selected{% endif %}>Série Fortune</option>
                        <option value="Crash" {% if category == 'Crash' %}selected{% endif %}>Crash & Spribe</option>
                        <option value="Slots" {% if category == 'Slots' %}selected{% endif %}>Slots Clássicos</option>
                        <option value="Destaque" {% if category == 'Destaque' %}selected{% endif %}>Destaques</option>
                        <option value="Popular" {% if category == 'Popular' %}selected{% endif %}>Mais Populares</option>
                        <option value="Novos" {% if category == 'Novos' %}selected{% endif %}>Lançamentos</option>
                    </select>
                </div>
                <div class="col-md-4 col-sm-12 text-right">
                    <button type="button" class="btn btn-success" onclick="sincronizarCatalogo()" title="Buscar novos jogos do agregador"><i class="fa fa-refresh"></i> Sincronizar Catálogo</button>
                    <a href="{{ url('admin/cassino/api') }}" class="btn btn-default"><i class="fa fa-cogs"></i> API</a>
                    <a href="{{ url('admin/cassino/rtp') }}" class="btn btn-default"><i class="fa fa-percent"></i> RTP</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Jogos -->
    <div class="panel panel-white">
        <div class="panel-heading clearfix">
            <h4 class="panel-title"><i class="fa fa-list"></i> Catálogo de Jogos do Cassino ({{ jogos|length }} jogos exibidos)</h4>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="width: 60px;">Capa</th>
                            <th>Nome do Jogo</th>
                            <th>Provedor</th>
                            <th>Código</th>
                            <th>Categoria</th>
                            <th>RTP (%)</th>
                            <th class="text-center">Destaque</th>
                            <th class="text-center">Visibilidade</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for j in jogos %}
                            <tr>
                                <td>
                                    <img src="{{ j.image }}" alt="{{ j.name }}" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.15);" onerror="this.src='imagens/sem-imagem.png'">
                                </td>
                                <td>
                                    <b style="font-size: 13px;">{{ j.name }}</b><br>
                                    <small class="text-muted"><i class="fa fa-eye"></i> {{ j.views_count }} acessos</small>
                                </td>
                                <td>
                                    {% if j.provider == 'PGSOFT' %}
                                        <span class="label label-primary" style="background-color: #6f42c1; border-color: #6f42c1;">PG SOFT</span>
                                    {% elseif j.provider == 'PRAGMATIC' or j.provider == 'PRAGMATICPLAY' %}
                                        <span class="label label-danger" style="background-color: #e83e8c; border-color: #e83e8c;">PRAGMATIC</span>
                                    {% elseif j.provider == 'TADA' %}
                                        <span class="label label-info">TADA</span>
                                    {% elseif j.provider == 'CPGAMES' %}
                                        <span class="label label-warning" style="background-color: #fd7e14; border-color: #fd7e14;">CP GAMES</span>
                                    {% elseif j.provider == 'POPOK' %}
                                        <span class="label label-success">POPOK</span>
                                    {% elseif j.provider == 'WG' %}
                                        <span class="label label-warning">WG SLOTS</span>
                                    {% elseif j.provider == 'CRASH' or j.provider == 'AVIATOR' or j.provider == 'MINES' %}
                                        <span class="label label-danger">CRASH / SPRIBE</span>
                                    {% else %}
                                        <span class="label label-default">{{ j.provider }}</span>
                                    {% endif %}
                                </td>
                                <td><code>{{ j.game_code }}</code></td>
                                <td><span class="label label-default">{{ j.category }}</span></td>
                                <td style="width: 120px;">
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="0.01" class="form-control text-right" id="rtp-{{ j.id }}" value="{{ j.rtp }}">
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-default" onclick="salvarRtp({{ j.id }})" title="Salvar RTP"><i class="fa fa-check"></i></button>
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-xs {{ j.featured ? 'btn-warning' : 'btn-default' }}" onclick="toggleDestaque({{ j.id }}, {{ j.featured ? 0 : 1 }})" title="Alternar Destaque">
                                        <i class="fa {{ j.featured ? 'fa-star' : 'fa-star-o' }}"></i> {{ j.featured ? 'Destaque' : 'Normal' }}
                                    </button>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-xs {{ j.active ? 'btn-success' : 'btn-danger' }}" onclick="toggleStatus({{ j.id }}, {{ j.active ? 0 : 1 }})">
                                        <i class="fa {{ j.active ? 'fa-check' : 'fa-times' }}"></i> {{ j.active ? 'Ativado' : 'Desativado' }}
                                    </button>
                                </td>
                                <td class="text-center">
                                    <a href="{{ url('cassino/jogar/' ~ j.game_code) }}" target="_blank" class="btn btn-xs btn-info" title="Testar Jogo">
                                        <i class="fa fa-play"></i> Testar
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9" class="text-center text-muted p-20">Nenhum jogo encontrado com os filtros selecionados.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block script %}
    <script>
        function toggleStatus(id, novoStatus) {
            $.post('{{ url("admin/cassino/jogos/status") }}', { id: id, status: novoStatus }, function(res) {
                if (res.result) {
                    swal({ title: 'Sucesso!', text: res.message, type: 'success', timer: 1200, showConfirmButton: false });
                    setTimeout(function() { location.reload(); }, 1200);
                } else {
                    swal('Erro', res.message || 'Falha ao atualizar status.', 'error');
                }
            }, 'json');
        }

        function toggleDestaque(id, novoDestaque) {
            $.post('{{ url("admin/cassino/jogos/destaque") }}', { id: id, featured: novoDestaque }, function(res) {
                if (res.result) {
                    swal({ title: 'Sucesso!', text: res.message, type: 'success', timer: 1200, showConfirmButton: false });
                    setTimeout(function() { location.reload(); }, 1200);
                } else {
                    swal('Erro', res.message || 'Falha ao atualizar destaque.', 'error');
                }
            }, 'json');
        }

        function salvarRtp(id) {
            var rtp = $('#rtp-' + id).val();
            $.post('{{ url("admin/cassino/jogos/rtp") }}', { id: id, rtp: rtp }, function(res) {
                if (res.result) {
                    swal({ title: 'RTP Atualizado!', text: res.message, type: 'success', timer: 1200, showConfirmButton: false });
                } else {
                    swal('Erro', res.message || 'Falha ao salvar RTP.', 'error');
                }
            }, 'json');
        }

        function sincronizarCatalogo() {
            swal({
                title: 'Sincronizar Catálogo?',
                text: 'Buscar todos os jogos e capas atualizadas do Agregador?',
                type: 'info',
                showCancelButton: true,
                confirmButtonColor: '#27ae60',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sim, Sincronizar',
                cancelButtonText: 'Cancelar',
                closeOnConfirm: false,
                showLoaderOnConfirm: true
            }, function() {
                $.post('{{ url("admin/cassino/api/sincronizar") }}', {}, function(res) {
                    if (res.result) {
                        swal('Sincronizado!', res.message, 'success');
                        setTimeout(function() { location.reload(); }, 1500);
                    } else {
                        swal('Erro', res.message || 'Falha na sincronização.', 'error');
                    }
                }, 'json').fail(function() {
                    swal('Erro', 'Falha ao conectar com o servidor.', 'error');
                });
            });
        }
    </script>
{% endblock %}
