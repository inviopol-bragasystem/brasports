{% extends layout %}

{% block main %}

    <div class="gold-card m-3">
        <div class="gold-card-header">
            <i class="fa fa-user-circle"></i> Meu Perfil
        </div>

        <div class="p-3 mb-4 rounded d-flex justify-content-between align-items-center" style="background: #000; color: #fff;">
            <div>
                <h4 class="m-0 font-weight-bold" style="color: #d29d00;">{{ user.getNome() }}</h4>
                <span class="small text-muted">@{{ user.getLogin() }} &bull; {{ user.getEmail() }}</span>
            </div>
            <div class="text-right">
                <span class="small d-block text-muted">Saldo em Conta</span>
                <span class="font-weight-bold" style="font-size: 20px; color: #28a745;">R$ {{ user.getCredito(true) }}</span>
            </div>
        </div>

        <form class="admpage-form" method="post" action="{{ url('perfil/salvar') }}">
            <div class="row">
                <div class="col-md-6 form-group">
                    <label class="small font-weight-bold">NOME</label>
                    <input type="text" name="nome" value="{{ user.getNome() }}" class="form-control" required/>
                </div>
                <div class="col-md-6 form-group">
                    <label class="small font-weight-bold">E-MAIL</label>
                    <input type="email" name="email" value="{{ user.getEmail() }}" class="form-control" required/>
                </div>
                <div class="col-md-6 form-group">
                    <label class="small font-weight-bold">WHATSAPP / CELULAR</label>
                    <input type="text" name="celular" value="{{ user.getCelular()|default(user.getTelefone()) }}" class="form-control mask-telefone"/>
                </div>
                <div class="col-md-6 form-group">
                    <label class="small font-weight-bold">TELEFONE ADICIONAL</label>
                    <input type="text" name="telefone" value="{{ user.getTelefone() }}" class="form-control mask-telefone"/>
                </div>
            </div>

            <hr/>
            <h6 class="font-weight-bold mb-3" style="color: #d29d00;"><i class="fa fa-lock mr-1"></i> Alteração de Senha</h6>

            <div class="row">
                <div class="col-md-4 form-group">
                    <label class="small font-weight-bold">NOVA SENHA (opcional)</label>
                    <input type="password" name="nsenha" class="form-control" placeholder="Deixe em branco para não alterar"/>
                </div>
                <div class="col-md-4 form-group">
                    <label class="small font-weight-bold">CONFIRMAR NOVA SENHA</label>
                    <input type="password" name="nsenhar" class="form-control" placeholder="Repita a nova senha"/>
                </div>
                <div class="col-md-4 form-group">
                    <label class="small font-weight-bold">SENHA ATUAL * (obrigatório)</label>
                    <input type="password" name="senha" class="form-control" required placeholder="Digite a senha atual"/>
                </div>
            </div>

            <div class="text-right mt-3">
                <button type="submit" class="botao">
                    <i class="fa fa-save"></i> Salvar Alterações
                </button>
            </div>
        </form>
    </div>

{% endblock %}

{% block script %}
    <script>
        $('.admpage-form')
            .adminPage({
                autoSearch: false,
                controller: 'perfil',
                insertAction: 'salvar',
                alertSuccess: true,
            });
    </script>
{% endblock %}

