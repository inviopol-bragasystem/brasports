{% extends layout %}

{% set hoje = 'now'|date('Y-m-d') %}
{% set amanha = '+1day'|date('Y-m-d') %}
{% set selector = '#website' %}
{% set listaBanners = banners('site-slideshow', null, null, 10) %}

{% block main %}

    <div class="main-row" v-cloak>

        <!-- ========================================================
             ================= VERSÃO DESKTOP (1160px) =================
             ======================================================== -->
        <div class="desktop-only" style="width: 100%;">

            <!-- COLUNA ESQUERDA: CAMPEONATOS (230px, scroll 819px) -->
            <aside class="cl-left">
                <div id="m-menu" class="list-group">
                    <span class="menu-header-badge">
                        <span class="menu-dot"></span>Campeonatos
                    </span>

                    <!-- Filtros Rápidos de Data -->
                    <a href="javascript:;" class="list-group-item list-group-item-action"
                       :class="{ active: (!findData || findData == 'todos') && (!findCampeonato || findCampeonato == '*') && (!findPais || findPais == '*') }"
                       v-on:click="setCampeonato(); setData('todos');">
                        <span><i class="fa fa-globe mr-1"></i> Todos os Jogos</span>
                    </a>

                    <a href="javascript:;" class="list-group-item list-group-item-action"
                       :class="{ active: findData == '{{ hoje }}' }"
                       v-on:click="setData('{{ hoje }}')">
                        <span>Jogos hoje ({{ hoje|split('-')|reverse|join('/') }})</span>
                    </a>

                    <a href="javascript:;" class="list-group-item list-group-item-action"
                       :class="{ active: findData == '{{ amanha }}' }"
                       v-on:click="setData('{{ amanha }}')">
                        <span>Jogos amanhã ({{ amanha|split('-')|reverse|join('/') }})</span>
                    </a>

                    <!-- Outras datas com jogos -->
                    <a v-for="d in datas" :key="d.data"
                       v-if="d.data != '{{ hoje }}' && d.data != '{{ amanha }}'"
                       href="javascript:;" class="list-group-item list-group-item-action"
                       :class="{ active: findData == d.data }"
                       v-on:click="setData(d.data)">
                        <span>${d.title}</span>
                    </a>

                    <!-- Lista de Campeonatos -->
                    <template v-for="pais in paises">
                        <a v-for="c in pais.campeonatos" :key="c.id"
                           href="javascript:;" class="list-group-item list-group-item-action"
                           :class="{ active: findCampeonato == c.id }"
                           v-on:click="setCampeonato(c)">
                            <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 175px;">
                                <img v-if="pais.img" class="flag-camp" :src="pais.img" alt=""/>
                                <i v-else class="fa fa-trophy mr-1" style="color: #d29d00;"></i>
                                ${pais.title} - ${c.title}
                            </span>
                            <span class="pa-icon">PA</span>
                        </a>
                    </template>
                </div>
            </aside>

            <!-- COLUNA DO MEIO: BANNERS (270px) + TABELA DE JOGOS (590px) -->
            <section class="cl-center-container">

                <!-- Carrossel Clássico Oficial (270px) -->
                <div id="carouselExampleIndicators" class="carousel slide gold-carousel" data-ride="carousel">
                    <ol class="carousel-indicators">
                        {% if listaBanners|length > 0 %}
                            {% for i, b in listaBanners %}
                                <li data-target="#carouselExampleIndicators" data-slide-to="{{ i }}" class="{{ i == 0 ? 'active' : '' }}"></li>
                            {% endfor %}
                        {% else %}
                            <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
                            <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                            <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                        {% endif %}
                    </ol>
                    <div class="carousel-inner">
                        {% if listaBanners|length > 0 %}
                            {% for i, b in listaBanners %}
                                <div class="carousel-item {{ i == 0 ? 'active' : '' }}">
                                    <img src="{{ b.imgCapa(true, 'desktop').getSource(true) }}" alt="{{ b.getTitle() }}">
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="carousel-item active">
                                <img src="cdn/goldesporte/banner1.jpeg" alt="GoldEsporte">
                            </div>
                            <div class="carousel-item">
                                <img src="cdn/goldesporte/banner2.jpeg" alt="GoldEsporte">
                            </div>
                            <div class="carousel-item">
                                <img src="cdn/goldesporte/banner3.jpeg" alt="GoldEsporte">
                            </div>
                        {% endif %}
                    </div>
                    <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="sr-only">Anterior</span>
                    </a>
                    <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="sr-only">Próximo</span>
                    </a>
                </div>

                <!-- Tabela de Jogos com Barra de Busca e Scroll (520px) -->
                <div class="scroll-games">
                    <div class="table-search-bar">
                        <div class="search-title">
                            <i class="fa fa-sort-amount-desc"></i>
                            <span v-if="findData == '{{ hoje }}'">Jogos de hoje</span>
                            <span v-else-if="findData == '{{ amanha }}'">Jogos de amanhã</span>
                            <span v-else-if="findData && findData != 'todos'">Jogos (${findData.split('-').reverse().join('/')})</span>
                            <span v-else>Todos os Jogos</span>
                        </div>

                        <div class="inner-addon left-addon">
                            <i class="fa fa-search glyphicon"></i>
                            <input id="txtPesquisar" class="form-control" type="text" v-model="search" placeholder="Buscar jogos por nome ou horário">
                        </div>
                    </div>

                    <!-- Tabela Única Clássica (noround) -->
                    <table class="table noround">
                        <thead>
                            <tr>
                                <th class="t-left first-col" style="width: 44%;">Casa <br>Visitante</th>
                                <th width="58px">Casa</th>
                                <th width="58px">Empate</th>
                                <th width="58px">Fora</th>
                                <th width="58px"></th>
                            </tr>
                        </thead>
                        <tbody id="mainJogos">
                            <template v-for="pais in paises" v-if="filterPais(pais)">
                                <template v-for="campeonato in getCampeonatos(pais, true)">
                                    <tr class="lblCamps">
                                        <td class="title" colspan="5">
                                            <img v-if="pais.img" class="flag-camp" :src="pais.img" alt="">
                                            ${pais.title} - ${campeonato.title}
                                        </td>
                                    </tr>

                                    <tr v-for="(jogo, jIdx) in getJogos(campeonato)" :key="'j-' + jogo.id"
                                        :class="jIdx % 2 === 0 ? 'par confronto' : 'impar confronto'">
                                        <td class="t-left first-col">
                                            <a class="tagTimes" href="javascript:;" v-on:click="maisCotacoes(jogo)" title="Mais opções de apostas">
                                                <div class="d-flex align-items-center mb-1">
                                                    <img v-if="jogo.imgCasa" :src="jogo.imgCasa" class="gold-team-crest mr-1" style="width:16px;height:16px;object-fit:contain;" onerror="this.style.display='none'">
                                                    <b>${jogo.casa}</b>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <img v-if="jogo.imgFora" :src="jogo.imgFora" class="gold-team-crest mr-1" style="width:16px;height:16px;object-fit:contain;" onerror="this.style.display='none'">
                                                    <b>${jogo.fora}</b>
                                                </div>
                                            </a>
                                            <span class="dt">
                                                <i class="fa fa-clock-o"></i> ${jogo.data.split('-').reverse().join('/')} ${jogo.hora.replace(/:00$/, '')}
                                            </span>
                                        </td>

                                        <td v-for="c in getCotacoesPrincipais()" :key="c.campo">
                                            <a class="bd badge-info"
                                               :class="{ 'odd-active': jogo.apostaEm == '90' + c.campo }"
                                               href="javascript:;"
                                               v-on:click="apostar(jogo, '90', c)">
                                                ${(jogo.cotacoes && jogo.cotacoes['90'] && jogo.cotacoes['90'][c.campo]) ? maskReal(jogo.cotacoes['90'][c.campo]) : '-'}
                                            </a>
                                        </td>

                                        <td>
                                            <a class="bd badge-info" style="font-weight: normal; font-style: italic;"
                                               href="javascript:;"
                                               v-on:click="maisCotacoes(jogo)"
                                               title="Mais opções de apostas">
                                                +${Math.max(0, totalCotacoes(jogo.cotacoes) - getCotacoesPrincipais().length)}
                                            </a>
                                        </td>
                                    </tr>
                                </template>
                            </template>

                            <tr v-if="!paises || getCampeonatos(null, true).length === 0">
                                <td colspan="5" style="padding: 45px 15px; text-align: center; color: #888;">
                                    <i class="fa fa-calendar-times-o fa-2x mb-2 d-block text-secondary"></i>
                                    Nenhum jogo disponível para a seleção atual.<br>
                                    <a href="javascript:;" v-on:click="setData('todos')" style="color: #d29d00; font-weight: bold; text-decoration: underline; margin-top: 8px; display: inline-block;">
                                        Clique aqui para ver todos os jogos
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </section>

            <!-- COLUNA DIREITA: CUPOM / BILHETE CLÁSSICO (300px) -->
            <aside class="cl-right">
                <div class="header-bilhete">
                    <i class="fa fa-ticket mr-1"></i> Bilhete
                </div>

                <div id="resultados" class="content">
                    <div class="jogos-scroll">
                        <div v-if="aposta.jogos.length === 0" style="text-align: center; color: #888; padding: 60px 10px; font-size: 13px;">
                            <i class="fa fa-hand-pointer-o fa-2x mb-2 d-block text-secondary"></i>
                            Clique nas cotações para montar o seu bilhete.
                        </div>

                        <table v-else class="jg-s table-striped">
                            <tbody>
                                <tr v-for="(v, i) in aposta.jogos" :key="i">
                                    <td style="text-align: left; padding: 6px 4px;">
                                        <div style="font-weight: 700; font-size: 12px; color: #111;">
                                            <img v-if="v.jogo.imgCasa" :src="v.jogo.imgCasa" style="width:14px;height:14px;object-fit:contain;vertical-align:middle;margin-right:2px;" onerror="this.style.display='none'">${v.jogo.casa} x <img v-if="v.jogo.imgFora" :src="v.jogo.imgFora" style="width:14px;height:14px;object-fit:contain;vertical-align:middle;margin-right:2px;" onerror="this.style.display='none'">${v.jogo.fora}
                                        </div>
                                        <div style="font-size: 11px; color: #666; margin-top: 2px;">
                                            <span>${v.cotacao.title || v.cotacao.sigla}: <b style="color: #000;">${maskReal(v.jogo.cotacoes[v.tempo][v.cotacao.campo])}</b></span>
                                            <span v-if="v.tempo != '90'" class="badge badge-secondary ml-1" style="font-size: 9px;">${v.tempo == 'pt' ? '1ºT' : '2ºT'}</span>
                                        </div>
                                    </td>
                                    <td style="width: 25px; text-align: right; vertical-align: middle; padding-right: 4px;">
                                        <a href="javascript:;" v-on:click="rmAposta(i)" style="color: #dc3545; font-size: 14px;" title="Remover jogo">
                                            <i class="fa fa-times"></i>
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="info" style="margin-top: 10px;">
                        <table class="jg-s" style="width: 100%;">
                            <tr>
                                <td style="padding: 0 4px 6px 0;">
                                    <h5 id="valor-cotacao" style="text-align: center; float: left; min-width: 60px; padding: 5px 8px; background: #DDD; color: #333; border-radius: 4px; font-size: 14px; font-weight: bold; margin: 0;">
                                        ${valorCotacao}
                                    </h5>
                                </td>
                                <td style="padding: 0 0 6px 4px; width: 60px;">
                                    <h5 style="text-align: center; float: right; width: 50px; padding: 5px; background: #DDD; color: #333; border-radius: 4px; font-size: 14px; font-weight: bold; margin: 0;">
                                        ${aposta.jogos.length}
                                    </h5>
                                </td>
                            </tr>

                            <tr id="valor-premio">
                                <td style="padding: 0 4px 6px 0;">
                                    <div class="inner-addon left-addon">
                                        <i class="fa fa-dollar glyphicon"></i>
                                        <input id="valor-aposta" v-model="valorAposta" class="form-control" placeholder="Valor" style="height: 36px; font-size: 13px; font-weight: bold;" />
                                    </div>
                                </td>
                                <td style="padding: 0 0 6px 4px;">
                                    <input class="form-control" readonly disabled type="text" :value="'R$ ' + premio" style="height: 36px; font-size: 13px; font-weight: bold; text-align: right; background: #f0f0f0; color: #111;" />
                                </td>
                            </tr>

                            {% if not user %}
                            <tr class="pixinputs" style="display: table-row;">
                                <td colspan="2" style="padding: 0;">
                                    <div class="inner-addon left-addon">
                                        <i class="fa fa-user glyphicon"></i>
                                        <input class="form-control" type="text" name="cliente" v-model="cliente" placeholder="Nome do cliente (opcional)" style="height: 34px; font-size: 13px;">
                                    </div>
                                </td>
                            </tr>
                            {% endif %}
                        </table>
                    </div>

                    <div v-if="aposta.jogos.length > 0 && aposta.jogos.length < minJogos" class="alert alert-warning py-1 px-2 mt-2 mb-0 text-center small font-weight-bold">
                        Mínimo de jogos: ${minJogos}
                    </div>

                    <button type="button" v-on:click="limpaAposta" style="width: 22%; margin-top: 8px; float: left; font-weight: 700; font-size: 16px; height: 38px;" class="botao" title="Limpar seleções">
                        <i class="fa fa-undo"></i>
                    </button>

                    <button type="button" :disabled="!apostaValida" v-on:click="finalizarAposta" style="width: 75%; float: right; margin-top: 8px; font-weight: 700; font-size: 14px; height: 38px;" class="botao">
                        <i class="fa fa-check"></i> {{ user ? 'Confirmar' : 'Validar Bilhete' }}
                    </button>

                    <div class="clear"></div>
                </div>
            </aside>

            <div class="clear"></div>
        </div>


        <!-- ========================================================
             ================= VERSÃO MOBILE OFICIAL =================
             Referência: https://www.goldesportebet.com/mobile/
             ======================================================== -->
        <div class="mobile-only" style="width: 100%;">

            <!-- 1. Carrossel de Banners Mobile (150px) -->
            <div id="carouselMobile" class="carousel slide mobile-carousel" data-ride="carousel">
                <ol class="carousel-indicators">
                    {% if listaBanners|length > 0 %}
                        {% for i, b in listaBanners %}
                            <li data-target="#carouselMobile" data-slide-to="{{ i }}" class="{{ i == 0 ? 'active' : '' }}"></li>
                        {% endfor %}
                    {% else %}
                        <li data-target="#carouselMobile" data-slide-to="0" class="active"></li>
                        <li data-target="#carouselMobile" data-slide-to="1"></li>
                        <li data-target="#carouselMobile" data-slide-to="2"></li>
                    {% endif %}
                </ol>
                <div class="carousel-inner">
                    {% if listaBanners|length > 0 %}
                        {% for i, b in listaBanners %}
                            <div class="carousel-item {{ i == 0 ? 'active' : '' }}">
                                <img src="{{ b.imgCapa(true, 'mobile').getSource(true) ?: b.imgCapa(true, 'desktop').getSource(true) }}" alt="{{ b.getTitle() }}">
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="carousel-item active">
                            <img src="cdn/goldesporte/banner1.jpeg" alt="GoldEsporte">
                        </div>
                        <div class="carousel-item">
                            <img src="cdn/goldesporte/banner2.jpeg" alt="GoldEsporte">
                        </div>
                        <div class="carousel-item">
                            <img src="cdn/goldesporte/banner3.jpeg" alt="GoldEsporte">
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- 2. Abas de Seleção de Dia (#diasContainer Oficial) -->
            <div id="diasContainer">
                <div class="diasItem" :class="{ 'dias-active': findData == '{{ hoje }}' }" v-on:click="setData('{{ hoje }}')">
                    <div class="diasSigla">HOJE</div>
                    <div class="diasData">{{ hoje|date('d/m') }}</div>
                </div>

                <div class="diasItem" :class="{ 'dias-active': findData == '{{ amanha }}' }" v-on:click="setData('{{ amanha }}')">
                    <div class="diasSigla">AMANHÃ</div>
                    <div class="diasData">{{ amanha|date('d/m') }}</div>
                </div>

                <div v-for="d in datas" :key="d.data"
                     v-if="d.data != '{{ hoje }}' && d.data != '{{ amanha }}'"
                     class="diasItem" :class="{ 'dias-active': findData == d.data }"
                     v-on:click="setData(d.data)">
                    <div class="diasSigla">${d.title.split(' ')[0]}</div>
                    <div class="diasData">${d.data.split('-').reverse().slice(0, 2).join('/')}</div>
                </div>

                <div class="diasItem" :class="{ 'dias-active': (!findData || findData == 'todos') && (!findCampeonato || findCampeonato == '*') }" v-on:click="setCampeonato(); setData('todos');">
                    <div class="diasSigla">TODOS</div>
                    <div class="diasData">JOGOS</div>
                </div>
            </div>

            <!-- 3. Carrossel de Esportes (#esportesContainer Oficial) -->
            <div id="esportesContainer">
                <a href="{{ url('apostar') }}" class="esportesItem active">
                    <i class="fa fa-futbol-o" style="color: #d29d00;"></i>
                    <div class="esportesText">Futebol</div>
                </a>
                <a href="{{ url('apostar') }}" class="esportesItem">
                    <i class="fa fa-signal text-warning"></i>
                    <div class="esportesText">Ao Vivo</div>
                </a>
                <a href="{{ url('cassino') }}" class="esportesItem">
                    <i class="fa fa-gamepad text-danger"></i>
                    <div class="esportesText">Cassino</div>
                </a>
                <a href="{{ url('apostar') }}" class="esportesItem">
                    <i class="fa fa-dribbble text-warning"></i>
                    <div class="esportesText">Basquete</div>
                </a>
                <a href="{{ url('apostar') }}" class="esportesItem">
                    <i class="fa fa-hand-rock-o text-danger"></i>
                    <div class="esportesText">Lutas</div>
                </a>
                <a href="{{ url('apostar') }}" class="esportesItem">
                    <i class="fa fa-circle-o text-success"></i>
                    <div class="esportesText">Vôlei</div>
                </a>
                <a href="{{ url('apostar') }}" class="esportesItem">
                    <i class="fa fa-trophy text-info"></i>
                    <div class="esportesText">Campeonatos</div>
                </a>
            </div>

            <!-- 4. Seção e Lista de Jogos Mobile Oficial -->
            <div class="mobile-games-wrapper">
                
                <!-- Barra de Busca Mobile -->
                <div class="mobile-search-bar">
                    <div class="input-group-search">
                        <i class="fa fa-search"></i>
                        <input type="text" v-model="search" placeholder="Buscar jogos por nome ou horário" />
                    </div>
                </div>

                <!-- Lista de Ligas e Jogos Mobile -->
                <div v-for="pais in paises" v-if="filterPais(pais)">
                    <div v-for="campeonato in getCampeonatos(pais, true)">
                        
                        <!-- Cabeçalho Dourado do Campeonato -->
                        <div class="mobile-champ-header">
                            <img v-if="pais.img" :src="pais.img" class="flag-camp" alt=""/>
                            <span>${pais.title} - ${campeonato.title}</span>
                        </div>

                        <!-- Legenda das Colunas (Casa / Empt. / Fora) -->
                        <div class="mobile-columns-legend">
                            <span class="col-label">Casa</span>
                            <span class="col-label">Empt.</span>
                            <span class="col-label">Fora</span>
                        </div>

                        <!-- Card de Cada Partida Mobile -->
                        <div v-for="jogo in getJogos(campeonato)" :key="'mob-j-' + jogo.id" class="mobile-match-card">
                            
                            <!-- Times e Detalhes da Partida -->
                            <div class="mobile-match-info" v-on:click="maisCotacoes(jogo)">
                                <span class="team-name d-flex align-items-center">
                                    <img v-if="jogo.imgCasa" :src="jogo.imgCasa" class="gold-team-crest mr-1" style="width:16px;height:16px;object-fit:contain;" onerror="this.style.display='none'">
                                    <i v-else class="fa fa-shield text-muted small mr-1"></i>
                                    <span>${jogo.casa}</span>
                                </span>
                                <span class="team-name mt-1 d-flex align-items-center">
                                    <img v-if="jogo.imgFora" :src="jogo.imgFora" class="gold-team-crest mr-1" style="width:16px;height:16px;object-fit:contain;" onerror="this.style.display='none'">
                                    <i v-else class="fa fa-shield text-muted small mr-1"></i>
                                    <span>${jogo.fora}</span>
                                </span>
                                <div class="match-meta">
                                    <span><i class="fa fa-clock-o"></i> ${jogo.data.split('-').reverse().slice(0, 2).join('/')} ${jogo.hora.replace(/:00$/, '')}</span>
                                    <a href="javascript:;" class="btn-more-markets">+${Math.max(0, totalCotacoes(jogo.cotacoes) - getCotacoesPrincipais().length)}</a>
                                    <span class="badge-ca">CA</span>
                                    <span class="badge-pa">PA</span>
                                </div>
                            </div>

                            <!-- Botões Pretos Sólidos de Cotação (1X2) -->
                            <div class="mobile-match-odds">
                                <a v-for="c in getCotacoesPrincipais()" :key="c.campo"
                                   class="mobile-odd-box"
                                   :class="{ 'odd-active': jogo.apostaEm == '90' + c.campo }"
                                   v-on:click="apostar(jogo, '90', c)">
                                    ${(jogo.cotacoes && jogo.cotacoes['90'] && jogo.cotacoes['90'][c.campo]) ? maskReal(jogo.cotacoes['90'][c.campo]) : '-'}
                                </a>
                            </div>

                        </div>

                    </div>
                </div>

                <!-- Estado Vazio Mobile -->
                <div v-if="!paises || getCampeonatos(null, true).length === 0" style="padding: 40px 15px; text-align: center; color: #888;">
                    <i class="fa fa-calendar-times-o fa-2x mb-2 d-block text-secondary"></i>
                    Nenhum jogo disponível para esta data.<br>
                    <a href="javascript:;" v-on:click="setData('todos')" style="color: #d29d00; font-weight: bold; text-decoration: underline; margin-top: 8px; display: inline-block;">
                        Ver todos os jogos disponíveis
                    </a>
                </div>

            </div>

        </div>

    </div>

    <!-- ========================================================
         MODAL DE FINALIZAR BILHETE MOBILE (#finalizarModal Oficial)
         ======================================================== -->
    <div id="finalizarModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                
                <div class="modal-header">
                    <h4 class="modal-title">
                        <i class="fa fa-ticket mr-1"></i> Cupom de Aposta
                    </h4>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>

                <div class="modal-body">
                    <div v-if="aposta.jogos.length === 0" style="text-align: center; color: #888; padding: 60px 10px; font-size: 14px;">
                        <i class="fa fa-hand-pointer-o fa-3x mb-3 d-block text-secondary"></i>
                        Seu cupom está vazio.<br>Selecione cotações para adicionar ao bilhete.
                    </div>

                    <div v-else>
                        <div v-for="(v, i) in aposta.jogos" :key="i" class="p-2 mb-2 bg-white rounded border" style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <div style="font-weight: 700; font-size: 13px; color: #111;">
                                    <img v-if="v.jogo.imgCasa" :src="v.jogo.imgCasa" style="width:14px;height:14px;object-fit:contain;vertical-align:middle;margin-right:2px;" onerror="this.style.display='none'">${v.jogo.casa} x <img v-if="v.jogo.imgFora" :src="v.jogo.imgFora" style="width:14px;height:14px;object-fit:contain;vertical-align:middle;margin-right:2px;" onerror="this.style.display='none'">${v.jogo.fora}
                                </div>
                                <div style="font-size: 12px; color: #666; margin-top: 2px;">
                                    <span>${v.cotacao.title || v.cotacao.sigla}: <b style="color: #000;">${maskReal(v.jogo.cotacoes[v.tempo][v.cotacao.campo])}</b></span>
                                    <span v-if="v.tempo != '90'" class="badge badge-secondary ml-1">${v.tempo == 'pt' ? '1ºT' : '2ºT'}</span>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 ml-2" v-on:click="rmAposta(i)">
                                <i class="fa fa-trash-o fa-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="modal-footer" style="display: block;">
                    <div class="d-flex justify-content-between mb-2 font-weight-bold" style="font-size: 14px;">
                        <span>Cotação Total:</span>
                        <span style="color: #d29d00; font-size: 16px;">${valorCotacao}</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 font-weight-bold" style="font-size: 14px;">
                        <span>Possível Retorno:</span>
                        <span class="text-success" style="font-size: 18px;">R$ ${premio}</span>
                    </div>

                    <div class="form-group mb-2">
                        <label class="small font-weight-bold text-muted mb-1">VALOR DA APOSTA (R$)</label>
                        <input type="number" step="any" v-model="valorAposta" class="form-control font-weight-bold" style="height: 40px; font-size: 16px;" />
                    </div>

                    {% if not user %}
                    <div class="form-group mb-3">
                        <input type="text" v-model="cliente" class="form-control" placeholder="Nome do cliente (opcional)" style="height: 38px; font-size: 13px;" />
                    </div>
                    {% endif %}

                    <div v-if="aposta.jogos.length > 0 && aposta.jogos.length < minJogos" class="alert alert-warning py-1 px-2 mb-2 text-center small font-weight-bold">
                        Mínimo de jogos: ${minJogos}
                    </div>

                    <div class="d-flex" style="gap: 8px;">
                        <button type="button" class="btn btn-secondary font-weight-bold" style="width: 35%; height: 42px;" v-on:click="limpaAposta">
                            <i class="fa fa-undo mr-1"></i> Limpar
                        </button>
                        <button type="button" class="btn btn-warning font-weight-bold text-dark" style="width: 65%; height: 42px; background: #d29d00; border: none;" :disabled="!apostaValida" v-on:click="finalizarAposta(); $('#finalizarModal').modal('hide');">
                            <i class="fa fa-check mr-1"></i> {{ user ? 'Confirmar' : 'Finalizar' }}
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- MODAL DE MAIS MERCADOS E COTAÇÕES -->
    <div class="modal fade" id="modal-cotacoes" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" style="border-radius: 4px; border: 1px solid #000; overflow: hidden;">
                <div class="modal-header bg-dark text-white p-3">
                    <h5 class="modal-title font-weight-bold" style="color: #d29d00;" v-if="mJogo.jogo">
                        <img v-if="mJogo.jogo.imgCasa" :src="mJogo.jogo.imgCasa" class="gold-team-crest mr-1" style="width:20px;height:20px;object-fit:contain;vertical-align:middle;" onerror="this.style.display='none'">${mJogo.jogo.casa} x <img v-if="mJogo.jogo.imgFora" :src="mJogo.jogo.imgFora" class="gold-team-crest mr-1" style="width:20px;height:20px;object-fit:contain;vertical-align:middle;" onerror="this.style.display='none'">${mJogo.jogo.fora}
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>

                <!-- Abas de Tempo (90 min, 1º Tempo, 2º Tempo) -->
                <div class="bg-dark p-2 text-center" style="border-bottom: 1px solid #333;">
                    <div class="btn-group btn-group-sm">
                        <button type="button"
                                class="btn"
                                :class="key == mJogo.tempo ? 'btn-warning font-weight-bold' : 'btn-outline-light'"
                                v-for="(tempo, key) in tempos"
                                v-on:click="mJogo.tempo = key">
                            ${tempo}
                        </button>
                    </div>
                </div>

                <div class="modal-body p-3" v-if="mJogo.jogo" style="max-height: 520px; overflow-y: auto;">
                    <div v-for="(grupo, id) in grupos" :key="id" class="mb-3">
                        <div class="font-weight-bold text-uppercase px-3 py-2"
                             style="background: #000000; color: #ffffff; border-radius: 3px 3px 0 0; font-size: 12px;">
                            ${grupo}
                        </div>
                        <div class="p-2 border" style="background: #fafafa; border-radius: 0 0 3px 3px;">
                            <div class="row no-gutters">
                                <div v-for="c in cotacoes"
                                     :key="c.campo"
                                     v-if="c.grupo == id && mJogo.jogo.cotacoes[mJogo.tempo] && mJogo.jogo.cotacoes[mJogo.tempo][c.campo] > 1"
                                     class="col-md-4 col-sm-6 p-1">
                                    <div class="p-2 border rounded text-center"
                                         style="cursor: pointer; transition: 0.15s; background: #fff;"
                                         :class="{ 'border-warning bg-warning text-dark font-weight-bold': mJogo.jogo.apostaEm == mJogo.tempo + c.campo }"
                                         v-on:click="apostar(mJogo.jogo, mJogo.tempo, c)">
                                        <div class="small text-muted" style="font-size: 11px;">${c.title}</div>
                                        <div class="font-weight-bold" style="font-size: 14px;">
                                            ${mJogo.jogo.cotacoes[mJogo.tempo][c.campo]|maskReal}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block script %}
    {{ block('script', 'website/page/apostar.twig') }}
    <script>
        if (window.app) {
            window.app.filterJogo = function(jogo) {
                if (!this.jogoAberto(jogo)) return false;
                if (this.findData && this.findData !== 'todos' && this.findData !== '*' && jogo.data != this.findData) {
                    return false;
                }
                if (this.search) {
                    var exp = new RegExp(this.search, 'i');
                    if (jogo.casa.search(exp) === -1 && jogo.fora.search(exp) === -1) {
                        return false;
                    }
                }
                return true;
            };

            window.app.setData = function(data) {
                $('html').removeClass('show-menu show-filtros');
                this.findCampeonato = '*';
                this.findPais = '*';
                this.findData = data ? data : 'todos';
            };

            window.app.$watch('datas', function(val) {
                if (val && val.length > 0) {
                    var hasHoje = val.some(function(d) { return d.data === '{{ hoje }}'; });
                    if (!hasHoje && this.findData === '{{ hoje }}') {
                        this.findData = val[0].data;
                    }
                }
            });
        }
    </script>
{% endblock %}
