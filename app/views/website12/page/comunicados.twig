{% extends layout %}

{% block main %}

    <div class="gold-card m-3">
        <div class="gold-card-header">
            <i class="fa fa-bullhorn"></i> Comunicados e Avisos
        </div>

        {% if comunicados %}
            {% for v in comunicados %}
                <div class="card mb-3 border">
                    <div class="card-header d-flex justify-content-between align-items-center" style="background: #000; color: #fff;">
                        <h6 class="m-0 font-weight-bold" style="color: #d29d00;">{{ v.getTitle() }}</h6>
                        <small class="text-muted">{{ v.getData(true) }}</small>
                    </div>
                    <div class="card-body p-3">
                        {{ v.getMensagem()|raw }}
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="alert alert-info">
                <i class="fa fa-info-circle mr-1"></i> Nenhum comunicado no momento.
            </div>
        {% endif %}
    </div>

{% endblock %}

