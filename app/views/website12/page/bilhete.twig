{% extends layout %}

{% set codigoBusca = _get.codigo|default(_post.codigo|default('')) %}

{% block main %}

    <div class="gold-card m-3">
        <div class="gold-card-header">
            <i class="fa fa-ticket"></i> Consultar Bilhete
        </div>

        <p class="text-muted small">
            Digite o código do bilhete para verificar o status, cotações e situação da aposta.
        </p>

        <form class="admpage-form mb-4">
            <div class="row align-items-end">
                <div class="col-md-8 col-sm-12">
                    <label class="font-weight-bold small">CÓDIGO DO BILHETE</label>
                    <div class="input-group">
                        <input type="text"
                               maxlength="16"
                               name="codigo"
                               value="{{ codigoBusca }}"
                               class="form-control"
                               placeholder="Ex: ABC1234"
                               required
                               style="height: 44px; font-size: 16px; font-weight: bold; text-transform: uppercase;" />
                        <div class="input-group-append">
                            <button type="submit" class="botao" style="height: 44px; padding: 0 25px;">
                                <i class="fa fa-search"></i> Consultar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="admpage-container"></div>
    </div>

{% endblock %}

{% block bilhete %}
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover mb-3" style="font-size: 13px;">
            <tbody>
            <tr style="background: #000; color: #fff;">
                <th style="width: 20%;">Código:</th>
                <td colspan="3" class="font-weight-bold" style="color: #d29d00; font-size: 16px;">
                    {{ aposta.getCodigoBilhete() }}
                </td>
            </tr>
            <tr>
                <th>Cliente:</th>
                <td>{{ aposta.getApostadorNome()|default('-') }}</td>
                <th>Usuário:</th>
                <td>{{ user.getNome()|default('-') }}</td>
            </tr>
            <tr>
                <th>Valor da Aposta:</th>
                <td class="font-weight-bold">R$ {{ aposta.getValor(true) }}</td>
                <th>Número de Jogos:</th>
                <td>{{ aposta.getJogos() }}</td>
            </tr>
            <tr>
                <th>Data da Aposta:</th>
                <td>{{ aposta.getData(true) }}</td>
                <th>Retorno Possível:</th>
                <td class="font-weight-bold" style="color: #28a745; font-size: 15px;">
                    R$ {{ aposta.getRetornoValido(true) }}
                </td>
            </tr>
            <tr>
                <th>Qtd. Acertos:</th>
                <td>{{ aposta.get('acertos')|default(0) }}</td>
                <th>Situação:</th>
                <td>
                    {% if aposta.getStatus() == 1 %}
                        <span class="badge {{ aposta.getVerificado() ? (aposta.getGanhou() ? 'badge-success' : 'badge-danger') : 'badge-info' }}" style="font-size: 13px; padding: 5px 10px;">
                            {{ aposta.getVerificado() ? (aposta.getGanhou() ? 'Ganhou' : 'Perdeu') : 'Aguardando conclusão dos jogos' }}
                        </span>
                    {% else %}
                        <span class="badge badge-warning" style="font-size: 13px; padding: 5px 10px;">
                            {{ {0: 'Cancelada', 2: 'Aguardando pagamento', 3: 'Não recebeu pagamento', 99: 'Excluída'}[aposta.getStatus()]|default('Pendente') }}
                        </span>
                    {% endif %}
                </td>
            </tr>
            </tbody>
        </table>
    </div>

    {% if aposta.getStatus() == 2 %}
        <div class="text-right pt-2 pb-3">
            <form onsubmit="javascript:return false;" class="form-bilhete d-inline-block">
                <input type="hidden" name="token" value="{{ aposta.getToken() }}">
                <button class="botao" type="submit">
                    <i class="fa fa-check"></i> Validar Aposta
                </button>
            </form>
        </div>
        <script>
            $('.form-bilhete')
                .adminPage({
                    autoSearch: false,
                    controller: 'bilhete',
                    insertAction: 'validar',
                    alertSuccess: true,
                })
                .on("success", function (event, e) {
                    if (e.result == 1)
                        page.reloadSearch();
                });
        </script>
    {% endif %}

{% endblock %}

{% block script %}
    <script>
        var page = $
            .adminPage({
                formSearch: '.admpage-form',
                container: '.admpage-container',
            });

        {% if codigoBusca %}
        $(function () {
            $('.admpage-form').submit();
        });
        {% endif %}
    </script>
{% endblock %}

