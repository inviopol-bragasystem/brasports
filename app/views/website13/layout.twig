<!doctype html>
<html lang="pt-BR" style="--mobile-nav-inset: calc(76px + env(safe-area-inset-bottom)); --theme-bg: #1d2f3d; --theme-bg-opacity: #1d2f3d00; --theme-primary: #1b75e2; --theme-primary-opacity: #1b75e230; --theme-primary-opacity-2: #1b75e260; --theme-primary-hover: #3b84e4; --theme-card-1: #263847; --theme-card-2: #243947; --theme-card-3: #1b2f41; --theme-card-3-opacity: #1b2f4190; --theme-card-text: #eaf2ff; --theme-on-primary: #ffffff; --theme-text: #FFFFFF; --theme-section-icon: #f2ba09; --theme-section-icon-glow: #f2ba0960; --theme-paid-value: #f2ba09;">
<head>
    {{ seo_header() }}

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, maximum-scale=1, user-scalable=no">
    <meta name="theme-color" content="#1d2f3d"/>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
    <link rel="stylesheet" href="css/bootstrap4.css"/>
    <link rel="stylesheet" href="css/loading.css"/>
    <link rel="stylesheet" href="css/sweetalert2.min.css"/>
    <link rel="stylesheet" href="css/99play/99play.css?v=2.0.0"/>

    <style>
        [v-cloak] { display: none !important; }
        body {
            background-color: #1d2f3d !important;
            color: #FFFFFF !important;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }
        .bg-theme-bg { background-color: var(--theme-bg) !important; }
        .bg-theme-card-1 { background-color: var(--theme-card-1) !important; }
        .bg-theme-card-2 { background-color: var(--theme-card-2) !important; }
        .bg-theme-card-3 { background-color: var(--theme-card-3) !important; }
        .text-theme-primary { color: var(--theme-primary) !important; }
        .text-theme-card-text { color: var(--theme-card-text) !important; }
        .bg-theme-primary { background-color: var(--theme-primary) !important; }

        /* Sidebar (Desktop 260px) 1:1 99play.io */
        aside#main-sidebar {
            width: 260px !important;
            min-width: 260px !important;
            max-width: 260px !important;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }

        /* Sidebar Collapse (Sanfona Desktop) */
        body.sidebar-collapsed aside#main-sidebar {
            width: 0 !important;
            min-width: 0 !important;
            max-width: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
            overflow: hidden !important;
        }
        body.sidebar-collapsed .sidebar-toggle-icon {
            transform: rotate(180deg);
        }

        /* 1:1 99Play: Responsividade da Sidebar Mobile vs Desktop */
        @media (max-width: 1199px) {
            aside#main-sidebar {
                display: none !important;
            }
            .sidebar-toggle-btn {
                display: none !important;
            }
            body.show-mobile-sidebar {
                overflow: hidden !important;
            }
            body.show-mobile-sidebar aside#main-sidebar {
                display: block !important;
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                bottom: 0 !important;
                width: 290px !important;
                max-width: 86vw !important;
                max-height: 100vh !important;
                z-index: 1060 !important;
                background: #15222e !important;
                padding: 16px !important;
                overflow-y: auto !important;
                box-shadow: 12px 0 35px rgba(0,0,0,0.85) !important;
            }
            body.show-mobile-sidebar::after {
                content: '';
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.72);
                backdrop-filter: blur(2px);
                z-index: 1055;
            }
            .mobile-sidebar-close-btn {
                display: flex !important;
            }
        }
        @media (min-width: 1200px) {
            aside#main-sidebar {
                display: block !important;
            }
            .sidebar-toggle-btn {
                display: inline-flex !important;
            }
            .mobile-sidebar-close-btn {
                display: none !important;
            }
        }

        /* Painéis e Botões da Sidebar 1:1 99play */
        aside#main-sidebar .panel {
            background-color: var(--theme-card-2) !important; /* #243947 */
            border: 1px solid rgba(255, 255, 255, 0.04) !important;
            border-radius: 16px !important;
            box-shadow: none !important;
        }
        aside#main-sidebar .product-switch {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            gap: 6px !important;
            padding: 6px !important;
        }
        aside#main-sidebar .product-tab {
            height: 44px !important;
            border-radius: 12px !important;
            font-size: 14px !important;
            font-weight: 600 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 8px !important;
            text-decoration: none !important;
            transition: all 0.2s ease !important;
        }
        aside#main-sidebar .product-tab.active {
            background-color: var(--theme-primary) !important; /* #1b75e2 */
            color: #ffffff !important;
            box-shadow: 0 6px 18px -6px var(--theme-primary) !important;
        }
        aside#main-sidebar .product-tab:not(.active) {
            background-color: transparent !important;
            color: rgba(255, 255, 255, 0.6) !important;
            box-shadow: none !important;
        }
        aside#main-sidebar .product-tab:not(.active):hover {
            background-color: rgba(255, 255, 255, 0.04) !important;
            color: #ffffff !important;
        }

        /* Itens das Listas da Sidebar */
        aside#main-sidebar .panel ul li a {
            height: 44px !important;
            border-radius: 12px !important;
            font-size: 14px !important;
            font-weight: 500 !important;
            color: rgba(255, 255, 255, 0.75) !important;
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
            padding: 0 12px !important;
            transition: all 0.15s ease !important;
            text-decoration: none !important;
        }
        aside#main-sidebar .panel ul li a:hover {
            background-color: rgba(255, 255, 255, 0.04) !important;
            color: #ffffff !important;
        }

        /* Grade de Jogos Compacta 1:1 99Play (6 a 8 colunas desktop, 3 a 4 colunas mobile) */
        .play-games-grid {
            display: grid !important;
            gap: 10px !important;
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        }
        @media (min-width: 560px) {
            .play-games-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            }
        }
        @media (min-width: 820px) {
            .play-games-grid {
                grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
            }
        }
        @media (min-width: 1100px) {
            .play-games-grid {
                grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
            }
        }
        @media (min-width: 1350px) {
            .play-games-grid {
                grid-template-columns: repeat(7, minmax(0, 1fr)) !important;
            }
        }
        @media (min-width: 1650px) {
            .play-games-grid {
                grid-template-columns: repeat(8, minmax(0, 1fr)) !important;
            }
        }
        @media (max-width: 768px) {
            .play-games-grid {
                gap: 8px !important;
            }
        }
    </style>

    {% block head %}{% endblock %}

    {{ dados.getHtmlHead()|raw }}
    {% include 'website/inc/personalizacao-css.twig' %}
</head>
<body class="font-sans">
<div id="website">

{% set userLogged = user() %}

{# Logo do tema #}
{% set logoUrl = 'cdn/99play/logo.webp' %}
{% if dados.imgCapa(true, 'logo').getSource() %}
    {% set logoUrl = dados.imgCapa(true, 'logo').getSource(true) %}
{% endif %}

<!-- ========================================================
     TOP NAVBAR 1:1 99PLAY (72px Desktop / 60px Mobile)
     ======================================================== -->
<nav class="fixed top-0 left-0 right-0 z-50 h-[72px] max-[990px]:h-[60px] bg-theme-bg/90 backdrop-blur-md border-b border-white/[0.05]" v-pre>
    <div class="max-w-[2000px] mx-auto h-full px-4 max-[990px]:px-3 flex items-center gap-3 max-[990px]:gap-2">
        <!-- Logo -->
        <a aria-label="Início" class="flex items-center shrink-0 w-[250px] max-[1200px]:w-auto" href="{{ url() }}">
            <img src="{{ logoUrl }}" alt="{{ dados.getBanca()|default('99Play') }}" data-site-logo="" class="h-[48px] max-[990px]:h-[42px] w-auto max-w-[200px] max-[990px]:max-w-[140px] max-[400px]:max-w-[120px] object-contain object-left">
        </a>

        <!-- Botão Sanfona / Recolher Menu Lateral (Apenas Desktop >= 1200px) -->
        <button type="button" aria-label="Recolher menu" title="Recolher menu" class="icon-btn shrink-0 sidebar-toggle-btn" onclick="toggleSidebar();">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 sidebar-toggle-icon transition-transform duration-200"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><path d="M9 3v18"></path><path d="m16 15-3-3 3-3"></path></svg>
        </button>

        <!-- Botão Abrir Menu Lateral Mobile (< 1200px) -->
        <button type="button" aria-label="Abrir menu" title="Menu" class="icon-btn shrink-0 min-[1200px]:hidden text-white hover:text-white/80" onclick="$('body').toggleClass('show-mobile-sidebar');">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>

        <!-- Barra de Busca Desktop -->
        <form action="{{ url('cassino') }}" method="get" class="m-0 p-0 max-[990px]:hidden">
            <div class="flex items-center gap-3 h-10 w-[300px] max-[1300px]:w-[220px] px-4 rounded-xl bg-theme-card-1 text-sm text-white/40 hover:text-white/60 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                <input type="text" name="search" value="{{ busca|default('') }}" placeholder="Buscar jogos" class="bg-transparent border-0 outline-none text-white text-sm w-full placeholder-white/40" autocomplete="off"/>
            </div>
        </form>

        <!-- Links Rápidos Desktop -->
        <div class="flex items-center gap-5 ml-2 max-[1440px]:hidden">
            {% if dados.getExibirCassino() %}
                <a class="text-sm font-medium text-white/60 hover:text-white whitespace-nowrap" href="{{ url('cassino', null, null, {'category': 'Ao Vivo'}) }}">Cassino ao vivo</a>
                <a class="text-sm font-medium text-white/60 hover:text-white whitespace-nowrap" href="{{ url('cassino', null, null, {'category': 'Slots'}) }}">Slots</a>
            {% endif %}
            <a class="text-sm font-medium text-white/60 hover:text-white whitespace-nowrap" href="{{ url('apostar') }}">Esportes</a>
        </div>

        <div class="flex-1"></div>

        <!-- Botão Busca Mobile -->
        <button type="button" aria-label="Buscar jogos" onclick="$('#mobileSearchModal').toggle();" class="shrink-0 min-[991px]:hidden flex items-center justify-center w-9 h-9 rounded-full bg-white/[0.12] text-white transition-[filter,transform] hover:brightness-125 active:scale-[0.95]">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        </button>

        <!-- Ações / Login / Saldo -->
        <div class="flex items-center gap-2 shrink-0">
            {% if not userLogged %}
                {% if dados.getExibirLogin() %}
                    <button type="button" class="btn-ghost max-[990px]:px-3.5" onclick="$('#modal-login').modal('show');">Entrar</button>
                {% endif %}
                {% if dados.getExibirRegistro() %}
                    <a href="{{ dados.getLinkCadastro()|default(url('cadastrar')) }}" class="btn-primary relative max-[990px]:px-3.5">
                        Cadastre-se
                        <span class="absolute -top-2 -right-1.5 flex items-center gap-1 rounded-full bg-amber-300 px-1.5 py-[3px] text-[8px]/[1] font-bold uppercase text-zinc-800 shadow">
                            <img src="cdn/99play/pix-icon.svg" alt="" class="w-[8px]">pix
                        </span>
                    </a>
                {% endif %}
            {% else %}
                <!-- Saldo e Acesso Rápido PIX -->
                <div class="flex items-center gap-2 bg-theme-card-1 px-3 py-1.5 rounded-xl border border-white/[0.08]">
                    <div class="text-right">
                        <span class="text-[10px] text-white/50 block leading-none">Saldo</span>
                        <strong class="text-xs text-white">R$ {{ userLogged.getCredito(true) }}</strong>
                    </div>
                    <a href="{{ url('financeiro/deposito') }}" class="btn-primary text-xs py-1 px-2.5 rounded-lg flex items-center gap-1 font-bold">
                        <img src="cdn/99play/pix-icon.svg" alt="" class="w-3 h-3"> + Depósito
                    </a>
                </div>

                <!-- Menu Dropdown do Usuário -->
                <div class="dropdown d-inline-block">
                    <button class="btn-ghost p-1.5 rounded-full" type="button" id="userMenuBtn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-user-circle text-xl text-theme-primary"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right shadow-lg border-0" aria-labelledby="userMenuBtn" style="background:var(--theme-card-2);border:1px solid rgba(255,255,255,0.08);border-radius:14px;min-width:220px;padding:8px 0;z-index:1050;">
                        <div class="px-3 py-2 border-bottom" style="border-color:rgba(255,255,255,0.08)!important;">
                            <div class="font-weight-bold text-white text-truncate">{{ userLogged.getNome() }}</div>
                            <small class="font-weight-bold text-emerald-400">Disponível: R$ {{ userLogged.getCredito(true) }}</small>
                        </div>
                        <a class="dropdown-item py-2 text-white" href="{{ url('financeiro/deposito') }}"><i class="fa fa-plus-circle mr-2 text-success"></i> Depositar (PIX)</a>
                        <a class="dropdown-item py-2 text-white" href="{{ url('financeiro/saque') }}"><i class="fa fa-arrow-up mr-2 text-danger"></i> Solicitar Saque</a>
                        <a class="dropdown-item py-2 text-white" href="{{ url('financeiro/extrato') }}"><i class="fa fa-history mr-2 text-info"></i> Extrato Financeiro</a>
                        <a class="dropdown-item py-2 text-white" href="{{ url('apostas') }}"><i class="fa fa-ticket mr-2 text-warning"></i> Minhas Apostas</a>
                        <a class="dropdown-item py-2 text-white" href="{{ url('perfil') }}"><i class="fa fa-user mr-2 text-primary"></i> Meu Perfil</a>
                        <div class="dropdown-divider my-1" style="border-color:rgba(255,255,255,0.08);"></div>
                        <a class="dropdown-item py-2 text-danger font-weight-bold" href="{{ url('logout') }}"><i class="fa fa-sign-out mr-2"></i> Sair</a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</nav>

<!-- Campo de Busca Mobile Expansível -->
<div id="mobileSearchModal" class="fixed top-[60px] left-0 right-0 z-40 bg-theme-bg/95 backdrop-blur-md p-3 border-b border-white/[0.08]" style="display:none;">
    <form action="{{ url('cassino') }}" method="get" class="m-0 flex items-center gap-2">
        <input type="text" name="search" value="{{ busca|default('') }}" placeholder="Buscar jogos, slots ou eventos..." class="flex-1 h-10 px-3 rounded-xl bg-theme-card-1 text-white text-sm outline-none border border-white/[0.08]" autocomplete="off"/>
        <button type="submit" class="btn-primary h-10 px-4 rounded-xl text-xs font-bold">Buscar</button>
    </form>
</div>

<!-- ========================================================
     ESTRUTURA PRINCIPAL (SIDEBAR 260px + MAIN CONTENT)
     ======================================================== -->
<section class="max-w-[2000px] mx-auto w-full pt-[92px] max-[990px]:pt-[72px] px-4 max-[990px]:px-3 flex items-start gap-6">

    <!-- ASIDE 1:1 99PLAY SIDEBAR (DESKTOP 260px) -->
    <aside aria-label="Menu lateral" id="main-sidebar" class="w-[260px] shrink-0 sticky top-[92px] self-start max-h-[calc(100vh-108px)] overflow-y-auto overscroll-contain [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden" v-pre>
        <div class="flex flex-col gap-3 pb-4">

            <!-- Header Mobile Drawer (< 1200px) -->
            <div class="mobile-sidebar-close-btn items-center justify-between pb-3 mb-1 border-b border-white/[0.08]">
                <img src="{{ logoUrl }}" alt="{{ dados.getBanca()|default('99Play') }}" class="h-8 w-auto">
                <button type="button" class="w-8 h-8 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-white/20 transition-colors" onclick="$('body').removeClass('show-mobile-sidebar');">
                    <i class="fa fa-times text-base"></i>
                </button>
            </div>

            <!-- Botões Laterais Rápidos: DEPÓSITO e SAQUE -->
            <div class="grid grid-cols-2 gap-2">
                <a href="{{ userLogged ? url('financeiro/deposito') : 'javascript:;' }}" 
                   {% if not userLogged %}onclick="$('#modal-login').modal('show');"{% endif %} 
                   class="flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl font-extrabold text-xs uppercase tracking-wider text-white shadow-lg transition-transform active:scale-[0.98] text-center" 
                   style="background: linear-gradient(135deg, #00e054 0%, #00b040 100%);">
                    <img src="cdn/99play/pix-icon.svg" alt="" class="w-3.5 h-3.5">
                    <span>Depósito</span>
                </a>
                <a href="{{ userLogged ? url('financeiro/saque') : 'javascript:;' }}" 
                   {% if not userLogged %}onclick="$('#modal-login').modal('show');"{% endif %} 
                   class="flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl font-extrabold text-xs uppercase tracking-wider text-white shadow-lg transition-transform active:scale-[0.98] text-center" 
                   style="background: linear-gradient(135deg, #1b75e2 0%, #0d5bbd 100%);">
                    <i class="fa fa-money text-xs"></i>
                    <span>Saque</span>
                </a>
            </div>

            <!-- Switch Produto [Cassino] [Esportes] (1:1 99play) -->
            {% set isEsportes = (pageAposta is defined and pageAposta) or (activeTab is defined and activeTab == 'esportes') %}
            <div class="panel product-switch" role="tablist" aria-label="Produto">
                {% if dados.getExibirCassino() %}
                    {% if not isEsportes %}
                        <a role="tab" aria-selected="true" title="Cassino" class="product-tab active" href="{{ url('cassino') }}">
                            <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 640 512" class="text-lg shrink-0" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M274.9 34.3c-28.1-28.1-73.7-28.1-101.8 0L34.3 173.1c-28.1 28.1-28.1 73.7 0 101.8L173.1 413.7c28.1 28.1 73.7 28.1 101.8 0L413.7 274.9c28.1-28.1 28.1-73.7 0-101.8L274.9 34.3zM200 224a24 24 0 1 1 48 0 24 24 0 1 1 -48 0zM96 200a24 24 0 1 1 0 48 24 24 0 1 1 0-48zM224 376a24 24 0 1 1 0-48 24 24 0 1 1 0 48zM352 200a24 24 0 1 1 0 48 24 24 0 1 1 0-48zM224 120a24 24 0 1 1 0-48 24 24 0 1 1 0 48zm96 328c0 35.3 28.7 64 64 64H576c35.3 0 64-28.7 64-64V256c0-35.3-28.7-64-64-64H461.7c11.6 36 3.1 77-25.4 105.5L320 413.8V448zM480 328a24 24 0 1 1 0 48 24 24 0 1 1 0-48z"></path></svg>
                            Cassino
                        </a>
                    {% else %}
                        <a role="tab" aria-selected="false" title="Cassino" class="product-tab" href="{{ url('cassino') }}">
                            <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 640 512" class="text-lg shrink-0" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M274.9 34.3c-28.1-28.1-73.7-28.1-101.8 0L34.3 173.1c-28.1 28.1-28.1 73.7 0 101.8L173.1 413.7c28.1 28.1 73.7 28.1 101.8 0L413.7 274.9c28.1-28.1 28.1-73.7 0-101.8L274.9 34.3zM200 224a24 24 0 1 1 48 0 24 24 0 1 1 -48 0zM96 200a24 24 0 1 1 0 48 24 24 0 1 1 0-48zM224 376a24 24 0 1 1 0-48 24 24 0 1 1 0 48zM352 200a24 24 0 1 1 0 48 24 24 0 1 1 0-48zM224 120a24 24 0 1 1 0-48 24 24 0 1 1 0 48zm96 328c0 35.3 28.7 64 64 64H576c35.3 0 64-28.7 64-64V256c0-35.3-28.7-64-64-64H461.7c11.6 36 3.1 77-25.4 105.5L320 413.8V448zM480 328a24 24 0 1 1 0 48 24 24 0 1 1 0-48z"></path></svg>
                            Cassino
                        </a>
                    {% endif %}
                {% endif %}

                {% if isEsportes %}
                    <a role="tab" aria-selected="true" title="Esportes" class="product-tab active" href="{{ url('apostar') }}">
