<script>
    // Controle de Recolhimento da Barra Lateral Desktop (1:1 99play)
    function toggleSidebar() {
        $('body').toggleClass('sidebar-collapsed');
    }

    // Submissão AJAX do Formulário de Login (Evita redirecionamento nativo e tela preta JSON)
    function handleModalLogin(e, form) {
        if (e && e.preventDefault) e.preventDefault();
        var $form = $(form);
        var $btn = $('#btn-submit-login');
        var $errBox = $('#login-error-box');

        $errBox.addClass('hidden').text('');
        $btn.prop('disabled', true).addClass('opacity-75').html('<i class="fa fa-spinner fa-spin mr-1"></i> Entrando...');

        $.ajax({
            url: '{{ url("entrar/login/insert") }}',
            type: 'POST',
            data: $form.serialize(),
            dataType: 'json',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function(res) {
                $btn.prop('disabled', false).removeClass('opacity-75').text('Entrar');
                if (res && res.result == 1) {
                    window.location.href = res.url || '{{ url() }}';
                } else {
                    var msg = (res && res.message) ? res.message : 'Login inválido.';
                    $errBox.removeClass('hidden').text(msg);
                    if (typeof swal === 'function') {
                        swal('Atenção', msg, 'error');
                    }
                }
            },
            error: function(xhr) {
                $btn.prop('disabled', false).removeClass('opacity-75').text('Entrar');
                var msg = 'Erro ao processar login. Tente novamente.';
                try {
                    var json = JSON.parse(xhr.responseText);
                    if (json && json.message) msg = json.message;
                } catch(err) {}
                $errBox.removeClass('hidden').text(msg);
                if (typeof swal === 'function') {
                    swal('Erro', msg, 'error');
                }
            }
        });

        return false;
    }

    // Fechar gaveta da barra lateral mobile ao clicar fora
    $(document).on('click', function(e) {
        if ($('body').hasClass('show-mobile-sidebar')) {
            if (!$(e.target).closest('#main-sidebar, [aria-label="Abrir menu"]').length) {
                $('body').removeClass('show-mobile-sidebar');
            }
        }
    });
</script>

{% block script %}{% endblock %}

{{ dados.getHtmlFooter()|raw }}

</body>
</html>
