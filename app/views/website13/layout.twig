<!-- ========================================================
     MODAL DE LOGIN (99PLAY DESIGN SYSTEM)
     ======================================================== -->
<form id="modal-login" class="modal fade play-modal" method="post" action="javascript:;" onsubmit="return handleModalLogin(event, this);" v-pre>
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content rounded-3xl overflow-hidden border border-white/[0.08]" style="background:var(--theme-bg);">
            <div class="p-6 border-b border-white/[0.05] flex items-center justify-between">
                <div>
                    <img src="{{ logoUrl }}" alt="" class="h-7 w-auto mb-2">
                    <h2 class="text-xl font-bold text-white m-0">Entrar</h2>
                    <p class="text-sm text-theme-card-text m-0 mt-0.5">Bem-vindo de volta.</p>
                </div>
                <button type="button" class="icon-btn shrink-0 text-white/60 hover:text-white" data-dismiss="modal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                </button>
            </div>
            <div class="p-6">
                <!-- Alerta de Erro de Login -->
                <div id="login-error-box" class="hidden mb-4 p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs text-center font-medium"></div>

                <div class="mb-4">
                    <div class="relative h-14 rounded-xl border bg-theme-card-2 border-white/[0.08] hover:border-white/15">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 flex items-center pointer-events-none text-theme-card-text"><i class="fa fa-envelope-o text-lg"></i></span>
                        <input type="text" name="username" placeholder="E-mail ou Usuário" required class="w-full h-full bg-transparent outline-none text-white text-[15px] pl-12 pr-4"/>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="relative h-14 rounded-xl border bg-theme-card-2 border-white/[0.08] hover:border-white/15">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 flex items-center pointer-events-none text-theme-card-text"><i class="fa fa-lock text-lg"></i></span>
                        <input type="password" name="password" placeholder="Senha" required class="w-full h-full bg-transparent outline-none text-white text-[15px] pl-12 pr-4"/>
                    </div>
                </div>
                <button id="btn-submit-login" type="submit" class="btn-success w-full h-12 text-base font-bold rounded-xl flex items-center justify-center gap-2">
                    Entrar
                </button>
                {% if dados.getExibirRegistro() %}
                    <div class="text-center mt-4 text-sm text-theme-card-text">
                        Novo aqui? <a href="{{ dados.getLinkCadastro()|default(url('cadastrar')) }}" class="font-semibold text-theme-primary hover:underline">Criar conta</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</form>

