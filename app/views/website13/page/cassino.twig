{% extends 'website13/layout.twig' %}

{% block title %}99Play - O melhor cassino do Brasil{% endblock %}

{% block main %}

    <!-- ========================================================
         HERO CAROUSEL 1:1 99PLAY
         ======================================================== -->
    <div class="relative rounded-2xl overflow-hidden mb-6" style="background:#111a2f;">
        <div id="playHeroCarousel" class="carousel slide" data-ride="carousel" data-interval="4000">
            <!-- Indicadores -->
            <ol class="carousel-indicators mb-2">
                <li data-target="#playHeroCarousel" data-slide-to="0" class="active"></li>
                <li data-target="#playHeroCarousel" data-slide-to="1"></li>
                <li data-target="#playHeroCarousel" data-slide-to="2"></li>
                <li data-target="#playHeroCarousel" data-slide-to="3"></li>
                <li data-target="#playHeroCarousel" data-slide-to="4"></li>
                <li data-target="#playHeroCarousel" data-slide-to="5"></li>
            </ol>

            <!-- Slides com Banners Oficiais 99Play -->
            <div class="carousel-inner rounded-2xl">
                <div class="carousel-item active" style="aspect-ratio: 23 / 10; max-height: 440px;">
                    <a href="javascript:;" onclick="$('#modal-missao-99').removeClass('hidden');" class="block w-full h-full">
                        <img src="cdn/99play/banner-telegram.webp" class="d-block w-full h-full object-cover" alt="Convite Telegram">
                    </a>
                </div>
                <div class="carousel-item" style="aspect-ratio: 23 / 10; max-height: 440px;">
                    <a href="{{ url('cassino/jogar/aviator') }}" class="block w-full h-full">
                        <img src="cdn/99play/banner-aviator.webp" class="d-block w-full h-full object-cover" alt="Cash Aviator">
                    </a>
                </div>
                <div class="carousel-item" style="aspect-ratio: 23 / 10; max-height: 440px;">
                    <a href="{{ url('apostar') }}" class="block w-full h-full">
                        <img src="cdn/99play/banner-superodds.webp" class="d-block w-full h-full object-cover" alt="SuperOdds">
                    </a>
                </div>
                <div class="carousel-item" style="aspect-ratio: 23 / 10; max-height: 440px;">
                    <a href="{{ url('cassino', null, null, {'category': 'Ao Vivo'}) }}" class="block w-full h-full">
                        <img src="cdn/99play/banner-aovivo.webp" class="d-block w-full h-full object-cover" alt="Cassino ao Vivo">
                    </a>
                </div>
                <div class="carousel-item" style="aspect-ratio: 23 / 10; max-height: 440px;">
                    <a href="javascript:;" onclick="$('#modal-missao-99').removeClass('hidden');" class="block w-full h-full">
                        <img src="cdn/99play/banner-torneio.webp" class="d-block w-full h-full object-cover" alt="Torneio">
                    </a>
                </div>
                <div class="carousel-item" style="aspect-ratio: 23 / 10; max-height: 440px;">
                    <a href="javascript:;" onclick="$('#modal-missao-99').removeClass('hidden');" class="block w-full h-full">
                        <img src="cdn/99play/banner-vip.webp" class="d-block w-full h-full object-cover" alt="VIP Club">
                    </a>
                </div>
            </div>

            <!-- Controles Desktop -->
            <a class="carousel-control-prev max-[990px]:hidden" href="#playHeroCarousel" role="button" data-slide="prev" style="width:50px;">
                <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-black/40 text-white backdrop-blur hover:bg-black/70 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
                </span>
            </a>
            <a class="carousel-control-next max-[990px]:hidden" href="#playHeroCarousel" role="button" data-slide="next" style="width:50px;">
                <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-black/40 text-white backdrop-blur hover:bg-black/70 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
                </span>
            </a>
        </div>
    </div>

    <!-- ========================================================
         CATEGORIAS CIRCULARES 1:1 99PLAY (STORY-RING)
         ======================================================== -->
    <div class="mb-6 overflow-hidden">
        <div class="flex items-center gap-4 max-[990px]:gap-2.5 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            
            <!-- 1. cassino -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="{{ url('cassino') }}" aria-label="cassino">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-cassino.webp" alt="cassino" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">cassino</span>
            </a>

            <!-- 2. Esportes -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="{{ url('apostar') }}" aria-label="Esportes">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-esportes.webp" alt="Esportes" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">Esportes</span>
            </a>

            <!-- 3. Roleta -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="{{ url('cassino', null, null, {'category': 'Ao Vivo'}) }}" aria-label="Roleta">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-roleta.webp" alt="Roleta" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">Roleta</span>
            </a>

            <!-- 4. Missões -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="javascript:;" onclick="$('#modal-missao-99').removeClass('hidden');" aria-label="Missões">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-missoes.webp" alt="Missões" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">Missões</span>
            </a>

            <!-- 5. Top Gun -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="{{ url('cassino/jogar/top-gun') }}" aria-label="Top Gun">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-topgun.webp" alt="Top Gun" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">Top Gun</span>
            </a>

            <!-- 6. Golden Tiger -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="{{ url('cassino/jogar/fortune-tiger') }}" aria-label="Golden Tiger">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-goldentiger.webp" alt="Golden Tiger" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">Golden Tiger</span>
            </a>

            <!-- 7. Golden Rabbit -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="{{ url('cassino/jogar/fortune-rabbit') }}" aria-label="Golden Rabbit">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-goldenrabbit.webp" alt="Golden Rabbit" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">Golden Rabbit</span>
            </a>

            <!-- 8. Golden Dragon -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="{{ url('cassino/jogar/fortune-dragon') }}" aria-label="Golden Dragon">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-goldendragon.webp" alt="Golden Dragon" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">Golden Dragon</span>
            </a>

            <!-- 9. Aviator -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="{{ url('cassino/jogar/aviator') }}" aria-label="Aviator">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-aviator.webp" alt="Aviator" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">Aviator</span>
            </a>

            <!-- 10. Mines -->
            <a class="group flex flex-col items-center gap-2 max-[990px]:gap-1.5 shrink-0 w-[92px] max-[990px]:w-[72px]" href="{{ url('cassino/jogar/mines') }}" aria-label="Mines">
                <div class="story-ring w-[92px] h-[92px] max-[990px]:w-[72px] max-[990px]:h-[72px] rounded-full p-[3px] transition-[transform,box-shadow] duration-200 group-hover:scale-105">
                    <div class="w-full h-full rounded-full bg-theme-bg p-[3px]">
                        <div class="w-full h-full rounded-full overflow-hidden bg-theme-card-2">
                            <img src="cdn/99play/circles/circle-mines.webp" alt="Mines" class="w-full h-full object-cover">
                        </div>
                    </div>
                </div>
                <span class="block w-full text-center text-[12px] max-[990px]:text-[11px] font-semibold text-white/90 truncate group-hover:text-white">Mines</span>
            </a>

        </div>
    </div>

    <!-- ========================================================
         SEÇÃO 1: PAGANDO MUITO HOJE (1:1 99PLAY TRACK)
         ======================================================== -->
    <div class="mb-8">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2 text-base font-bold text-white">
                <i class="fa fa-money text-warning" style="color:var(--theme-paid-value);"></i>
                <span>Pagando muito hoje</span>
            </div>
            <a href="{{ url('cassino') }}" class="text-xs font-semibold text-theme-primary hover:underline">Ver todos</a>
        </div>

        <div class="flex gap-3 overflow-x-auto pb-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden -mx-4 px-4 max-[990px]:-mx-3 max-[990px]:px-3">
            {% set pagandoJogos = jogos|slice(0, 10) %}
            {% set pagouValores = ['2.614.551,00', '1.533.102,00', '691.079,67', '539.951,37', '300.826,60', '285.426,00', '261.000,00', '252.434,50', '211.098,32', '181.180,20'] %}
            
            {% for j in pagandoJogos %}
                <a href="{{ url('cassino/jogar/' ~ (j.game_code|default(j.code))) }}" class="group block shrink-0 w-[150px] max-[990px]:w-[136px] rounded-xl border border-white/[0.05] bg-theme-card-3 p-2 transition-transform duration-300 hover:-translate-y-1">
                    <div class="relative overflow-hidden rounded-lg">
                        <!-- Rank Badge -->
                        <span class="absolute left-1.5 top-1.5 z-10 flex items-center gap-1 rounded-full bg-gradient-to-b from-amber-300 to-amber-500 px-1.5 py-0.5 text-[10px] font-extrabold text-amber-950 shadow ring-1 ring-amber-200/40">
                            <i class="fa fa-crown text-[9px]"></i> {{ loop.index }}º
                        </span>
                        
                        <div class="relative overflow-hidden rounded-md w-full bg-theme-card-1" style="height: 140px;">
                            <img src="{{ j.image|default(j.cover)|default(j.banner)|default(url('cdn/99play/dice.png')) }}" alt="{{ j.name }}" class="object-cover rounded-[inherit] w-full h-full transition-transform duration-300 group-hover:scale-105" loading="lazy">
                        </div>
                    </div>
                    
                    <div class="mt-2 px-0.5">
                        <div class="truncate text-xs font-semibold text-white">{{ j.name }}</div>
                        <div class="mt-1 flex items-center gap-1 text-[9px] font-semibold uppercase tracking-wide text-theme-card-text">
                            <i class="fa fa-coins" style="color:var(--theme-paid-value);"></i> Pagou hoje
                        </div>
                        <div class="text-xs font-bold leading-tight tabular-nums" style="color:var(--theme-paid-value);">
                            R$&nbsp;{{ pagouValores[loop.index0]|default('128.450,00') }}
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>

    <!-- ========================================================
         SEÇÃO 2: TOP 10 DA SEMANA (NÚMEROS NEON 3D 1:1)
         ======================================================== -->
    <div class="mb-8">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2 text-base font-bold text-white">
                <i class="fa fa-fire text-danger"></i>
                <span>Top 10 da semana</span>
            </div>
        </div>

        <div class="top10-track flex gap-2 max-[990px]:gap-1 overflow-x-auto overflow-y-hidden overscroll-x-contain touch-auto snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden -mx-4 px-4 max-[990px]:-mx-3 max-[990px]:px-3 pb-4 pt-2">
            {% set top10Jogos = jogos|slice(0, 10) %}
            {% for j in top10Jogos %}
                <a class="top10-item group shrink-0 snap-start flex items-end" href="{{ url('cassino/jogar/' ~ (j.game_code|default(j.code))) }}" aria-label="{{ loop.index }}º lugar: {{ j.name }}">
                    <span aria-hidden="true" class="top10-number">{{ loop.index }}</span>
                    <div class="top10-card relative rounded-2xl overflow-hidden shadow-2xl transition-transform duration-200 group-hover:-translate-y-1">
                        <div class="relative overflow-hidden rounded-2xl bg-theme-card-1 w-full h-full" style="aspect-ratio: 175 / 236;">
                            <img src="{{ j.image|default(j.cover)|default(j.banner)|default(url('cdn/99play/dice.png')) }}" alt="{{ j.name }}" class="object-cover rounded-[inherit] w-full h-full transition-transform duration-300 group-hover:scale-105" loading="lazy">
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>

    <!-- ========================================================
         SEÇÃO 3: LOBBY DE JOGOS & FILTROS (1:1 99PLAY)
         ======================================================== -->
    <div class="mb-6">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2">
                <i class="fa fa-th-large text-theme-primary"></i>
                <h2 class="text-lg font-bold text-white m-0">Todos os Jogos</h2>
                <span class="text-xs px-2 py-0.5 rounded-full font-bold" style="background:var(--theme-card-1);color:var(--theme-primary);">{{ jogos|length }}</span>
            </div>

            <!-- Filtros de Provedores em Pílulas -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                <a href="{{ url('cassino') }}" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors {{ not category or category == 'all' ? 'bg-theme-primary text-white' : 'bg-theme-card-2 text-white/70 hover:text-white' }}">
                    Todos
                </a>
                <a href="{{ url('cassino', null, null, {'category': 'Destaques'}) }}" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors {{ category == 'Destaques' ? 'bg-theme-primary text-white' : 'bg-theme-card-2 text-white/70 hover:text-white' }}">
                    ⭐ Destaques
                </a>
                <a href="{{ url('cassino', null, null, {'category': 'PGSOFT'}) }}" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors {{ category == 'PGSOFT' ? 'bg-theme-primary text-white' : 'bg-theme-card-2 text-white/70 hover:text-white' }}">
                    PG Soft
                </a>
                <a href="{{ url('cassino', null, null, {'category': 'PRAGMATIC'}) }}" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors {{ category == 'PRAGMATIC' ? 'bg-theme-primary text-white' : 'bg-theme-card-2 text-white/70 hover:text-white' }}">
                    Pragmatic Play
                </a>
                <a href="{{ url('cassino', null, null, {'category': 'Crash'}) }}" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors {{ category == 'Crash' ? 'bg-theme-primary text-white' : 'bg-theme-card-2 text-white/70 hover:text-white' }}">
                    🚀 Crash & Aviator
                </a>
                <a href="{{ url('cassino', null, null, {'category': 'POPOK'}) }}" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors {{ category == 'POPOK' ? 'bg-theme-primary text-white' : 'bg-theme-card-2 text-white/70 hover:text-white' }}">
                    PopOK
                </a>
            </div>
        </div>

        <!-- Grade Responsiva de Jogos Compacta 1:1 99play -->
        <div class="play-games-grid">
            {% for j in jogos %}
                <div class="group relative rounded-xl overflow-hidden cursor-pointer transition-transform duration-200 hover:-translate-y-1 hover:shadow-lg border border-white/[0.04]" style="background:var(--theme-card-2);aspect-ratio: 3 / 4;" onclick="location.href='{{ url('cassino/jogar/' ~ (j.game_code|default(j.code))) }}';">
                    
                    <!-- Capa do Jogo -->
                    <img src="{{ j.image|default(j.cover)|default(j.banner)|default(url('cdn/99play/dice.png')) }}" alt="{{ j.name }}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy">
                    
                    <!-- Badges Compactas -->
                    <div class="absolute top-1.5 left-1.5 right-1.5 flex items-center justify-between pointer-events-none">
                        {% if j.featured or j.is_highlight %}
                            <span class="px-1.5 py-0.5 rounded text-[8px] font-extrabold uppercase shadow" style="background:#00e054;color:#000;">TOP</span>
                        {% else %}
                            <span></span>
                        {% endif %}
                        <span class="px-1.5 py-0.5 rounded text-[8px] font-bold uppercase backdrop-blur-md" style="background:rgba(0,0,0,0.7);color:var(--theme-paid-value);border:1px solid rgba(242,186,9,0.3);">
                            {{ j.provider|slice(0, 8) }}
                        </span>
                    </div>

                    <!-- Overlay ao passar o mouse -->
                    <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center p-2 text-center transition-opacity duration-200">
                        <span class="text-[11px] font-bold text-white mb-0.5 truncate w-full">{{ j.name }}</span>
                        <span class="text-[9px] text-white/70 mb-2 truncate w-full">{{ j.provider }}</span>
                        <button type="button" class="btn-primary py-1 px-2.5 rounded-lg text-[11px] font-bold flex items-center gap-1 shadow">
                            <i class="fa fa-play text-[8px]"></i> Jogar
                        </button>
                    </div>

                </div>
            {% endfor %}
        </div>
    </div>

{% endblock %}
