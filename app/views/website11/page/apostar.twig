{% block modalCotacoes %}
    <div id="modal-cotacoes" class="modal" aria-hidden="true">
        <div class="modal-dialog v4-turbo-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="dialog-title">
                        <span v-if="mJogo.jogo">${mJogo.jogo.casa} x ${mJogo.jogo.fora}</span>
                        <span v-else>Mais cotações</span>
                    </h2>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="bet24-tabs bet24-mercado-tabs">
                        <button type="button" class="bet24-tab" v-for="(tempo, key) in tempos" :key="key"
                                :class="{'is-active': mJogo.tempo == key}"
                                v-on:click="mJogo.tempo = key">${tempo}</button>
                    </div>

                    <div v-if="mJogo.jogo" class="bet24-mercados">
                        <template v-for="(grupo, id) in grupos">
                            <div class="market" v-if="getCotacoesByGrupo(id).length" :key="id">
                                <div class="market-head">
                                    <span>${grupo}</span>
                                </div>
                                <div class="market-grid">
                                    <button type="button" class="odd odd-pickable"
                                            v-for="c in getCotacoesByGrupo(id)" :key="c.id"
                                            :class="{active: mJogo.jogo.apostaEm == (mJogo.tempo + c.campo)}"
                                            v-on:click="apostar(mJogo.jogo, mJogo.tempo, c)">
                                        <span class="odd-label"><span class="odd-label-text">${c.title}</span></span>
                                        <span class="odd-price">${maskReal(mJogo.jogo.cotacoes[mJogo.tempo][c.campo])}</span>
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{# =====================================================================
   LOGICA (app Vue + endpoints) - reaproveitada do template base
   ===================================================================== #}
{% block script %}
    {{ block('script', 'website/page/apostar.twig') }}

    <script>
        (function () {
            if (!window.app) {
                return;
            }

            // Data inicial vinda da URL (?data=YYYY-MM-DD), usada pelo menu "Jogos de hoje/amanhã"
            var dataInicial = {{ ('' ~ (_get.data ?: hoje))|json_encode|raw }};
            if (dataInicial && window.app.findData !== dataInicial) {
                window.app.findData = dataInicial;
            }

            // Se o dia escolhido nao tiver jogos, abre no primeiro dia com jogos
            window.app.$watch('datas', function (lista) {
                if (!lista || !lista.length) {
                    return;
                }
                var datasComJogos = lista.map(function (d) {
                    return d.data;
                });
                if (window.app.findData && datasComJogos.indexOf(window.app.findData) === -1) {
                    window.app.findData = datasComJogos[0];
                }
            });

            // Se por algum motivo nao vier nenhum dia, troca o "Carregando" por estado vazio
            setTimeout(function () {
                if (window.app.datas && window.app.datas.length) {
                    return;
                }
                var carregando = document.querySelector('.v4-carregando');
                if (carregando) {
                    carregando.innerHTML = '<div class="empty-state"><div class="empty-title">Nenhum jogo disponivel no momento</div><div class="empty-text">Assim que novos jogos forem cadastrados eles aparecem aqui.</div></div>';
                }
            }, 10000);

            // Busca inicial (?search=)
            var buscaInicial = {{ ('' ~ (_get.search ?: ''))|json_encode|raw }};
            if (buscaInicial) {
                window.app.search = buscaInicial;
            }

            // O modal de busca filtra os jogos no cliente (sem recarregar)
            $(document).data('bet24-busca-live', true);
            $(document).on('bet24:busca', function (e, termo) {
                window.app.search = termo || '';
            });

            // Abre o cupom automaticamente quando a pessoa adiciona a primeira odd
            window.app.$watch('aposta.jogos.length', function (novo, antigo) {
                $.bet24AtualizaQtd(novo);
                if (novo > 0 && !window.bet24CupomAberto()) {
                    $('#v4Cupom').addClass('is-entrando');
                    setTimeout(function () {
                        $('#v4Cupom').removeClass('is-entrando');
                    }, 420);
                }
                if (novo === 0) {
                    window.bet24FechaCupom && window.bet24FechaCupom();
                }
            });

            // "Ver sugestões": monta um bilhete com até 3 jogos disponíveis e
            // escolhe o valor para o ganho ficar dentro da faixa selecionada.
            $(document).on('click', '.suggest-range', function () {
                $('.suggest-range').removeClass('is-active').attr('aria-checked', 'false');
                $(this).addClass('is-active').attr('aria-checked', 'true');
            });

            // O valor digitado no cartão de sugestões também alimenta o bilhete.
            $('#bet24SugValor').on('input change', function () {
                if (!window.app) {
                    return;
                }
                var valor = parseFloat(String($(this).val()).replace(/\./g, '').replace(',', '.'));
                if (!isNaN(valor) && valor > 0) {
                    window.app.valorAposta = valor;
                }
            });

            $('#bet24SugVer').on('click', function () {
                var v = window.app;
                if (!v) {
                    return;
                }

                var candidatos = [];
                (v.getCampeonatos(null, true) || []).forEach(function (c) {
                    (c.jogos || []).forEach(function (j) {
                        var cota = j.cotacoes && j.cotacoes['90'];
                        if (cota && (cota.casa || cota.empate || cota.fora) && (!v.jogoAberto || v.jogoAberto(j))) {
                            candidatos.push(j);
                        }
                    });
                });

                if (!candidatos.length) {
                    window.bet24Aviso('Nenhum jogo disponível para montar a sugestão agora.');
                    return;
                }

                if (v.limpaAposta) {
                    v.limpaAposta();
                }

                var passo = Math.max(1, Math.floor(candidatos.length / 3));
                var escolhidos = [];
                for (var i = 0; i < candidatos.length && escolhidos.length < 3; i += passo) {
                    escolhidos.push(candidatos[i]);
                }

                var oddTotal = 1;
                escolhidos.forEach(function (j) {
                    var cota = j.cotacoes['90'];
                    var campo = cota.casa ? 'casa' : (cota.empate ? 'empate' : 'fora');
                    oddTotal *= parseFloat(cota[campo]) || 1;
                    v.apostar(j, '90', {
                        campo: campo,
                        principal: '1',
                        sigla: campo === 'casa' ? '1' : (campo === 'empate' ? 'X' : '2')
                    });
                });

                var $faixa = $('.suggest-range.is-active');
                var alvo = ((parseFloat($faixa.data('min')) || 60) + (parseFloat($faixa.data('max')) || 200)) / 2;
                var valor = alvo / oddTotal;
                valor = Math.max(v.apostaMinima || 1, Math.min(v.apostaMaxima || 999999, valor));
                v.valorAposta = Math.round(valor * 100) / 100;

                $('#bet24SugValor').val(v.valorAposta.toFixed(2).replace('.', ','));

                setTimeout(function () {
                    window.bet24AbreCupom && window.bet24AbreCupom();
                    window.bet24Aviso('Sugestão montada no bilhete. Confira as seleções e finalize.');
                }, 150);
            });

            // Copiar o bilhete (texto simples)
            window.app.bet24CopiarBilhete = function () {
                var linhas = window.app.aposta.jogos.map(function (v) {
                    var odd = v.jogo.cotacoes && v.jogo.cotacoes[v.tempo] ? v.jogo.cotacoes[v.tempo][v.cotacao.campo] : '';
                    return v.jogo.casa + ' x ' + v.jogo.fora + ' - ' + (v.cotacao.title || v.cotacao.sigla) + ': ' + window.app.maskReal(odd);
                });
                var texto = 'Bilhete (' + window.app.aposta.jogos.length + ' seleções)\n' + linhas.join('\n')
                    + '\nCotação: ' + window.app.valorCotacao
                    + '\nValor: R$ ' + window.app.maskReal(window.app.valorAposta)
                    + '\nPrêmio: R$ ' + window.app.premio;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(texto).then(function () {
                        window.bet24Aviso('Bilhete copiado!');
                    });
                } else {
                    window.prompt('Copie o bilhete abaixo:', texto);
                }
            };
        })();
    </script>
{% endblock %}
