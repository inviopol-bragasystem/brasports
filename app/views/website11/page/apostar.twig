{% block bilhete %}
    <div class="aside-card slip-card" :data-qtd="aposta.jogos.length">
        <div class="slip-head">
            <strong>Bilhete</strong>
            <span class="slip-badge" v-text="aposta.jogos.length">0</span>
            <button type="button" class="slip-clear" v-on:click="limpaAposta" title="Limpar bilhete">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5M14 11v5"/>
                </svg>
                Limpar
            </button>
            <button type="button" class="slip-clear v4-aside-fechar" data-v4-bilhete-fechar
                    aria-label="Fechar bilhete">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 6l12 12M18 6L6 18"/>
                </svg>
            </button>
        </div>

        <div class="v4-compartilhar" v-if="aposta.jogos.length">
            <button type="button" class="v4-compartilhar-item" v-on:click="bet24CopiarBilhete">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="8" y="8" width="12" height="12" rx="2"/>
                    <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>
                </svg>
                Copiar
            </button>
            <a class="v4-compartilhar-item v4-whatsapp"
               href="https://api.whatsapp.com/send?text=Confira%20meu%20bilhete%20no%20{{ dados.getBanca()|url_encode }}"
               target="_blank" rel="noopener">
                <i class="fab fa-whatsapp"></i> Whatsapp
            </a>
        </div>

        <div class="slip-tabs ticket-menu" v-if="aposta.jogos.length">
            <div class="slip-tab" :class="{'is-on': aposta.jogos.length === 1}">Simples</div>
            <div class="slip-tab" :class="{'is-on': aposta.jogos.length === 2}">Dupla</div>
            <div class="slip-tab" :class="{'is-on': aposta.jogos.length > 2}">Múltipla</div>
        </div>

        <p class="v4-bilhete-vazio">Clique em uma cotação para montar o seu bilhete.</p>

        <div class="ticket-info">
            <div class="ticket-item" v-for="(v, i) in aposta.jogos" :key="i">
                <div class="ticket-item-header">
                    <div class="ticket-item-league">${v.jogo.campeonato}</div>
                </div>
                <div class="ticket-item-data">
                    <div class="ticket-item-teams">
                        <span>
                            <img :src="v.jogo.imgCasa" alt="" v-if="v.jogo.imgCasa"/>
                            ${v.jogo.casa}
                        </span>
                        <span>
                            <img :src="v.jogo.imgFora" alt="" v-if="v.jogo.imgFora"/>
                            ${v.jogo.fora}
                        </span>
                    </div>
                    <div class="ticket-item-date">
                        <i class="far fa-clock" aria-hidden="true"></i>
                        ${v.jogo.data.split('-').reverse().join('/')} ${v.jogo.hora.replace(/:00$/, '')}
                        <span class="ticket-item-remove">
                            <a href="javascript:;" v-on:click="rmAposta(i)" title="Remover">
                                <i class="far fa-trash-alt" aria-hidden="true"></i>
                            </a>
                        </span>
                    </div>
                </div>
                <div class="ticket-item-odd">
                    <div class="ticket-item-market">${grupos[v.cotacao.grupo] || v.cotacao.campo || 'Mercado'}<span v-if="v.tempo != '90'"> — ${v.tempo == 'pt' ? '1º Tempo' : '2º Tempo'}</span></div>
                    <div class="ticket-item-type">
                        <span>${v.cotacao.title || v.cotacao.sigla}</span>
                        <span class="ticket-item-value">${maskReal(v.jogo.cotacoes[v.tempo] ? v.jogo.cotacoes[v.tempo][v.cotacao.campo] : 0)}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="ticket-content slip-foot">
            <div class="ticket-content-value">
                <label class="stake-field">
                    <span class="stake-currency">R$</span>
                    <input type="number" v-model="valorAposta" :min="apostaMinima" :max="apostaMaxima"
                           step="1" inputmode="decimal" placeholder="Digite o valor"/>
                </label>
                {% if not user %}
                    <label class="stake-field">
                        <span class="stake-currency">
                            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4"/>
                                <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
                            </svg>
                        </span>
                        <input type="text" v-model="cliente" placeholder="Nome do cliente (opcional)"
                               maxlength="50"/>
                    </label>
                {% endif %}
            </div>

            <dl class="slip-totals ticket-content-data">
                <div class="ticket-content-data-item">
                    <dt>Bilhetes</dt>
                    <dd v-text="aposta.jogos.length">0</dd>
                </div>
                <div class="ticket-content-data-item">
                    <dt>Cotação</dt>
                    <dd v-text="valorCotacao">0,00</dd>
                </div>
                <div class="ticket-content-data-item">
                    <dt>Aposta total</dt>
                    <dd>R$ <span v-text="maskReal(valorAposta)">0,00</span></dd>
                </div>
                <div class="ticket-content-data-item slip-return">
                    <dt>Valor do prêmio</dt>
                    <dd>R$ <span v-text="premio">0,00</span></dd>
                </div>
            </dl>

            <button type="button" class="slip-place" :disabled="!apostaValida"
                    v-on:click="finalizarAposta">
                {{ user ? 'Apostar' : 'Criar pré-bilhete' }}
            </button>
        </div>
    </div>
{% endblock %}

