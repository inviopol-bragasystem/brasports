<script>
    window.BET24_URL_APOSTAR = '{{ url('apostar') }}';
    window.BET24_URL = '{{ url() }}';
    window.BET24_LOGADO = {{ user ? 'true' : 'false' }};

    // Contador do bilhete no topo
    $.bet24AtualizaQtd = function (qtd) {
        $('.topbar-badge.v4-qtd').each(function () {
            $(this).text(qtd).prop('hidden', qtd <= 0);
        });
    };

    // Submissão do Login via AJAX com mensagens claras e retorno rápido
    $('#form-login').on('submit', function (e) {
        e.preventDefault();
        var $form = $(this);
        var $btn = $form.find('button[type="submit"]');
        var $err = $('#v4EntrarErro');

        $err.hide().text('');
        $btn.prop('disabled', true).text('Entrando...');

        $.ajax({
            url: $form.attr('action') || '{{ url('entrar/login/insert') }}',
            type: 'POST',
            data: $form.serialize(),
            dataType: 'json',
            success: function (res) {
                if (res && res.result == 1) {
                    window.location.href = res.url || '{{ url() }}';
                } else {
                    $btn.prop('disabled', false).text('Entrar');
                    var msg = (res && res.message) ? res.message : 'Login ou senha incorretos.';
                    $err.text(msg).show();
                    if (typeof swal === 'function') {
                        swal('Erro', msg, 'error');
                    }
                }
            },
            error: function () {
                $btn.prop('disabled', false).text('Entrar');
                $err.text('Erro de comunicação com o servidor. Tente novamente.').show();
            }
        });
    });

    // Submissão do Cadastro (Modal) via AJAX
    $('#form-cadastro').on('submit', function (e) {
        e.preventDefault();
        var $form = $(this);
        var $btn = $form.find('button[type="submit"]');
        var $err = $('#v4CadastroErro');

        var senha = $form.find('input[name="senha"]').val();
        var csenha = $form.find('input[name="confirmar-senha"]').val();

        if (senha && csenha && senha !== csenha) {
            $err.text('A confirmação da senha não confere com a senha digitada.').show();
            return;
        }

        $err.hide().text('');
        $btn.prop('disabled', true).text('Cadastrando...');

        $.ajax({
            url: $form.attr('action') || '{{ url('cadastrar/insert') }}',
            type: 'POST',
            data: $form.serialize(),
            dataType: 'json',
            success: function (res) {
                if (res && res.result == 1) {
                    var msg = res.message || 'Cadastro realizado com sucesso!';
                    if (typeof swal === 'function') {
                        swal('Sucesso!', msg, 'success').then(function () {
                            window.location.href = res.url || '{{ url() }}';
                        });
                    } else {
                        alert(msg);
                        window.location.href = res.url || '{{ url() }}';
                    }
                } else {
                    $btn.prop('disabled', false).text('Cadastrar-se');
                    var msg = (res && res.message) ? res.message : 'Não foi possível concluir o cadastro.';
                    $err.text(msg).show();
                    if (typeof swal === 'function') {
                        swal('Erro', msg, 'error');
                    }
                }
            },
            error: function () {
                $btn.prop('disabled', false).text('Cadastrar-se');
                $err.text('Erro de comunicação com o servidor. Tente novamente.').show();
            }
        });
    });

    $(function () {
        if (typeof FastClick !== 'undefined') {
            FastClick.attach(document.body);
        }
    });
</script>

{% block script %}{% endblock %}

{{ dados.getHtmlFooter()|raw }}

