<!doctype html>
<html lang="pt-BR" data-theme="light">
<head>
    {{ seo_header() }}

    {# Tema claro/escuro: aplica antes do primeiro paint (mesma chave do site antigo) #}
    <script>
        (function () {
            try {
                if (localStorage.getItem('Tema') === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (e) {}
        })();
    </script>

    <meta name="theme-color" content="#263e0f"/>

    <link rel="stylesheet" href="css/bet24/all.min.css"/>
    <link rel="stylesheet" href="css/bet24/fonts.css"/>
    <link rel="stylesheet" href="css/bet24/app.css"/>
    <link rel="stylesheet" href="css/loading.css"/>
    <link rel="stylesheet" href="css/sweetalert2.min.css"/>

    {# Cores da marca (mesmo par do bet24hs.site/v4) - precisa vir entre app.css e v4.css #}
    <style>
        :root {
            --primary-color: #263e0f;
            --text-primary-color: #d4ec00;
            --secondary-color: #068a00;
            --secondary-text: #ffffff;
            --hover-color: #606060;
        }
    </style>

    <link rel="stylesheet" href="css/bet24/v4.css"/>
    <link rel="stylesheet" href="css/bet24/bet24.css"/>
    <link rel="stylesheet" href="css/bet24/paginas-contas.css"/>
    <link rel="stylesheet" href="css/bet24/paginas-financeiro.css"/>
    <link rel="stylesheet" href="css/bet24/paginas-cassino.css"/>

    {% block head %}{% endblock %}

    {{ dados.getHtmlHead()|raw }}
    {% include 'website/inc/personalizacao-css.twig' %}
</head>
<body>

{% set hoje = 'now'|date('Y-m-d') %}
{% set amanha = '+1day'|date('Y-m-d') %}
{% set anoAtual = 'now'|date('Y') %}

{# Marca/logo: usa o logo do painel; se nao tiver, usa o logo do tema bet24 #}
{% set logoUrl = 'imagens/bet24/logo-bet24hs.png' %}
{% if dados.imgCapa(true, 'logo').getSource() %}
    {% set logoUrl = dados.imgCapa(true, 'logo').getSource(true) %}
{% endif %}

{% set redes = config('redes') %}

{# =====================================================================
     MODAL DE LOGIN (Entrar)
     ===================================================================== #}
<div class="modal fade v4-sheet" id="modal-login" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="v4EntrarTitulo" aria-hidden="true">
    <div class="modal-dialog v4-entrar-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="dialog-title" id="v4EntrarTitulo">Entrar</h2>
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="form-login" class="account-form v4-entrar-form" autocomplete="off" method="post" action="{{ url('entrar/login/insert') }}">
                    <label class="account-field">
                        <span class="account-label">Usuário, e-mail ou CPF</span>
                        <input class="account-input" type="text" name="username" id="v4EntrarUsuario"
                               autocomplete="username" autocapitalize="off" required/>
                    </label>

                    <label class="account-field">
                        <span class="account-label">Senha</span>
                        <input class="account-input" type="password" name="password" id="v4EntrarSenha"
                               autocomplete="current-password" required minlength="4" maxlength="32"/>
                    </label>

                    <p class="v4-cadastro-erro" id="v4EntrarErro" role="alert" style="display:none;"></p>

                    <button type="submit" class="account-submit" id="btnEntrarSubmit">Entrar</button>

                    <div class="v4-entrar-links">
                        <a href="{{ url('recuperar-senha') }}" data-v4-recuperar>Esqueci a senha</a>
                        {% if dados.getExibirRegistro() %}
                            <span>Não tem conta? <a href="#modal-cadastro" data-toggle="modal" data-v4-cadastro>Cadastre-se</a></span>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{# =====================================================================
     MODAL DE CADASTRO (Criar conta)
     ===================================================================== #}
<div class="modal fade v4-sheet" id="modal-cadastro" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="v4CadastroTitulo" aria-hidden="true">
    <div class="modal-dialog v4-cadastro-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="dialog-title" id="v4CadastroTitulo">Criar conta</h2>
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form class="account-form v4-cadastro-form" autocomplete="off" id="form-cadastro" method="post" action="{{ url('cadastrar/insert') }}" novalidate>
                    <p class="account-hint">Leva menos de um minuto. Depois do cadastro você já pode depositar e apostar.</p>

                    <label class="account-field">
                        <span class="account-label">Nome completo</span>
                        <input type="text" id="cad_nome" name="nome" required class="account-input" autocomplete="name" placeholder="Seu nome completo">
                    </label>

                    <div class="v4-cadastro-2">
                        <label class="account-field">
                            <span class="account-label">CPF</span>
                            <input type="text" id="cad_cpf" name="cpf" required class="account-input mask-cpf" inputmode="numeric" placeholder="000.000.000-00" autocomplete="off">
                        </label>

                        <label class="account-field">
                            <span class="account-label">Celular</span>
                            <input type="text" id="cad_celular" name="celular" required class="account-input mask-telefone" inputmode="tel" placeholder="(00) 00000-0000" autocomplete="tel">
                        </label>
                    </div>

                    <div class="v4-cadastro-2">
                        <label class="account-field">
                            <span class="account-label">Usuário</span>
                            <input type="text" id="cad_usuario" name="login" required class="account-input" autocomplete="off" autocapitalize="off" placeholder="Seu usuário">
                        </label>

                        <label class="account-field">
                            <span class="account-label">Email</span>
                            <input type="email" id="cad_email" name="email" required class="account-input" autocomplete="email" placeholder="seu@email.com">
                        </label>
                    </div>

                    <div class="v4-cadastro-2">
                        <label class="account-field">
                            <span class="account-label">Senha</span>
                            <input type="password" id="cad_senha" name="senha" required minlength="6" class="account-input" autocomplete="new-password" placeholder="Mínimo 6 caracteres">
                        </label>

                        <label class="account-field">
                            <span class="account-label">Confirmar senha</span>
                            <input type="password" id="cad_csenha" name="confirmar-senha" required minlength="6" class="account-input" autocomplete="new-password" placeholder="Repita a senha">
                        </label>
                    </div>

                    <p class="v4-cadastro-erro" id="v4CadastroErro" role="alert" style="display:none;"></p>

                    <button type="submit" class="account-submit" id="v4CadastroBotao">Cadastrar-se</button>

                    <p class="v4-cadastro-rodape">
                        Ao se cadastrar você aceita as <a href="{{ url('regras') }}" target="_blank" rel="noopener">regras</a>
                        e os <a href="{{ url('termos-uso') }}" target="_blank" rel="noopener">termos de uso</a>.
                    </p>

                    <p class="v4-cadastro-rodape">
                        Já tem conta? <a href="#modal-login" data-toggle="modal" data-v4-entrar>Entrar</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

{# =====================================================================
     MODAL DE BUSCA (filtra os jogos da home)
     ===================================================================== #}
<div class="modal v4-sheet" id="bet24BuscaModal" aria-hidden="true">
    <div class="modal-dialog v4-busca-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="dialog-title">Buscar jogos</h2>
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="bet24BuscaForm" class="account-form" autocomplete="off">
                    <div class="v4-busca-campo">
                        <input class="search search-input" id="bet24BuscaInput" type="search"
                               placeholder="Time, campeonato ou país" aria-label="Buscar jogos"/>
                        <button type="button" class="v4-busca-limpar" id="bet24BuscaLimpar"
                                aria-label="Limpar busca" hidden>&times;
                        </button>
                    </div>
                    <p class="account-hint">Digite o nome de um time ou campeonato. Os jogos da página
                        são filtrados na hora.</p>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="website" {% if pageAposta %}v-cloak{% endif %}>
    <div class="app">

        {# =============================================================
             HEADER (topbar do tema v4)
             ============================================================= #}
        <header class="topbar">
            <a class="brand" href="{{ url() }}" aria-label="{{ dados.getBanca() }}">
                {% if logoUrl %}
                    <img class="brand-logo" src="{{ logoUrl }}" alt="{{ dados.getBanca() }}"/>
                {% else %}
                    <span class="brand-text">BET<b>24</b></span>
                {% endif %}
            </a>

            <nav class="topnav" aria-label="Seções">
                <a class="topnav-link{{ (controller == 'apostar' or controller == 'index' or controller == 'site') ? ' topnav-active active' : '' }}"
                   href="{{ url() }}">Esportes</a>
                <a class="topnav-link" href="{{ url('apostar', null, null, {'data': hoje}) }}">Jogos de hoje</a>
                <a class="topnav-link" href="{{ url('apostar', null, null, {'data': amanha}) }}">Próximos jogos</a>
                {% if dados.getExibirCassino() %}
                    <a class="topnav-link{{ controller == 'cassino' ? ' topnav-active active' : '' }}"
                       href="{{ url('cassino') }}">Cassino</a>
                {% endif %}
                {% if dados.getExibirBilhete() %}
                    <a class="topnav-link{{ controller == 'bilhete' ? ' topnav-active active' : '' }}"
                       href="{{ url('bilhete') }}">Bilhete</a>
                {% endif %}
            </nav>

            <div class="topbar-actions">
                <button type="button" class="search-pill" data-bet24-busca
                        aria-haspopup="dialog" aria-label="Buscar jogos">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="10.5" cy="10.5" r="6.5"/>
                        <path d="m20 20-4.8-4.8"/>
                    </svg>
                    <span class="search-pill-text">Buscar jogos</span>
                </button>

                <button type="button" class="topbar-icon" id="theme-toggle"
                        aria-label="Alternar tema claro e escuro" title="Tema claro / escuro">
                    <span class="v4-tema-claro">
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
                        </svg>
                    </span>
                    <span class="v4-tema-escuro">
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             stroke-linejoin="round">
                            <circle cx="12" cy="12" r="4"/>
                            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
                        </svg>
                    </span>
                </button>

                <button type="button" class="topbar-icon topbar-bets" data-bet24-bilhete
                        aria-label="Abrir bilhete" title="Bilhete">
                    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 3h14v18l-2.3-1.6L14.3 21 12 19.4 9.7 21l-2.4-1.6L5 21z"/>
                        <path d="M9 8h6M9 12h6"/>
                    </svg>
                    {% if pageAposta %}
                        <span class="topbar-badge v4-qtd" :hidden="aposta.jogos.length === 0"
                              v-text="aposta.jogos.length"></span>
                    {% else %}
                        <span class="topbar-badge v4-qtd" hidden>0</span>
                    {% endif %}
                </button>

                {% if not user %}
                    <div class="account-actions">
                        {% if dados.getExibirLogin() %}
                            <button type="button" class="account-signin" data-toggle="modal"
                                    data-target="#modal-login" aria-haspopup="dialog">Entrar</button>
                        {% endif %}
                        {% if dados.getExibirRegistro() %}
                            <button type="button" class="account-signup" data-toggle="modal"
                                    data-target="#modal-cadastro">Cadastrar</button>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="bet24-account">
                        <button type="button" class="bet24-conta-btn" id="bet24-conta-btn"
                                aria-haspopup="true" aria-expanded="false" aria-controls="bet24-conta-menu">
                            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <rect x="3" y="6" width="18" height="13" rx="3"/>
                                <path d="M3 10h18M16 14.5h2"/>
                            </svg>
                            <span class="bet24-conta-saldo">R$ {{ user.getCredito(true) }}</span>
                        </button>

                        <div class="bet24-conta-menu" id="bet24-conta-menu">
                            <div class="bet24-menu-saldo">
                                Saldo disponível
                                <b>R$ {{ user.getCredito(true) }}</b>
                            </div>
                            <a href="{{ url('financeiro/deposito') }}"><i class="fas fa-plus-circle"></i> Depósito</a>
                            <a href="{{ url('financeiro/saque') }}"><i class="fas fa-minus-circle"></i> Saque</a>
                            <a href="{{ url('financeiro/extrato') }}"><i class="fas fa-list-ul"></i> Extrato</a>
                            <a href="{{ url('financeiro/transferencia') }}"><i class="fas fa-exchange-alt"></i> Transferência</a>
                            <a href="{{ url('apostas') }}"><i class="fas fa-history"></i> Minhas apostas</a>
                            <a href="{{ url('perfil') }}"><i class="fas fa-user"></i> Meu perfil</a>
                            <a href="{{ url('logout') }}" class="bet24-menu-sair"><i class="fas fa-sign-out-alt"></i> Sair</a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </header>

        {# =============================================================
             CONTEUDO
             ============================================================= #}
        <main class="content">
            {% block main %}{% endblock %}
        </main>

        {# =============================================================
             RODAPE (v4-rodape - 5 colunas)
             ============================================================= #}
        <footer class="v4-rodape">
            <div class="v4-rodape-colunas">
                <div>
                    <h3>Apostar</h3>
                    <a href="{{ url() }}">Esportes</a>
                    <a href="{{ url('apostar', null, null, {'data': hoje}) }}">Jogos de hoje</a>
                    <a href="{{ url('apostar', null, null, {'data': amanha}) }}">Próximos jogos</a>
                    {% if dados.getExibirCassino() %}<a href="{{ url('cassino') }}">Cassino</a>{% endif %}
                </div>

                <div>
                    <h3>Minha conta</h3>
                    {% if user %}
                        <a href="{{ url('financeiro/deposito') }}">Depósito</a>
                        <a href="{{ url('financeiro/saque') }}">Saque</a>
                        <a href="{{ url('financeiro/extrato') }}">Extrato</a>
                        <a href="{{ url('apostas') }}">Minhas apostas</a>
                        <a href="{{ url('perfil') }}">Meu perfil</a>
                    {% else %}
                        {% if dados.getExibirLogin() %}
                            <a href="#modal-login" data-toggle="modal">Entrar</a>
                        {% endif %}
                        {% if dados.getExibirRegistro() %}
                            <a href="#modal-cadastro" data-toggle="modal">Criar conta</a>
                        {% endif %}
                    {% endif %}
                    {% if dados.getExibirApp() %}
                        <a href="{{ dados.getApp()|default(url('app')) }}" target="_blank">App Android</a>
                    {% endif %}
                </div>

                <div>
                    <h3>Informações</h3>
                    {% if dados.getExibirRegras() %}<a href="{{ url('regras') }}">Regras</a>{% endif %}
                    <a href="{{ url('termos-uso') }}">Termos de uso</a>
                    {% if dados.getExibirCotacoes() %}<a href="{{ url('cotacoes') }}">Tabela de cotações</a>{% endif %}
                    {% if dados.getExibirComunicados() %}<a href="{{ url('comunicados') }}">Comunicados</a>{% endif %}
                </div>

                <div>
                    <h3>Suporte</h3>
                    {% if dados.getExibirBilhete() %}<a href="{{ url('bilhete') }}">Consultar bilhete</a>{% endif %}
                    {% if dados.getExibirRegras() %}<a href="{{ url('regras') }}">Regras de bônus</a>{% endif %}
                    <a href="{{ url('termos-uso') }}">Jogo responsável</a>
                </div>

                <div>
                    <h3>Redes sociais</h3>
                    <div class="v4-rodape-redes">
                        {% if redes.instagram %}
                            <a href="{{ redes.instagram }}" target="_blank" rel="noopener"
                               aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        {% endif %}
                        {% if redes.facebook %}
                            <a href="{{ redes.facebook }}" target="_blank" rel="noopener"
                               aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                        {% endif %}
                        {% if redes.twitter %}
                            <a href="{{ redes.twitter }}" target="_blank" rel="noopener"
                               aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        {% endif %}
                        {% if not redes.instagram and not redes.facebook and not redes.twitter %}
                            <span style="color: var(--muted); font-size: 12px;">—</span>
                        {% endif %}
                    </div>
                </div>
            </div>

            <p class="v4-rodape-legal">
                Ao acessar, continuar a utilizar ou ao navegar neste site, você aceita que utilizemos certos
                cookies de navegador com o objetivo de melhorar a sua experiência como usuário. Utilizamos
                apenas cookies que melhoram a sua experiência e não interferem em sua privacidade.
                {% if dados.getExibirRegras() %}Consulte as <a href="{{ url('regras') }}">regras</a> do site.{% endif %}
            </p>

            <p class="v4-rodape-copy">
                © {{ anoAtual }} - {{ dados.getBanca() }} <span class="site-footer-age">+18</span>
            </p>
        </footer>

        <button type="button" class="to-top" id="v4Topo" aria-label="Voltar ao topo" title="Voltar ao topo">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 19V5M5 12l7-7 7 7"/>
            </svg>
        </button>

        {# =============================================================
             BOTTOM-NAV (somente celular, <=700px)
             ============================================================= #}
        <nav class="bottom-nav" aria-label="Navegação">
            <a class="bottom-nav-item{{ (controller == 'apostar' or controller == 'index' or controller == 'site') and not _get.data ? ' bottom-nav-active active' : '' }}"
               href="{{ url() }}">
                <span class="bottom-nav-icon">
                    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z"/>
                    </svg>
                </span>
                <span class="bottom-nav-label">Início</span>
            </a>

            <a class="bottom-nav-item" href="{{ url('apostar', null, null, {'data': hoje}) }}">
                <span class="bottom-nav-icon">
                    <svg aria-hidden="true" class="bolt" width="17" height="20" viewBox="0 0 11 14">
                        <path d="M6.5 0 0 8h4.5L3.5 14 11 5.5H6.3L6.5 0Z" fill="currentColor"/>
                    </svg>
                </span>
                <span class="bottom-nav-label">Hoje</span>
            </a>

            <a class="bottom-nav-item" href="{{ url('apostar', null, null, {'data': amanha}) }}">
                <span class="bottom-nav-icon">
                    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="5" width="16" height="15" rx="2"/>
                        <path d="M4 10h16M8 3v4M16 3v4"/>
                    </svg>
                </span>
                <span class="bottom-nav-label">Amanhã</span>
            </a>

            <a class="bottom-nav-item{{ controller == 'apostas' ? ' bottom-nav-active active' : '' }}"
               href="{{ url('apostas') }}">
                <span class="bottom-nav-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="3.5" width="14" height="17" rx="2"/>
                        <path d="m8.5 9 1.5 1.5 2.5-3M14.5 9h1.5M8.5 15l1.5 1.5 2.5-3M14.5 15h1.5"/>
                    </svg>
                </span>
                <span class="bottom-nav-label">Apostas</span>
            </a>

            {% if dados.getExibirCassino() %}
                <a class="bottom-nav-switch bottom-nav-switch-end" href="{{ url('cassino') }}"
                   aria-label="Cassino" title="Cassino">
                    <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
                        <defs>
                            <linearGradient id="v4bnFg" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0" stop-color="#ff6474"/>
                                <stop offset="1" stop-color="#c81e36"/>
                            </linearGradient>
                            <linearGradient id="v4bnFc" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0" stop-color="#ffffff"/>
                                <stop offset="1" stop-color="#e4e8f4"/>
                            </linearGradient>
                        </defs>
                        <ellipse cx="16" cy="19.5" rx="13" ry="10.5" fill="#8f1326"/>
                        <circle cx="16" cy="15" r="13" fill="url(#v4bnFg)"/>
                        <g stroke="#fff" stroke-width="3.6">
                            <path d="M16 2v4.5M16 23.5V28M3 15h4.5M24.5 15H29M6.8 5.8l3.2 3.2M22 21l3.2 3.2M25.2 5.8L22 9M10 21l-3.2 3.2"/>
                        </g>
                        <circle cx="16" cy="15" r="7.6" fill="url(#v4bnFc)"/>
                        <path d="M16 10.4c1.7 2.4 3.8 3.6 3.8 5.3a1.9 1.9 0 0 1-3.4 1l.5 2h-1.8l.5-2a1.9 1.9 0 0 1-3.4-1c0-1.7 2.1-2.9 3.8-5.3z"
                              fill="#c81e36"/>
                    </svg>
                </a>
            {% endif %}
        </nav>

        {# Scrim dos modais/drawers (v4) #}
        <div class="v4-scrim"></div>

        {% block bilheteGlobal %}{% endblock %}

    </div>
</div>

