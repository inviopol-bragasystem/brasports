{% extends layout %}

{# =====================================================================
   TEMA BET24 (site11) - FINANCEIRO / DEPOSITO
   ---------------------------------------------------------------------
   Visual: design system do tema v4 (css/bet24/app.css + v4.css):
     .account-form / .account-field / .account-label / .account-input
     .account-submit / .account-secondary / .account-hint
     .deposit-amount / .deposit-currency / .deposit-input
     .deposit-quick / .deposit-chip / .deposit-qr / .deposit-code
     .deposit-summary / .deposit-value / .deposit-status / .deposit-dot
     .deposit-copy / .deposit-copy-done / .deposit-how
     .v4-saq-saldo / .v4-filtros / .v4-filtros-2 / .bet24-card / .bet24-table

   LOGICA: e a mesma do template base do sistema
   (app/views/website/financeiro/deposito.twig). Todos os endpoints, ids,
   names, data-* e o JavaScript (adminPage, gerarPix, copiarPix,
   iniciarPollingPix, swal) foram preservados. Apenas o HTML/CSS mudou.
   ===================================================================== #}

{% block list %}

    {% if busca.getCount() %}

        <div class="bet24-card">
            <div class="bet24-table-scroll">
                <table class="bet24-table">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Cliente</th>
                        <th class="bet24-table-num">Valor</th>
                        <th>Situação</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for v in busca.getRegistros() %}
                        <tr>
                            <td class="bet24-table-id">#{{ v.getId() }}</td>
                            <td class="bet24-table-nowrap">{{ v.getData(true) }}</td>
                            <td>
                                {% if v.getTipo() == 'pixup' or v.getTipo() == 'veopag' %}
                                    <span class="bet24-badge is-ganha">
                                        <i class="fas fa-qrcode"></i> PIX
                                    </span>
                                {% else %}
                                    <span class="bet24-badge is-info">
                                        <i class="fas fa-paperclip"></i> Comprovante
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <strong class="bet24-table-strong">{{ v.voUser().getNome() }}</strong>
                                <small class="bet24-muted">{{ v.voUser().getLogin() }} · {{ v.voUser().getCpf() }}</small>
                            </td>
                            <td class="bet24-table-num">
                                <span class="bet24-valor-pos">R$ {{ v.getValor(true) }}</span>
                            </td>
                            <td>
                                {% if v.getStatus() == 2 %}
                                    <span class="bet24-badge is-ganha">
                                        <i class="fas fa-check-circle"></i> {{ v.getStatusTitle() }}
                                    </span>
                                {% elseif v.getStatus() == 1 %}
                                    <span class="bet24-badge is-pendente">
                                        <i class="fas fa-clock"></i> {{ v.getStatusTitle() }}
                                    </span>
                                {% else %}
                                    <span class="bet24-badge is-perdida">
                                        <i class="fas fa-times-circle"></i> {{ v.getStatusTitle() }}
                                    </span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if busca.getTotalPaginas() > 1 %}
                <div class="bet24-paginacao">{{ busca }}</div>
            {% endif %}
        </div>

    {% elseif message is defined and message %}

        <div class="bet24-msg is-aviso">
            <i class="fas fa-exclamation-triangle"></i> {{ message }}
        </div>

    {% else %}

        <div class="empty">
            <div class="empty-state">
                <span class="empty-icon"><i class="fas fa-inbox"></i></span>
                <p class="empty-title">Nenhum depósito registrado</p>
                <p class="empty-text">Assim que você fizer um depósito ele aparece aqui com o valor e a situação.</p>
                <div class="empty-actions">
                    <button type="button" class="empty-button"
                            onclick="$('#modal-deposito-pix').modal('show'); resetPix();">
                        <i class="fas fa-bolt"></i> Depositar agora
                    </button>
                </div>
            </div>
        </div>

    {% endif %}

{% endblock %}

{% block main %}

    {% set gwNome = gatewayPix == 'veopag' ? 'VeoPag' : 'PixUp' %}
    {% set podePix = modoDeposito == 'todos' or modoDeposito == 'pix' %}
    {% set podeManual = modoDeposito == 'todos' or modoDeposito == 'manual' %}

    {# =============================================================
         MODAL: DEPOSITO MANUAL COM COMPROVANTE
         (form .modal.admpage-form - o adminPage usa a propria form)
         ============================================================= #}
    <form id="modal-deposito-manual" class="modal v4-sheet admpage-form" enctype="multipart/form-data"
          aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="dialog-title">Depósito com comprovante</h2>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body bet24-modal-body">
                    <div class="account-form">
                        <div class="account-field">
                            <label class="account-label" for="deposito-manual-valor">Valor do depósito (R$)</label>
                            <div class="deposit-amount">
                                <span class="deposit-currency">R$</span>
                                <input id="deposito-manual-valor" type="text" name="valor"
                                       class="deposit-input mask-valor" placeholder="0,00" required/>
                            </div>
                            {% if depositoMinimo > 0 %}
                                <p class="account-hint">Valor mínimo: R$ {{ depositoMinimo|number_format(2, ',', '.') }}</p>
                            {% endif %}
                        </div>

                        <div class="account-field">
                            <span class="account-label">Comprovante de pagamento</span>
                            {{ inputFile('<i class="fas fa-paperclip"></i> Anexar comprovante', 'upfile', 'pdf,jpg,jpeg,png') }}
                            <p class="account-hint">Formatos aceitos: PDF, JPG e PNG.</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="account-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="account-submit">
                        <i class="fas fa-paper-plane"></i> Enviar depósito
                    </button>
                </div>
            </div>
        </div>
    </form>

    {# =============================================================
         MODAL: DEPOSITO PIX AUTOMATICO
         Os ids (#pix-step-form, #pix-input-valor, #btn-gerar-pix,
         #pix-step-qrcode, #pix-display-valor, #pix-qr-img,
         #pix-copiacola) e os onclick sao os mesmos do template base.
         ============================================================= #}
    <div id="modal-deposito-pix" class="modal v4-sheet" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="dialog-title">Depósito via PIX {{ gwNome }}</h2>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                {# ---------------- Etapa 1: valor ---------------- #}
                <div id="pix-step-form" class="modal-body bet24-modal-body">
                    <p class="bet24-msg is-ok bet24-pix-nota">
                        <i class="fas fa-bolt"></i> Liberação imediata: o saldo entra na sua conta assim que o
                        PIX for pago.
                    </p>

                    <div class="account-field">
                        <label class="account-label" for="pix-input-valor">Valor do depósito (R$)</label>
                        <div class="deposit-amount">
                            <span class="deposit-currency">R$</span>
                            <input id="pix-input-valor" type="text" class="deposit-input mask-valor"
                                   placeholder="0,00" value="20,00" required/>
                        </div>
                        {% if depositoMinimo > 0 %}
                            <p class="account-hint">Valor mínimo: R$ {{ depositoMinimo|number_format(2, ',', '.') }}</p>
                        {% endif %}
                    </div>

                    <div class="deposit-quick">
                        <button type="button" class="deposit-chip" onclick="$('#pix-input-valor').val('10,00');">R$ 10</button>
                        <button type="button" class="deposit-chip" onclick="$('#pix-input-valor').val('20,00');">R$ 20</button>
                        <button type="button" class="deposit-chip" onclick="$('#pix-input-valor').val('50,00');">R$ 50</button>
                        <button type="button" class="deposit-chip" onclick="$('#pix-input-valor').val('100,00');">R$ 100</button>
                        <button type="button" class="deposit-chip" onclick="$('#pix-input-valor').val('200,00');">R$ 200</button>
                    </div>

                    <button type="button" id="btn-gerar-pix" class="account-submit bet24-pix-gerar"
                            onclick="gerarPix();">
                        <i class="fas fa-qrcode"></i> Gerar QR Code PIX
                    </button>

                    <p class="deposit-how">
                        O código PIX é gerado na hora. Pague pelo aplicativo do seu banco e aguarde a
                        confirmação automática nesta tela.
                    </p>
                </div>

                {# ---------------- Etapa 2: QR Code + copia e cola ---------------- #}
                <div id="pix-step-qrcode" class="modal-body bet24-modal-body" style="display: none;">
                    <div class="deposit-summary">
                        <span class="deposit-status">
                            <span class="deposit-dot" aria-hidden="true"></span> Aguardando pagamento
                        </span>
                        <strong class="deposit-value">R$ <span id="pix-display-valor">0,00</span></strong>
                    </div>

                    <div class="bet24-pix-pagamento">
                        <div class="deposit-qr-wrap">
                            <img id="pix-qr-img" class="deposit-qr" src="" alt="QR Code PIX"/>
                        </div>

                        <div class="deposit-code">
                            <label class="account-label" for="pix-copiacola">PIX copia e cola</label>
                            <textarea id="pix-copiacola" class="bet24-pix-textarea" rows="4" readonly></textarea>
                            <button type="button" class="deposit-copy" onclick="copiarPix();">
                                <i class="fas fa-copy"></i> Copiar código PIX
                            </button>
                        </div>
                    </div>

                    <p class="deposit-how">
                        <i class="fas fa-spinner fa-spin"></i> Aguardando a confirmação do pagamento...
                        o saldo será creditado automaticamente.
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# =============================================================
         CONTEUDO DA PAGINA
         ============================================================= #}
    <div class="bet24-page-wide">

        <div class="bet24-page-head">
            <div>
                <h1 class="bet24-page-title">Depósitos</h1>
                <p class="bet24-page-sub">Adicione saldo por PIX instantâneo ou envie o comprovante de uma
                    transferência.</p>
            </div>
            <a class="bet24-voltar" href="{{ url() }}"><i class="fas fa-angle-left"></i> Voltar ao início</a>
        </div>

        <div class="v4-saq-saldo bet24-saldo">
            <span>Saldo disponível</span>
            <b>R$ {{ user.getCredito(true) }}</b>
        </div>

        {% if podePix and not pixConfigurado %}
            <div class="bet24-msg is-aviso">
                <i class="fas fa-exclamation-triangle"></i> O PIX automático ainda não foi configurado pelo
                administrador. Use o depósito com comprovante enquanto isso.
            </div>
        {% endif %}

        {% if podePix or podeManual %}
            <div class="bet24-dep-opcoes">
                {% if podePix %}
                    <button type="button" class="bet24-dep-opcao"
                            onclick="$('#modal-deposito-pix').modal('show'); resetPix();">
                        <span class="bet24-dep-opcao-icone is-pix"><i class="fas fa-bolt"></i></span>
                        <span class="bet24-dep-opcao-texto">
                            <strong>Depósito via PIX {{ gwNome }}</strong>
                            <small>Crédito imediato depois do pagamento</small>
                        </span>
                    </button>
                {% endif %}

                {% if podeManual %}
                    <button type="button" class="bet24-dep-opcao"
                            onclick="$('#modal-deposito-manual').setValues({}).modal('show');">
                        <span class="bet24-dep-opcao-icone"><i class="fas fa-paperclip"></i></span>
                        <span class="bet24-dep-opcao-texto">
                            <strong>Depósito com comprovante</strong>
                            <small>Envie o comprovante e aguarde a aprovação</small>
                        </span>
                    </button>
                {% endif %}
            </div>
        {% else %}
            <div class="bet24-msg is-aviso">
                <i class="fas fa-exclamation-triangle"></i> Nenhuma forma de depósito está disponível no
                momento. Fale com o suporte.
            </div>
        {% endif %}

        <div class="bet24-card">
            <form class="admpage-form-search v4-filtros v4-filtros-2" onsubmit="javascript:return false;">
                <label class="account-field">
                    <span class="account-label">De</span>
                    <input type="date" name="dataInicial" class="account-input"/>
                </label>
                <label class="account-field">
                    <span class="account-label">Até</span>
                    <input type="date" name="dataFinal" class="account-input"/>
                </label>
                <button type="submit" class="account-submit">
                    <i class="fas fa-search"></i> Filtrar
                </button>
            </form>
        </div>

        <div class="admpage-container"></div>

    </div>

{% endblock %}

{% block script %}

    <script>

        /* Lista + formulario de deposito manual (AJAX / adminPage) */
        $(".admpage-form")
            .adminPage({
                formSearch: '.admpage-form-search',
                container: '.admpage-container',
                autoSearch: true,
            });

        var pixPollInterval = null;
        var currentPixToken = null;

        function resetPix() {
            clearInterval(pixPollInterval);
            $('#pix-step-form').show();
            $('#pix-step-qrcode').hide();
            $('#btn-gerar-pix').prop('disabled', false).html('<i class="fas fa-qrcode"></i> Gerar QR Code PIX');
        }

        function gerarPix() {
            var valor = $('#pix-input-valor').val();
            if (!valor) {
                swal('Aviso', 'Digite um valor para o depósito.', 'warning');
                return;
            }

            $('#btn-gerar-pix').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Gerando PIX...');

            $.ajax({
                url: url('financeiro/deposito/pix'),
                type: 'POST',
                data: { valor: valor },
                dataType: 'json',
                success: function (res) {
                    $('#btn-gerar-pix').prop('disabled', false).html('<i class="fas fa-qrcode"></i> Gerar QR Code PIX');

                    if (res.result == 1) {
                        currentPixToken = res.token;
                        $('#pix-display-valor').text(res.valor);
                        $('#pix-copiacola').val(res.qrcode);

                        // Gera imagem do QR Code
                        var qrImgUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=' + encodeURIComponent(res.qrcode);
                        $('#pix-qr-img').attr('src', qrImgUrl);

                        $('#pix-step-form').hide();
                        $('#pix-step-qrcode').show();

                        // Inicia polling de status a cada 3 segundos
                        iniciarPollingPix(res.token);
                    } else {
                        swal('Erro', res.message || 'Não foi possível gerar a cobrança PIX.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#btn-gerar-pix').prop('disabled', false).html('<i class="fas fa-qrcode"></i> Gerar QR Code PIX');
                    var msg = 'Ocorreu um erro ao comunicar com o servidor.';
                    try {
                        var json = JSON.parse(xhr.responseText);
                        if (json && json.message) msg = json.message;
                    } catch (e) {}
                    swal('Erro', msg, 'error');
                }
            });
        }

        function copiarPix() {
            var textarea = document.getElementById('pix-copiacola');
            textarea.select();
            textarea.setSelectionRange(0, 99999);
            try {
                navigator.clipboard.writeText(textarea.value);
            } catch (err) {
                document.execCommand('copy');
            }
            swal('Copiado!', 'Código PIX Copia e Cola copiado com sucesso. Cole no seu aplicativo do banco.', 'success');
        }

        function iniciarPollingPix(token) {
            clearInterval(pixPollInterval);
            pixPollInterval = setInterval(function () {
                if (!token) return;
                $.ajax({
                    url: url('financeiro/deposito/status-pix'),
                    type: 'POST',
                    data: { token: token },
                    dataType: 'json',
                    success: function (res) {
                        if (res.result == 1 && res.aprovado) {
                            clearInterval(pixPollInterval);
                            swal({
                                title: "Depósito Aprovado!",
                                text: "Seu pagamento foi confirmado com sucesso e o saldo já está disponível na sua conta.",
                                type: "success"
                            }, function () {
                                window.location.reload();
                            });
                        }
                    }
                });
            }, 3000);
        }

        /* O tema nao dispara o evento hidden.bs.modal do Bootstrap:
           limpa o polling tambem no botao de fechar / no fundo do modal. */
        $('#modal-deposito-pix').on('hidden.bs.modal', function () {
            clearInterval(pixPollInterval);
        });
        $('#modal-deposito-pix').on('click', '[data-dismiss="modal"]', function () {
            clearInterval(pixPollInterval);
        });

    </script>

{% endblock %}
