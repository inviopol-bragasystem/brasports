{% extends layout %}

{% block list %}

    <div class="container-fluid px-0 pb-3">
        {% if busca.getCount() %}
            <div class="pri-card">
                <div class="card-body p-0">
                    <div class="table-responsive m-0">
                        <table class="table pri-table m-0">
                            <thead>
                            <tr>
                                <th>#</th>
                                <th>Data</th>
                                <th>Cliente/Conta</th>
                                <th>Valor</th>
                                <th>Situação</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for v in busca.getRegistros() %}
                                <tr class="pri-match-row">
                                    <td class="text-center text-warning font-weight-bold">#{{ v.getId() }}</td>
                                    <td class="text-white-50">{{ v.getData(true) }}</td>
                                    {% set user = v.voUser() %}
                                    <td>
                                        <div class="font-weight-bold text-white">{{ user.getNome() }} - {{ user.getLogin() }}</div>
                                        <div class="small text-white-50"><b>AG:</b> {{ v.getAgencia() }} / <b>Conta:</b> {{ v.getConta() }} / <b>Banco:</b> {{ v.getBanco() }}</div>
                                        <div class="small text-white-50"><b>Titular:</b> {{ v.getNomeCompleto() }} / <b>Doc:</b> {{ documento }}</div>
                                    </td>
                                    <td class="text-right font-weight-bold">
                                        <div class="text-danger">{{ fncSinal(v.getValor(), true) }}</div>
                                        <small class="text-white-50">{{ fncSinal(v.getSaldoCreditos(), true) }}</small>
                                    </td>
                                    <td>
                                        <span class="badge badge-warning text-dark p-2">{{ v.getStatusTitle() }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="p-3 bg-dark border-top" style="border-color: var(--pri-border) !important;">{{ busca }}</div>
                </div>
            </div>
        {% elseif message %}
            <div class="alert alert-warning m-0">
                <i class="fa fa-warning"></i> {{ message }}
            </div>
        {% else %}
            <div class="alert alert-warning m-0">
                <i class="fa fa-warning"></i> Nenhum registro encontrado
            </div>
        {% endif %}
    </div>

{% endblock %}

{% block main %}

    {% include 'admin/inc/modal-saque.twig' %}

    <div class="container-fluid px-lg-4 px-3 py-4">
        <div class="pri-page-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom" style="border-color: var(--pri-border) !important;">
                <h3 class="pri-page-title mb-0 border-0 p-0"><i class="fa fa-arrow-up text-danger"></i> Meus Saques</h3>
                <button type="button" onclick="$('.modal-saque').setValues({});" class="pri-btn-bet px-3 py-1 font-weight-bold" style="width: auto; font-size: 13px;">
                    <i class="fa fa-plus-circle"></i> Solicitar Saque
                </button>
            </div>

            <form class="admpage-form-search mb-4" onsubmit="javascript:return false;">
                <div class="row align-items-end">
                    <div class="form-group col-md-5 col-12 mb-3 mb-md-0">
                        <label class="text-white-50 small font-weight-bold">DE:</label>
                        <input type="date" name="dataInicial" class="form-control bg-dark border-secondary text-white"/>
                    </div>
                    <div class="form-group col-md-5 col-12 mb-3 mb-md-0">
                        <label class="text-white-50 small font-weight-bold">ATÉ:</label>
                        <input type="date" name="dataFinal" class="form-control bg-dark border-secondary text-white"/>
                    </div>
                    <div class="col-md-2 col-12">
                        <button class="btn btn-success btn-block font-weight-bold" style="background-color: var(--pri-green); border-color: var(--pri-green);">
                            <i class="fa fa-search"></i> Filtrar
                        </button>
                    </div>
                </div>
            </form>

            <div class="admpage-container"></div>
        </div>
    </div>

{% endblock %}

{% block script %}
    <script>
        $('.modal-saque')
            .adminPage({
                formSearch: '.admpage-form-search',
                container: '.admpage-container',
            });
    </script>
{% endblock %}
