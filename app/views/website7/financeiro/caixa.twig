{% extends layout %}

{% block list %}

    {% if relatorio.result == 1 %}
        <div class="container-fluid px-0">
            <div class="row">
                {% for v in relatorio.results %}
                    <div class="col-md-4 col-12 mb-4">
                        <div class="pri-card p-3 border-left" style="border-left: 4px solid var(--pri-yellow) !important;">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h6 class="text-white-50 text-uppercase small font-weight-bold mb-1">{{ v.label }}</h6>
                                </div>
                                <div class="col-auto">
                                    <h3 class="font-weight-bold text-warning m-0">
                                        <small class="text-white-50">R$</small> {{ v.valor|number_format(2, ',', '.') }}
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="alert alert-warning mb-4">
            <i class="fa fa-warning"></i> {{ relatorio.message }}
        </div>
    {% endif %}

{% endblock %}

{% block main %}

    <div class="container-fluid px-lg-4 px-3 py-4">
        <div class="pri-page-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom" style="border-color: var(--pri-border) !important;">
                <h3 class="pri-page-title mb-0 border-0 p-0"><i class="fa fa-calculator"></i> Controle de Caixa</h3>
                <form class="form-search mt-2 mt-md-0">
                    <div class="form-row align-items-center">
                        <div class="col-auto">
                            <input type="date" name="dataInicial" value="{{ 'now'|date('Y-m-01') }}" required class="form-control form-control-sm bg-dark border-secondary text-white"/>
                        </div>
                        <div class="col-auto">
                            <div class="input-group input-group-sm">
                                <input type="date" name="dataFinal" value="{{ 'now'|date('Y-m-d') }}" required class="form-control bg-dark border-secondary text-white"/>
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-success" style="background-color: var(--pri-green); border-color: var(--pri-green);">
                                        <i class="fa fa-filter"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="admpage-container pt-3"></div>
        </div>
    </div>

{% endblock %}

{% block script %}
    <script>
        $.adminPage({
            autoSearch: false,
            formSearch: '.form-search',
            container: '.admpage-container',
        });
        $('.form-search').submit();
    </script>
{% endblock %}
