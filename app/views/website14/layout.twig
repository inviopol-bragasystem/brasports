<!-- ========================================================
     MODAL DE LOGIN (1:1 TOPSPORTSBET DESIGN)
     ======================================================== -->
<div id="modal-login" class="modal fade in lnv-auth" tabindex="-1" role="dialog" v-pre>
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content">
            <div class="lnv-auth__top">
                <img src="{{ logoUrl }}" alt="" class="lnv-auth__logo">
                <button type="button" data-dismiss="modal" aria-label="Fechar" class="lnv-auth__close">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <div class="lnv-auth__body">
                <h4 class="lnv-auth__title">Bem-vindo de volta</h4>
                <p class="lnv-auth__sub">Entre com seu e-mail e senha para continuar.</p>

                <!-- Box de Erro -->
                <div id="login-error-box" class="alert alert-danger py-2 text-center small font-weight-bold" style="display:none;"></div>

                <form id="form-login-topsports" method="post" action="javascript:;" onsubmit="return handleTopsportsLogin(event, this);">
                    <div class="lnv-auth__field">
                        <span class="lnv-auth__label">E-mail ou Usuário</span>
                        <div class="lnv-auth__control">
                            <i class="fa fa-envelope lnv-auth__icon"></i>
                            <input type="text" name="username" placeholder="seu@email.com ou usuário" required class="form-control" style="background:#252525;color:#fff;border:1px solid rgba(255,255,255,0.1);height:44px;padding-left:38px;">
                        </div>
                    </div>
                    <div class="lnv-auth__field mt-3">
                        <span class="lnv-auth__label">Senha</span>
                        <div class="lnv-auth__control" style="position:relative;">
                            <i class="fa fa-lock lnv-auth__icon"></i>
                            <input type="password" id="login-pwd-input" name="password" placeholder="Sua senha" required class="form-control" style="background:#252525;color:#fff;border:1px solid rgba(255,255,255,0.1);height:44px;padding-left:38px;padding-right:38px;">
                            <button type="button" class="lnv-auth__eye" onclick="var p = document.getElementById('login-pwd-input'); p.type = (p.type === 'password' ? 'text' : 'password');" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:rgba(255,255,255,0.5);">
                                <i class="fa fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button id="btn-submit-login-top" type="submit" class="lnv-auth__submit mt-4 w-100" style="height:46px;background:var(--secondary-color, #00e054);color:#000;font-weight:800;border:none;border-radius:6px;">
                        Logar
                    </button>
                </form>

                {% if dados.getExibirRegistro() %}
                <div class="text-center mt-3 text-sm text-white-50">
                    Não tem uma conta? <a href="{{ dados.getLinkCadastro()|default(url('cadastrar')) }}" class="text-success font-weight-bold">Cadastre-se</a>
                </div>
                {% endif %}
            </div>
            <div class="lnv-auth__foot">
                <i class="fa fa-shield-halved"></i>
                <span>Ambiente 100% protegido e criptografado</span>
            </div>
        </div>
    </div>
</div>

