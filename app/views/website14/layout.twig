<script>
    // Fechar drawer mobile ao clicar no fundo escuro
    $(document).on('click', '.lnv-left.mobile-nav', function(e) {
        if ($(e.target).hasClass('mobile-nav')) {
            $(this).removeClass('mobile-nav');
        }
    });

    // Submissão AJAX do Formulário de Login (Evita redirecionamento nativo e tela preta JSON)
    function handleTopsportsLogin(e, form) {
        if (e && e.preventDefault) e.preventDefault();
        var $form = $(form);
        var $btn = $('#btn-submit-login-top');
        var $errBox = $('#login-error-box');

        $errBox.hide().text('');
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Entrando...');

        $.ajax({
            url: '{{ url("entrar/login/insert") }}',
            type: 'POST',
            data: $form.serialize(),
            dataType: 'json',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function(res) {
                $btn.prop('disabled', false).text('Logar');
                if (res && res.result == 1) {
                    window.location.href = res.url || '{{ url() }}';
                } else {
                    var msg = (res && res.message) ? res.message : 'Login inválido.';
                    $errBox.show().text(msg);
                    if (typeof swal === 'function') {
                        swal('Atenção', msg, 'error');
                    }
                }
            },
            error: function(xhr) {
                $btn.prop('disabled', false).text('Logar');
                var msg = 'Erro ao processar login. Tente novamente.';
                try {
                    var json = JSON.parse(xhr.responseText);
                    if (json && json.message) msg = json.message;
                } catch(err) {}
                $errBox.show().text(msg);
                if (typeof swal === 'function') {
                    swal('Erro', msg, 'error');
                }
            }
        });

        return false;
    }
</script>

