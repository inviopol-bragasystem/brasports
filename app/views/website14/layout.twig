<!doctype html>
<html lang="pt-BR">
<head>
    {{ seo_header() }}

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, maximum-scale=1, user-scalable=no">
    <meta name="theme-color" content="#080507"/>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Rubik:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Source+Sans+Pro:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
    <link rel="stylesheet" href="node_modules/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="css/loading.css"/>
    <link rel="stylesheet" href="css/sweetalert2.min.css"/>
    <link rel="stylesheet" href="css/topsportsbet/topsportsbet.css?v=1.0.0"/>

    <style>
        [v-cloak] { display: none !important; }
        body {
            background-color: var(--background-color, #3e3e3e) !important;
            color: #ffffff !important;
            font-family: var(--font-family-sans-serif, 'Source Sans Pro', 'Rubik', sans-serif) !important;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Ajustes específicos do layout TopSportsBet */
        .lnv-header {
            position: sticky;
            top: 0;
            z-index: 1020;
            background: var(--primary-site-color, #080507);
        }
        .lnv-topbar {
            height: 56px;
            background: var(--primary-site-color, #080507);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            display: flex;
            align-items: center;
        }
        .lnv-topbar__inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            padding: 0 16px;
        }
        .lnv-burger {
            background: transparent;
            border: none;
            color: #ffffff;
            font-size: 20px;
            padding: 6px 10px;
            cursor: pointer;
            display: none;
        }
        @media (max-width: 1180px) {
            .lnv-burger {
                display: inline-flex !important;
                align-items: center;
                justify-content: center;
            }
        }
        .lnv-logo img {
            max-height: 42px;
            width: auto;
            object-fit: contain;
        }
        .lnv-mainnav {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-left: 24px;
        }
        .lnv-mainnav a {
            color: rgba(255, 255, 255, 0.75);
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.15s;
            position: relative;
            padding: 6px 0;
        }
        .lnv-mainnav a:hover, .lnv-mainnav a.is-active {
            color: #ffffff;
        }
        .lnv-mainnav a.is-active::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -6px;
            height: 3px;
            background: var(--secondary-color, #00e054);
            border-radius: 2px;
        }
        @media (max-width: 991px) {
            .lnv-mainnav {
                display: none !important;
            }
        }
        .lnv-account {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .lnv-btn {
            height: 36px;
            padding: 0 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            cursor: pointer;
            text-decoration: none !important;
            transition: all 0.2s;
            border: 1px solid transparent;
        }
        .lnv-btn--outline {
            background: transparent;
            border-color: rgba(255, 255, 255, 0.3);
            color: #ffffff;
        }
        .lnv-btn--outline:hover {
            border-color: #ffffff;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
        }
        .lnv-btn--primary {
            background: var(--secondary-color, #00e054);
            color: #000000;
        }
        .lnv-btn--primary:hover {
            background: #00ff5f;
            color: #000000;
        }

        /* Modalidades / Sportbar */
        .lnv-sportbar {
            background: var(--modalities-color, #1E1E1E);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            height: 52px;
            display: flex;
            align-items: center;
        }
        .lnv-sportbar__frame {
            max-width: 1600px;
            width: 100%;
            margin: 0 auto;
            padding: 0 16px;
            overflow: hidden;
            position: relative;
        }
        .lnv-sportbar__inner {
            display: flex;
            align-items: center;
            gap: 6px;
            overflow-x: auto;
            scroll-behavior: smooth;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .lnv-sportbar__inner::-webkit-scrollbar {
            display: none;
        }
        .lnv-sport {
            display: flex;
            align-items: center;
            gap: 8px;
            height: 40px;
            padding: 0 14px;
            border-radius: 6px;
            color: rgba(255, 255, 255, 0.7);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            text-decoration: none !important;
            white-space: nowrap;
            transition: all 0.15s;
        }
        .lnv-sport:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
        }
        .lnv-sport.is-active {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.12);
        }
        .lnv-sport__icon img {
            width: 18px;
            height: 18px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }
        .lnv-sport--live {
            color: #ff4757 !important;
        }
        .lnv-sport--live .lnv-sport__icon img {
            filter: none !important;
        }

        /* Estrutura Principal 3 Colunas */
        .lnv-body {
            max-width: 1600px;
            width: 100%;
            margin: 0 auto;
            padding: 16px 16px 24px;
            display: grid;
            grid-template-columns: 270px minmax(0, 1fr) 340px;
            gap: 16px;
            align-items: start;
        }
        @media (max-width: 1360px) {
            .lnv-body {
            max-width: 1600px;
            width: 100%;
            margin: 0 auto;
            padding: 16px 16px 24px;
            display: grid;
            grid-template-columns: 270px minmax(0, 1fr) 340px;
            gap: 16px;
            align-items: start;
        }
        }
        @media (max-width: 1180px) {
            .lnv-body {
            max-width: 1600px;
            width: 100%;
            margin: 0 auto;
            padding: 16px 16px 24px;
            display: grid;
            grid-template-columns: 270px minmax(0, 1fr) 340px;
            gap: 16px;
            align-items: start;
        }
            .lnv-left {
            width: 270px;
            display: block;
        }
        }
        @media (max-width: 991px) {
            .lnv-body {
            max-width: 1600px;
            width: 100%;
            margin: 0 auto;
            padding: 16px 16px 24px;
            display: grid;
            grid-template-columns: 270px minmax(0, 1fr) 340px;
            gap: 16px;
            align-items: start;
        }
            .lnv-right {
                display: none !important;
            }
        }

        /* Gaveta Mobile (.mobile-nav) */
        .lnv-left.mobile-nav {
            display: block !important;
            position: fixed !important;
            inset: 0;
            width: 100vw !important;
            height: 100vh !important;
            z-index: 1040 !important;
            padding: 0;
            background: rgba(0, 0, 0, 0.65) !important;
            backdrop-filter: blur(2px);
        }
        .lnv-left.mobile-nav .lnv-left__inner {
            color: #ffffff;
            width: 84vw;
            max-width: 320px;
            height: 100%;
            overflow-y: auto;
            padding: 0 12px 90px;
            background: #2b2b2b;
            box-shadow: 10px 0 30px rgba(0,0,0,0.8);
        }
        .lnv-left.mobile-nav .lnv-drawer-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 2;
            margin: 0 -12px 12px;
            padding: 12px 16px;
            background: var(--primary-site-color, #080507);
            color: #ffffff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .lnv-left:not(.mobile-nav) .lnv-drawer-head {
            display: none;
        }

        /* Ações Rápidas de Depósito / Saque na Sidebar */
        .lnv-quick-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 12px;
        }
        .lnv-action-btn {
            height: 40px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-decoration: none !important;
            color: #ffffff;
            transition: transform 0.15s;
        }
        .lnv-action-btn:active {
            transform: scale(0.97);
        }
        .lnv-action-btn--deposito {
            background: linear-gradient(135deg, #00e054 0%, #00a83e 100%);
            color: #000000 !important;
        }
        .lnv-action-btn--saque {
            background: linear-gradient(135deg, #3063BA 0%, #1e4585 100%);
            color: #ffffff !important;
        }
    
        .lnv-center {
            display: flex;
            flex-direction: column;
            gap: 14px;
            min-width: 0;
            width: 100%;
        }
        .lnv-right {
            display: flex;
            flex-direction: column;
            gap: 14px;
            width: 340px;
        }

    </style>

    {% block head %}{% endblock %}

    {{ dados.getHtmlHead()|raw }}
    {% include 'website/inc/personalizacao-css.twig' %}
</head>
<body class="font-sans">
<div id="website">

{% set userLogged = user() %}

{# Logo oficial do tema TopSportsBet #}
{% set logoUrl = 'cdn/topsportsbet/logo.png' %}

<div class="lnv">

    <!-- ========================================================
         HEADER 1:1 TOPSPORTSBET
         ======================================================== -->
    <header class="lnv-header" v-pre>
        <!-- Topbar Oficial -->
        <div class="lnv-topbar">
            <div class="lnv-wrap lnv-topbar__inner">
                <!-- Burger Button (Mobile) -->
                <button type="button" aria-label="Abrir menu" class="lnv-burger" onclick="$('.lnv-left').toggleClass('mobile-nav');">
                    <i class="fa fa-bars"></i>
                </button>

                <!-- Logo Oficial -->
                <a href="{{ url('apostar') }}" class="lnv-logo">
                    <img src="{{ logoUrl }}" alt="{{ dados.getBanca()|default('TOP SPORTS BET') }}">
                </a>

                <!-- Navegação Principal Desktop -->
                <nav class="lnv-mainnav">
                    <a href="{{ url('apostar') }}" class="{% if activeNav == 'apostar' or not activeNav %}is-active{% endif %}">Esportes</a>
                    <a href="{{ url('apostar') }}?ao_vivo=1">Ao Vivo</a>
                    {% if dados.getExibirCassino() %}
                        <a href="{{ url('cassino') }}">Cassino</a>
                    {% endif %}
                    <a href="{{ url('regras') }}">Regras</a>
                </nav>

                <!-- Área da Conta do Usuário -->
                <div class="lnv-account">
                    {% if not userLogged %}
                        {% if dados.getExibirLogin() %}
                            <button type="button" class="lnv-btn lnv-btn--outline" onclick="$('#modal-login').modal('show');">
                                <i class="fa fa-sign-in mr-1"></i> Entrar
                            </button>
                        {% endif %}
                        {% if dados.getExibirRegistro() %}
                            <a href="{{ dados.getLinkCadastro()|default(url('cadastrar')) }}" class="lnv-btn lnv-btn--primary lnv-btn--cadastrar">
                                <i class="fa fa-user-plus mr-1"></i> Cadastre-se
                            </a>
                        {% endif %}
                    {% else %}
                        <div class="user-balance-pill">
                            <span class="text-white/60 text-[11px]">Saldo:</span>
                            <strong class="text-emerald-400 font-bold">R$ {{ userLogged.getCredito(true) }}</strong>
                        </div>
                        <a href="{{ url('financeiro/deposito') }}" class="lnv-btn lnv-btn--primary py-1 px-2.5 text-xs">
                            <i class="fa fa-plus-circle"></i> Depósito
                        </a>
                        <div class="dropdown d-inline-block">
                            <button class="lnv-btn lnv-btn--outline p-1.5 rounded-full" type="button" id="userMenuBtn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="width:36px;height:36px;border-radius:50%;">
                                <i class="fa fa-user"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right shadow-lg border-0" aria-labelledby="userMenuBtn" style="background:#2b2b2b;border:1px solid rgba(255,255,255,0.1);border-radius:10px;min-width:220px;padding:8px 0;z-index:1050;">
                                <div class="px-3 py-2 border-bottom" style="border-color:rgba(255,255,255,0.08)!important;">
                                    <div class="font-weight-bold text-white text-truncate">{{ userLogged.getNome() }}</div>
                                    <small class="text-success font-weight-bold">R$ {{ userLogged.getCredito(true) }}</small>
                                </div>
                                <a class="dropdown-item py-2 text-white" href="{{ url('financeiro/deposito') }}"><i class="fa fa-plus-circle mr-2 text-success"></i> Depositar (PIX)</a>
                                <a class="dropdown-item py-2 text-white" href="{{ url('financeiro/saque') }}"><i class="fa fa-arrow-up mr-2 text-danger"></i> Solicitar Saque</a>
                                <a class="dropdown-item py-2 text-white" href="{{ url('apostas') }}"><i class="fa fa-ticket mr-2 text-warning"></i> Minhas Apostas</a>
                                <a class="dropdown-item py-2 text-white" href="{{ url('financeiro/extrato') }}"><i class="fa fa-history mr-2 text-info"></i> Extrato</a>
                                <a class="dropdown-item py-2 text-white" href="{{ url('perfil') }}"><i class="fa fa-user mr-2 text-primary"></i> Meu Perfil</a>
                                <div class="dropdown-divider my-1" style="border-color:rgba(255,255,255,0.08);"></div>
                                <a class="dropdown-item py-2 text-danger font-weight-bold" href="{{ url('logout') }}"><i class="fa fa-sign-out mr-2"></i> Sair</a>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Sportbar Oficial (Modalidades com Ícones SVG) -->
        <div class="lnv-sportbar">
            <div class="lnv-wrap lnv-sportbar__frame">
                <div class="lnv-sportbar__inner">
                    <a href="{{ url('apostar') }}?ao_vivo=1" class="lnv-sport lnv-sport--live">
                        <span class="lnv-sport__icon"><img src="cdn/topsportsbet/live.svg" alt=""></span>
                        <span class="lnv-sport__name">Ao Vivo</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-sport is-active">
                        <span class="lnv-sport__icon"><img src="cdn/topsportsbet/futebol.svg" alt=""></span>
                        <span class="lnv-sport__name">FUTEBOL</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-sport">
                        <span class="lnv-sport__icon"><img src="cdn/topsportsbet/basquete.svg" alt=""></span>
                        <span class="lnv-sport__name">BASQUETE</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-sport">
                        <span class="lnv-sport__icon"><img src="cdn/topsportsbet/luta.svg" alt=""></span>
                        <span class="lnv-sport__name">LUTAS</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-sport">
                        <span class="lnv-sport__icon"><img src="cdn/topsportsbet/desafio.svg" alt=""></span>
                        <span class="lnv-sport__name">DESAFIO</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-sport">
                        <span class="lnv-sport__icon"><img src="cdn/topsportsbet/futsal.svg" alt=""></span>
                        <span class="lnv-sport__name">FUTSAL</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-sport">
                        <span class="lnv-sport__icon"><img src="cdn/topsportsbet/151.svg" alt=""></span>
                        <span class="lnv-sport__name">E-SPORTS</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-sport">
                        <span class="lnv-sport__icon"><img src="cdn/topsportsbet/bingo.svg" alt=""></span>
                        <span class="lnv-sport__name">SINUCA</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- ========================================================
         CORPO PRINCIPAL 3 COLUNAS 1:1 TOPSPORTSBET
         ======================================================== -->
    <div class="lnv-body lnv-wrap">

        <!-- COLUNA ESQUERDA (SIDEBAR 270px) -->
        <aside class="lnv-left" v-pre>
            <div class="lnv-left__inner">
                <!-- Cabeçalho do Drawer Mobile -->
                <div class="lnv-drawer-head">
                    <img src="{{ logoUrl }}" alt="" style="max-height: 32px;">
                    <button type="button" aria-label="Fechar menu" class="btn text-white p-0" onclick="$('.lnv-left').removeClass('mobile-nav');">
                        <i class="fa fa-times fa-lg"></i>
                    </button>
                </div>

                <!-- Botões Laterais Rápidos: DEPÓSITO e SAQUE (Visível apenas se logado) -->
                {% if userLogged %}
                <div class="lnv-quick-actions">
                    <a href="{{ url('financeiro/deposito') }}" class="lnv-action-btn lnv-action-btn--deposito">
                        <i class="fa fa-qrcode"></i> Depósito
                    </a>
                    <a href="{{ url('financeiro/saque') }}" class="lnv-action-btn lnv-action-btn--saque">
                        <i class="fa fa-money"></i> Saque
                    </a>
                </div>
                {% endif %}

                <!-- Card de Conferir Bilhete Rápido -->
                <div class="lnv-card lnv-check mb-2">
                    <form class="lnv-check__form" action="{{ url('bilhete') }}" method="get">
                        <input type="text" name="codigo" placeholder="Conferir bilhete" aria-label="Código do bilhete">
                        <button type="submit" aria-label="Conferir bilhete"><i class="fa fa-search"></i></button>
                    </form>
                </div>

                <!-- Link Regulamento 1:1 Topsportsbet -->
                <a href="javascript:void(0)" onclick="$('#modal-regulamento').modal('show')" class="lnv-card d-flex align-items-center gap-2 px-3 py-2 text-white font-weight-bold mb-3" style="background:#2b2b2b;border:1px solid rgba(255,255,255,0.06);border-radius:6px;font-size:13px;text-decoration:none;">
                    <i class="fa fa-balance-scale mr-2" style="font-size:14px;color:rgba(255,255,255,0.7);"></i>
                    <span>Regulamento</span>
                </a>

                <!-- Ligas Principais -->
                <div class="lnv-card lnv-menu mb-3">
                    <div class="lnv-card__band">Ligas principais</div>
                    <a href="{{ url('apostar') }}?busca=Brasil" class="lnv-menu__item">
                        <i class="fa fa-soccer-ball-o lnv-menu__ico" style="font-size:14px;color:#ffbe00;"></i>
                        <span>Brasil - Série A</span>
                    </a>
                    <a href="{{ url('apostar') }}?busca=Brasil" class="lnv-menu__item">
                        <i class="fa fa-soccer-ball-o lnv-menu__ico" style="font-size:14px;color:#ffbe00;"></i>
                        <span>Brasil - Série B</span>
                    </a>
                    <a href="{{ url('apostar') }}?busca=Colômbia" class="lnv-menu__item">
                        <i class="fa fa-soccer-ball-o lnv-menu__ico" style="font-size:14px;color:#ffbe00;"></i>
                        <span>Colômbia - Primera A</span>
                    </a>
                    <a href="{{ url('apostar') }}?busca=Costa" class="lnv-menu__item">
                        <i class="fa fa-soccer-ball-o lnv-menu__ico" style="font-size:14px;color:#ffbe00;"></i>
                        <span>Costa Rica - Primera División</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-menu__item">
                        <i class="fa fa-soccer-ball-o lnv-menu__ico" style="font-size:14px;color:#ffbe00;"></i>
                        <span>Islândia - Premier League</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-menu__item">
                        <i class="fa fa-soccer-ball-o lnv-menu__ico" style="font-size:14px;color:#ffbe00;"></i>
                        <span>Taça de Portugal</span>
                    </a>
                    <a href="{{ url('apostar') }}" class="lnv-menu__item">
                        <i class="fa fa-soccer-ball-o lnv-menu__ico" style="font-size:14px;color:#ffbe00;"></i>
                        <span>UEFA - Liga Conferência</span>
                    </a>
                </div>

                <!-- Todos os Países -->
                <div class="lnv-card lnv-menu">
                    <div class="lnv-card__band">Todos os países</div>
                    <div class="lnv-paises-list">
                        <div class="lnv-pais-row d-flex align-items-center justify-content-between px-3 py-2 border-bottom" style="border-color:rgba(255,255,255,0.05)!important;font-size:13px;cursor:pointer;">
                            <span class="d-flex align-items-center gap-2">
                                <img src="cdn/topsportsbet/ar.png" style="width:18px;height:14px;object-fit:cover;border-radius:2px;margin-right:8px;" alt=""> Argentina
                            </span>
                            <span class="badge badge-dark" style="background:#1e1e1e;color:rgba(255,255,255,0.7);font-size:11px;">2 <i class="fa fa-chevron-down ml-1" style="font-size:9px;"></i></span>
                        </div>
                        <div class="lnv-pais-row d-flex align-items-center justify-content-between px-3 py-2 border-bottom" style="border-color:rgba(255,255,255,0.05)!important;font-size:13px;cursor:pointer;">
                            <span class="d-flex align-items-center gap-2">
                                <img src="cdn/topsportsbet/br.png" style="width:18px;height:14px;object-fit:cover;border-radius:2px;margin-right:8px;" alt=""> Brasil
                            </span>
                            <span class="badge badge-dark" style="background:#1e1e1e;color:rgba(255,255,255,0.7);font-size:11px;">2 <i class="fa fa-chevron-down ml-1" style="font-size:9px;"></i></span>
                        </div>
                        <div class="lnv-pais-row d-flex align-items-center justify-content-between px-3 py-2 border-bottom" style="border-color:rgba(255,255,255,0.05)!important;font-size:13px;cursor:pointer;">
                            <span class="d-flex align-items-center gap-2">
                                <img src="cdn/topsportsbet/co.png" style="width:18px;height:14px;object-fit:cover;border-radius:2px;margin-right:8px;" alt=""> Colômbia
                            </span>
