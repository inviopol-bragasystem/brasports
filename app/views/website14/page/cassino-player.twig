<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{ game.name }} - 99Play Cassino</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --theme-bg: #0a1122;
            --theme-card-2: #111a2f;
            --theme-card-border: rgba(255, 255, 255, 0.08);
            --theme-primary: #3d8bfd;
            --theme-accent: #00e054;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }
        html, body {
            height: 100%;
            width: 100%;
            overflow: hidden;
            background: #000;
            color: #fff;
        }
        .player-wrapper {
            display: flex;
            flex-direction: column;
            height: 100vh;
            width: 100vw;
            background: #000;
        }
        .player-header {
            height: 52px;
            background: #0d1528;
            border-bottom: 1px solid var(--theme-card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            z-index: 10;
        }
        .player-header a.btn-voltar {
            color: #fff;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            font-size: 13px;
            background: rgba(255, 255, 255, 0.06);
            padding: 6px 14px;
            border-radius: 9999px;
            border: 1px solid var(--theme-card-border);
            transition: all 0.2s;
        }
        .player-header a.btn-voltar:hover {
            background: rgba(255, 255, 255, 0.12);
            color: var(--theme-primary);
        }
        .player-header .game-info {
            font-size: 14px;
            font-weight: 700;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .player-header .user-info {
            font-size: 13px;
            color: #8a9bbf;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .player-header .user-info strong {
            color: var(--theme-accent);
        }
        .player-iframe-container {
            flex: 1;
            position: relative;
            width: 100%;
            height: calc(100vh - 52px);
        }
        iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>
    <div class="player-wrapper">
        <header class="player-header">
            <a href="{{ url('cassino') }}" class="btn-voltar">
                <i class="fa fa-arrow-left"></i> Voltar ao Cassino
            </a>
            <div class="game-info">
                <i class="fa fa-gamepad" style="color:var(--theme-primary);"></i> {{ game.name }}
            </div>
            <div class="user-info">
                {% if user %}
                    Saldo: <strong>R$ {{ user.getCredito(true) }}</strong>
                {% else %}
                    <span style="color:#ffa502;font-size:12px;font-weight:700;">Modo Demonstração</span>
                {% endif %}
                <button type="button" onclick="location.reload();" title="Recarregar Jogo" style="background:transparent;border:none;color:#8a9bbf;cursor:pointer;font-size:14px;margin-left:6px;">
                    <i class="fa fa-refresh"></i>
                </button>
            </div>
        </header>
        <main class="player-iframe-container">
            {% if errorMessage %}
                <div style="position: absolute; inset: 0; background: #0a1122; display: flex; align-items: center; justify-content: center; flex-direction: column; z-index: 60; padding: 24px; text-align: center;">
                    <i class="fa fa-exclamation-triangle fa-3x" style="color: #ff4757; margin-bottom: 16px;"></i>
                    <h3 style="color: #fff; margin-bottom: 10px; font-weight: 700;">Não foi possível carregar o jogo</h3>
                    <p style="color: #8a9bbf; max-width: 480px; margin-bottom: 24px; font-size: 14px;">{{ errorMessage }}</p>
                    <div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
                        <a href="{{ url('cassino') }}" class="btn-voltar" style="background: var(--theme-primary); color: #fff; text-decoration: none; padding: 10px 22px; border-radius: 9999px; font-weight: 700; border: none;">
                            <i class="fa fa-arrow-left"></i> Voltar ao Cassino
                        </a>
                        <button type="button" onclick="window.location.reload();" style="background: #18223b; color: #fff; padding: 10px 22px; border-radius: 9999px; font-weight: 700; border: 1px solid var(--theme-card-border); cursor: pointer;">
                            <i class="fa fa-refresh"></i> Tentar Novamente
                        </button>
                    </div>
                </div>
            {% else %}
                <iframe src="{{ launchUrl }}" allowfullscreen></iframe>
            {% endif %}
        </main>
    </div>
</body>
</html>

