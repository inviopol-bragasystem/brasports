<!doctype html>
<html lang="pt-br">
<head>
    {{ seo_header() }}

    <link rel="stylesheet" href="css/bootstrap4.css"/>
    <link rel="stylesheet" href="css/darkmodern.css?v=3.1.0"/>
    <link rel="stylesheet" href="css/loading.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>

    {% block head %}{% endblock %}

    {{ dados.getHtmlHead()|raw }}
    {% include 'website/inc/personalizacao-css.twig' %}
</head>
<body>

{% set hoje = 'now'|date('Y-m-d') %}
{% set amanha = '+1day'|date('Y-m-d') %}

<!-- Modal de Login Estilo Leon Bet -->
<form id="modal-login" class="modal fade" method="post">
    <div class="modal-dialog modal-sm">
        <div class="modal-content" style="background-color: var(--leon-header); border: 1px solid var(--leon-border); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.8);">
            <div class="modal-header" style="border-bottom: 1px solid var(--leon-border); padding: 16px 20px;">
                <h5 class="modal-title font-weight-bold text-white d-flex align-items-center" style="font-size: 16px;">
                    <i class="fa fa-lock text-success mr-2" style="color: var(--leon-green) !important;"></i> Acessar Conta
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" style="opacity: 0.7;">&times;</button>
            </div>
            <div class="modal-body p-4">
                <div class="form-group mb-3">
                    <label class="small font-weight-bold" style="color: var(--leon-text-muted); letter-spacing: 0.5px;">USUÁRIO OU E-MAIL</label>
                    <input type="text" name="username" class="form-control" style="background: var(--leon-inner); border-color: var(--leon-border); color: #fff; border-radius: 6px; font-weight: 500;" placeholder="Digite seu usuário" required/>
                </div>
                <div class="form-group mb-4">
                    <label class="small font-weight-bold" style="color: var(--leon-text-muted); letter-spacing: 0.5px;">SENHA</label>
                    <input type="password" name="password" class="form-control" style="background: var(--leon-inner); border-color: var(--leon-border); color: #fff; border-radius: 6px; font-weight: 500;" placeholder="Digite sua senha" required minlength="5" maxlength="20"/>
                </div>
                <button type="submit" class="leon-btn-cadastre w-100 py-2" style="font-size: 14px;">
                    <i class="fa fa-sign-in mr-1"></i> Entrar
                </button>
                {% if dados.getExibirRegistro() %}
                    <div class="text-center mt-3">
                        <a href="{{ dados.getLinkCadastro()|default(url('cadastrar')) }}" class="btn btn-link btn-sm" style="color: var(--leon-text-sub);">
                            Não tem conta? <span style="color: var(--leon-green); font-weight: 700;">Cadastre-se</span>
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</form>

<div id="website" {% if pageAposta %}v-cloak{% endif %}>

    <!-- ============================================================
         HEADER OFICIAL LEON BET (1:1 com leon824.bet)
         ============================================================ -->
    <header class="leon-header">
        <div class="leon-header-top">
            
            <!-- Esquerda: Hamburger Mobile + Logo Oficial LEON -->
            <div class="leon-header-left">
                <!-- Hamburger Menu Lateral (Desktop & Mobile) -->
                <button type="button" class="leon-burger-btn" onclick="$('html').toggleClass('show-menu');" aria-label="Menu" title="Menu lateral">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="4" y="16" width="10" height="2" rx="1" fill="#cfd4d8"/>
                        <rect x="4" y="11" width="16" height="2" rx="1" fill="#cfd4d8"/>
                        <rect x="4" y="6" width="13" height="2" rx="1" fill="#cfd4d8"/>
                    </svg>
                </button>

                <!-- Logo da Banca -->
                <a href="{{ url() }}" class="leon-logo-wrap" title="{{ dados.getBanca() }}">
                    {% if dados.imgCapa(true, 'logo').getSource() %}
                        <img src="{{ dados.imgCapa(true, 'logo').getSource(true) }}" alt="{{ dados.getBanca() }}" style="height: 28px; max-width: 150px; object-fit: contain;"/>
                    {% else %}
                        <span style="font-size: 20px; font-weight: 800; color: #fff; letter-spacing: -0.5px; text-transform: uppercase;">
                            {{ dados.getBanca()|default('BRASILBET') }}
                        </span>
                    {% endif %}
                </a>

                <!-- Navegação Superior Desktop -->
                <ul class="leon-top-tabs d-none d-lg-flex">
                    <li class="{% if controller == 'index' or controller == 'apostar' %}active{% endif %}"><a href="{{ url() }}">Início</a></li>
                    <li><a href="javascript:;" onclick="$('#dpSearchInput').focus();">Ao Vivo</a></li>
                    <li><a href="{{ url() }}">Esportes</a></li>
                    {% if dados.getExibirCassino() %}
                    <li class="{% if controller == 'cassino' %}active{% endif %}">
                        <a href="{{ url('cassino') }}"><i class="fa fa-gamepad" style="color: #ffb703; margin-right: 4px;"></i> Cassino</a>
                    </li>
                    {% endif %}
                    <li><a href="javascript:;">E-Sports</a></li>
                </ul>
            </div>

            <!-- Direita: Busca + Botões Entrar & Cadastre-se -->
            <div class="leon-header-right">
                <button type="button" class="leon-search-icon-btn d-none d-md-block" onclick="$('.leon-search-row').slideToggle();" title="Buscar">
                    <i class="fa fa-search"></i>
                </button>

                {% if not user %}
                    {% if dados.getExibirLogin() %}
                        <button type="button" class="leon-btn-entrar" data-toggle="modal" data-target="#modal-login">
                            Entrar
                        </button>
                    {% endif %}

                    {% if dados.getExibirRegistro() %}
                        <a href="{{ dados.getLinkCadastro()|default(url('cadastrar')) }}" class="leon-btn-cadastre">
                            Cadastre-se
                        </a>
                    {% endif %}
                {% else %}
                    <!-- Usuário Logado -->
                    <div class="dropdown">
                        <a href="javascript:;" class="leon-user-balance-badge dropdown-toggle text-decoration-none" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fa fa-wallet" style="color: var(--leon-green);"></i>
                            <span class="val">R$ {{ user.getCredito(true) }}</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right" style="background-color: var(--leon-header); border: 1px solid var(--leon-border); border-radius: 8px;">
                            <a class="dropdown-item text-white" href="{{ url("financeiro/extrato") }}"><i class="fa fa-list-alt mr-2 text-muted"></i> Extrato</a>
                            <a class="dropdown-item text-white" href="{{ url("financeiro/caixa") }}"><i class="fa fa-calculator mr-2 text-muted"></i> Caixa</a>
                            <a class="dropdown-item text-white" href="{{ url("financeiro/deposito") }}"><i class="fa fa-arrow-down mr-2" style="color: var(--leon-green);"></i> Depósito</a>
                            <a class="dropdown-item text-white" href="{{ url("financeiro/saque") }}"><i class="fa fa-arrow-up mr-2 text-danger"></i> Saque</a>
                            <div class="dropdown-divider" style="border-color: var(--leon-border);"></div>
                            <a class="dropdown-item text-white" href="{{ url('apostas') }}"><i class="fa fa-history mr-2 text-muted"></i> Minhas Apostas</a>
                            <a class="dropdown-item text-white" href="{{ url('perfil') }}"><i class="fa fa-user mr-2 text-muted"></i> Perfil</a>
                            <div class="dropdown-divider" style="border-color: var(--leon-border);"></div>
                            <a class="dropdown-item text-danger" href="{{ url('logout') }}"><i class="fa fa-sign-out mr-2"></i> Sair</a>
                        </div>
                    </div>
                {% endif %}
            </div>

        </div>
    </header>

    <!-- Conteúdo Dinâmico -->
    <main id="main">
        {% block main %}{% endblock %}
    </main>

    <!-- ============================================================
         FOOTER OFICIAL LEON BET
         ============================================================ -->
    <footer class="leon-footer">
        <div class="leon-footer-wrap">
            <div class="leon-footer-links">
                <a href="{{ url('termos-uso') }}">Termos de Uso</a>
                {% if dados.getExibirRegras() %}<a href="{{ url('regras') }}">Regras de Apostas</a>{% endif %}
                {% if dados.getExibirCotacoes() %}<a href="{{ url('cotacoes') }}">Tabela de Cotações</a>{% endif %}
                {% if dados.getExibirBilhete() %}<a href="{{ url('bilhete') }}">Consultar Bilhete</a>{% endif %}
                {% if dados.getExibirApp() %}<a href="{{ dados.getApp()|default(url('app')) }}" target="_blank">Baixar App Android</a>{% endif %}
            </div>

            <div class="d-flex align-items-center justify-content-between flex-wrap" style="gap: 12px;">
                <div class="small" style="color: var(--leon-text-muted);">
                    <span class="leon-18-badge">18+</span>
                    Plataforma de apostas esportivas e entretenimento. Jogue com responsabilidade.
                </div>
                <div class="small" style="color: var(--leon-text-muted);">
                    © {{ 'now'|date('Y') }} <b>{{ dados.getBanca() }}</b>. Todos os direitos reservados.
                </div>
            </div>
        </div>
    </footer>

</div>

<!-- ============================================================
     DRAWER OFFCANVAS MOBILE
     ============================================================ -->
<div class="leon-drawer-overlay" onclick="$('html').removeClass('show-menu');"></div>
<div class="leon-drawer">
    <div class="leon-drawer-header">
        <a href="{{ url() }}" style="display: inline-flex; align-items: center; text-decoration: none;">
            {% if dados.imgCapa(true, 'logo').getSource() %}
                <img src="{{ dados.imgCapa(true, 'logo').getSource(true) }}" alt="{{ dados.getBanca() }}" style="height: 26px; max-width: 140px; object-fit: contain;"/>
            {% else %}
                <span style="font-size: 18px; font-weight: 800; color: #fff; letter-spacing: -0.5px; text-transform: uppercase;">
                    {{ dados.getBanca()|default('BRASILBET') }}
                </span>
            {% endif %}
        </a>
        <button type="button" class="close text-white" onclick="$('html').removeClass('show-menu');" aria-label="Fechar" style="font-size: 24px; opacity: 0.85; line-height: 1; padding: 4px 8px;">&times;</button>
    </div>
    <div class="leon-drawer-body">
        <a href="{{ url() }}" class="leon-drawer-item" onclick="$('html').removeClass('show-menu');">
            <i class="fa fa-futbol-o" style="color: var(--leon-green);"></i> Esportes
        </a>
        <a href="javascript:;" class="leon-drawer-item" onclick="$('html').removeClass('show-menu');">
            <i class="fa fa-play-circle" style="color: var(--leon-green);"></i> Ao Vivo
        </a>
        {% if dados.getExibirCassino() %}
        <a href="{{ url('cassino') }}" class="leon-drawer-item" onclick="$('html').removeClass('show-menu');">
            <i class="fa fa-gamepad text-warning"></i> Cassino
        </a>
        {% endif %}
        {% if dados.getExibirBilhete() %}
            <a href="{{ url('bilhete') }}" class="leon-drawer-item" onclick="$('html').removeClass('show-menu');">
                <i class="fa fa-ticket text-info"></i> Consultar Bilhete
            </a>
        {% endif %}
        {% if dados.getExibirRegras() %}
            <a href="{{ url('regras') }}" class="leon-drawer-item" onclick="$('html').removeClass('show-menu');">
                <i class="fa fa-book text-muted"></i> Regulamento
            </a>
        {% endif %}
        <a href="{{ url('termos-uso') }}" class="leon-drawer-item" onclick="$('html').removeClass('show-menu');">
            <i class="fa fa-file-text-o text-muted"></i> Termos de Uso
        </a>

        <div style="border-top: 1px solid var(--leon-border); margin: 8px 0;"></div>

        {% if not user %}
            {% if dados.getExibirLogin() %}
                <a href="#modal-login" data-toggle="modal" class="leon-drawer-item" onclick="$('html').removeClass('show-menu');">
                    <i class="fa fa-sign-in" style="color: var(--leon-green);"></i> Entrar na Conta
                </a>
            {% endif %}
            {% if dados.getExibirRegistro() %}
                <a href="{{ dados.getLinkCadastro()|default(url('cadastrar')) }}" class="leon-drawer-item" style="color: var(--leon-green); font-weight: 700;" onclick="$('html').removeClass('show-menu');">
                    <i class="fa fa-user-plus"></i> Criar Nova Conta
                </a>
            {% endif %}
        {% else %}
            <a href="{{ url('apostas') }}" class="leon-drawer-item" onclick="$('html').removeClass('show-menu');">
                <i class="fa fa-history text-muted"></i> Minhas Apostas
            </a>
            <a href="{{ url('perfil') }}" class="leon-drawer-item" onclick="$('html').removeClass('show-menu');">
                <i class="fa fa-user text-muted"></i> Perfil
            </a>
            <a href="{{ url('logout') }}" class="leon-drawer-item text-danger" onclick="$('html').removeClass('show-menu');">
                <i class="fa fa-sign-out"></i> Sair
            </a>
        {% endif %}
    </div>
</div>

<!-- ============================================================
     MOBILE BOTTOM NAVIGATION (1:1 com Leon Bet)
     ============================================================ -->
<nav class="leon-bottom-nav">
    <a href="{{ url() }}" class="leon-bottom-item{{ (controller == 'index' or controller == 'apostar' or controller == 'site' or not controller) ? ' active' : '' }}">
        <i class="fa fa-futbol-o"></i>
        <span>Esportes</span>
    </a>
    {% if dados.getExibirCassino() %}
    <a href="{{ url('cassino') }}" class="leon-bottom-item{{ controller == 'cassino' ? ' active' : '' }}">
        <i class="fa fa-gamepad"></i>
        <span>Cassino</span>
    </a>
    {% endif %}
    <a href="javascript:;" class="leon-bottom-item" onclick="$('#leonMobileBetslipModal').addClass('open');">
        <i class="fa fa-ticket"></i>
        <span class="leon-bottom-badge" id="leonMobileBadge" style="display: none;">0</span>
        <span>Boletim</span>
    </a>
    <a href="javascript:;" class="leon-bottom-item" onclick="swal('Bônus', 'Consulte os bônus com o administrador!', 'info');">
        <i class="fa fa-gift"></i>
        <span>Bônus</span>
    </a>
    {% if not user %}
        <a href="#modal-login" data-toggle="modal" class="leon-bottom-item">
            <i class="fa fa-user-circle-o"></i>
            <span>Entrar</span>
        </a>
    {% else %}
        <a href="{{ url('perfil') }}" class="leon-bottom-item{{ controller == 'perfil' ? ' active' : '' }}">
            <i class="fa fa-user"></i>
            <span>Perfil</span>
        </a>
    {% endif %}
</nav>

{{ seo_footer() }}

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.3/umd/popper.min.js"></script>
<script type="text/javascript" src="node_modules/bootstrap/dist/js/bootstrap.min.js"></script>
<script type="text/javascript" src="node_modules/sweetalert/dist/sweetalert.min.js"></script>
<script type="text/javascript" src="cdn/js/jquery.mask.js"></script>
<script type="text/javascript" src="cdn/js/jquery.form.js"></script>
<script type="text/javascript" src="cdn/js/jquery.serializeObject.js"></script>
<script type="text/javascript" src="cdn/js/fastclick.js"></script>
<script type="text/javascript" src="cdn/js/modernizr.min.js"></script>
<script type="text/javascript" src="cdn/js/mask.js"></script>
<script type="text/javascript" src="cdn/js/string.js"></script>
<script type="text/javascript" src="node_modules/owl.carousel2/dist/owl.carousel.js"></script>
<script type="text/javascript" src="cdn/js/clipboard.min.js"></script>
<script type="text/javascript" src="cdn/js/admin.js"></script>
<script type="text/javascript" src="js/site.js?v=1.0.0"></script>

<script>
    $('#modal-login')
        .adminPage({
            autoSearch: false,
            controller: 'login',
            module: 'entrar',
        })
        .on("success", function (event, e) {
            if (e.result == 1) {
                window.location.href = e.url;
            }
        });
</script>

{% block script %}{% endblock %}

{{ dados.getHtmlFooter()|raw }}

</body>
</html>