{% extends layout %}

{% block main %}

    <div class="container py-4">
        <div class="card shadow-sm border-0" style="border-radius: 8px;">
            <div class="card-header text-white font-weight-bold" style="background: var(--sidebar--color);">
                <i class="fa fa-user-circle mr-1"></i> Editar Meu Perfil
            </div>
            <div class="card-body p-4 bg-white">

                <form class="admpage-form" onsubmit="return false;">

                    <div class="mb-4">
                        <h6 class="font-weight-bold text-uppercase text-danger border-bottom pb-2 mb-3">
                            <i class="fa fa-info-circle mr-1"></i> Dados Cadastrais
                        </h6>
                        <div class="row">
                            <div class="form-group col-md-6 col-12 mb-3">
                                <label class="font-weight-bold text-dark small">NOME</label>
                                <input type="text" name="nome" class="form-control" required/>
                            </div>
                            <div class="form-group col-md-3 col-12 mb-3">
                                <label class="font-weight-bold text-dark small">USUÁRIO / LOGIN</label>
                                <input type="text" name="login" class="form-control" disabled/>
                            </div>
                            <div class="form-group col-md-3 col-12 mb-3">
                                <label class="font-weight-bold text-dark small">TELEFONE</label>
                                <input type="text" name="telefone" class="form-control mask-telefone"/>
                            </div>
                            <div class="form-group col-md-3 col-12 mb-3">
                                <label class="font-weight-bold text-dark small">CELULAR</label>
                                <input type="text" name="celular" class="form-control mask-telefone"/>
                            </div>
                            <div class="form-group col-12 col-md-3 mb-3">
                                <label class="font-weight-bold text-dark small">WHATSAPP</label>
                                <input type="text" name="whatsapp" class="form-control mask-telefone"/>
                            </div>
                            <div class="form-group col-12 col-md-6 mb-3">
                                <label class="font-weight-bold text-dark small">E-MAIL</label>
                                <input type="email" name="email" class="form-control" required/>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="font-weight-bold text-uppercase text-danger border-bottom pb-2 mb-3">
                            <i class="fa fa-key mr-1"></i> Alterar Senha
                        </h6>
                        <div class="row">
                            <div class="form-group col-12 col-md-6 mb-3">
                                <label class="font-weight-bold text-dark small">NOVA SENHA</label>
                                <input type="password" name="nsenha" class="form-control"/>
                                <small class="text-muted">Preencher somente se desejar alterar a senha</small>
                            </div>
                            <div class="form-group col-12 col-md-6 mb-3">
                                <label class="font-weight-bold text-dark small">REPITA A NOVA SENHA</label>
                                <input type="password" name="nsenhar" class="form-control"/>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="font-weight-bold text-uppercase text-danger border-bottom pb-2 mb-3">
                            <i class="fa fa-lock mr-1"></i> Confirmação
                        </h6>
                        <div class="form-group col-12 col-md-6 p-0 mb-3">
                            <label class="font-weight-bold text-dark small">SENHA ATUAL (PARA CONFIRMAR)</label>
                            <input type="password" name="senha" class="form-control" required/>
                        </div>
                    </div>

                    <div class="text-right pt-3 border-top">
                        <button class="btn btn-success px-4 py-2 font-weight-bold" type="submit">
                            <i class="fa fa-save mr-1"></i> Salvar Alterações
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>

{% endblock %}

{% block script %}
    <script>
        $('.admpage-form')
            .setValues({{ json(user) }})
            .adminPage({
                autoSearch: false,
                insertAction: 'salvar',
                controller: 'perfil',
                alertSuccess: true,
                autoReset: false,
            })
            .on('success', function (event, e) {
                if (e.result == 1) {
                    $('.admpage-form [type=password]').val('');
                }
            })
    </script>
{% endblock %}

