{% extends layout %}

{% block main %}

    <div class="page-title">
        <h3 class="title"><i class="fa fa-edit"></i> Cadastrar</h3>
    </div>

    <form class="admpage-form">

        <div class="container pt-3">
            <div class="row">
                <div class="col-md-12 col-xs-12">
                    <h4 class="m-t-0 m-b-30">
                        <i class="fa fa-id-card"></i>
                        Dados Pessoais
                    </h4>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 col-xs-12">
                    <div class="form-group">
                        <label>Nome Completo</label>
                        <input name="nome" type="text" required
                               class="form-control"/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-xs-12">
                    <div class="form-group">
                        <label>CPF</label>
                        <input name="cpf" type="text" required class="mask-cpf form-control"/>
                    </div>
                </div>
                <div class="col-md-4 col-xs-12">
                    <div class="form-group">
                        <label>Sexo</label>
                        <select name="sexo" required class="form-control">
                            <option value="m">Masculino</option>
                            <option value="f">Feminino</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4 col-xs-12">
                    <div class="form-group">
                        <label>Data Nascimento</label>
                        <input name="nascimento" type="date" required class="form-control"/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 col-xs-12">
                    <h4 style="margin-bottom : 30px !important;">
                        <i class="fa fa-map-marker" style="margin-right : 6px;"></i> Localização
                    </h4>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 col-xs-12">
                    <div class="form-group">
                        <label>CEP</label>
                        <input name="cep" type="text" required class="mask-cep form-control"/>
                    </div>
                </div>
                <div class="col-md-6 col-xs-12">
                    <div class="form-group">
                        <label>Logradouro</label>
                        <input name="logradouro" type="text" class="form-control"/>
                    </div>
                </div>
                <div class="col-md-3 col-xs-12">
                    <div class="form-group">
                        <label>Número</label>
                        <input name="numero" type="text" class="form-control"/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 col-xs-12">
                    <div class="form-group">
                        <label>Complemento</label>
                        <input name="complemento" type="text" class="form-control"/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-xs-12">
                    <div class="form-group">
                        <label>Bairro</label>
                        <input name="bairro" type="text" class="form-control"/>
                    </div>
                </div>
                <div class="col-md-3 col-xs-12">
                    <div class="form-group">
                        <label>Estado</label>
                        <select name="estado" required class="form-control">
                            {{ optEstados() }}
                        </select>
                    </div>
                </div>
                <div class="col-md-5 col-xs-12">
                    <div class="form-group">
                        <label>Cidade</label>
                        <select name="cidade" required class="form-control"></select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 col-xs-12">
                    <h4 style="margin-bottom : 30px !important;">
                        <i class="fa fa-phone" style="margin-right : 6px;"></i> Telefones de Contato
                    </h4>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-xs-12">
                    <div class="form-group">
                        <label>Telefone</label>
                        <input name="telefone" type="text" class="mask-telefone form-control"/>
                    </div>
                </div>
                <div class="col-md-4 col-xs-12">
                    <div class="form-group">
                        <label>Celular</label>
                        <input name="celular" type="text" class="mask-telefone form-control" required/>
                    </div>
                </div>
                <div class="col-md-4 col-xs-12">
                    <div class="form-group">
                        <label>Whatsapp</label>
                        <input name="whatsapp" type="text" class="mask-telefone form-control"/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 col-xs-12">
                    <h4 style="margin-bottom : 30px !important;">
                        <i class="fa fa-lock" style="margin-right : 6px;"></i> Dados de acesso
                    </h4>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 col-xs-12">
                    <div class="form-group">
                        <label>E-mail</label>
                        <input name="email" type="email" placeholder="example@email.com" required class="form-control"/>
                    </div>
                </div>
                <div class="col-md-4 col-xs-6">
                    <div class="form-group">
                        <label>Login/Usuário</label>
                        <input name="login" type="text" placeholder="Seu usuário" pattern="[A-Za-z0-9_]{5,20}" required
                               class="form-control"/>
                    </div>
                </div>
                <div class="col-md-4 col-xs-12">
                    <div class="form-group">
                        <label>Senha</label>
                        <input name="senha" type="password" placeholder="Mínimo 5 caracteres"
                               pattern="[A-Za-z0-9]{5,20}" maxlength="20" required class="form-control"/>
                    </div>
                </div>
                <div class="col-md-4 col-xs-12">
                    <div class="form-group">
                        <label>Confirmar Senha</label>
                        <input name="confirmar-senha" type="password" placeholder="Repita a senha"
                               pattern="[A-Za-z0-9]{5,20}" maxlength="20" required class="form-control"/>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-right pb-3 px-3">
            <button class="btn btn-danger" type="submit">
                <i class="fa fa-check"></i> Concluir Cadastro
            </button>
        </div>

    </form>

{% endblock %}

{% block script %}
    <script>
        $('.admpage-form')
            .adminPage({
                alertSuccess: false,
                autoSearch: false,
                autoReset: false,
                reloadSuccess: false,
                errorAlert: false,
            })
            .on('beforeSubmit', function (e, data) {
                if (data.senha !== data['confirmar-senha']) {
                    if (typeof swal === 'function') {
                        swal('Aviso', 'A confirmação da senha não confere com a senha digitada.', 'warning');
                    } else {
                        alert('A confirmação da senha não confere com a senha digitada.');
                    }
                    return false;
                }
            })
            .on('success', function (event, res) {
                if (res.result == 1) {
                    if (typeof swal === 'function') {
                        swal('Sucesso!', res.message || 'Cadastro realizado com sucesso!', 'success').then(function () {
                            window.location.href = url();
                        });
                    } else {
                        alert(res.message || 'Cadastro realizado com sucesso!');
                        window.location.href = url();
                    }
                } else {
                    if (typeof swal === 'function') {
                        swal('Erro', res.message || 'Não foi possível concluir o cadastro.', 'error');
                    } else {
                        alert(res.message || 'Não foi possível concluir o cadastro.');
                    }
                }
            });
    </script>
{% endblock %}