{% extends layout %}

{% set cat = category|default('all') %}
{% set busca = search|default('') %}

{% block main %}

    <div class="b365-main-container">
        
        <div class="b365-league-box mb-3">
            <div class="b365-league-bar">
                <div class="b365-league-title">
                    <img src="img/bet365/casino.svg" style="width: 20px; height: 20px;" alt="Cassino"/>
                    <span>Cassino Online Bet365</span>
                </div>
                <div>
                    <span class="badge" style="background: var(--b365-yellow); color: #111; font-size: 12px; font-weight: 800; border-radius: 12px; padding: 4px 12px;">
                        {{ jogos|length }} Jogos Disponíveis
                    </span>
                </div>
            </div>

            <!-- Filtros de Busca e Categorias -->
            <div class="p-3" style="background-color: var(--b365-bg-subnav); border-bottom: 1px solid var(--b365-border);">
                <div class="row align-items-center">
                    <div class="col-lg-4 col-md-5 col-sm-12 mb-2 mb-md-0">
                        <form method="get" action="{{ url('cassino') }}" class="d-flex">
                            <input type="text"
                                   name="search"
                                   value="{{ busca }}"
                                   class="form-control mr-2 bg-dark border-secondary text-white"
                                   placeholder="Buscar jogo por nome..."
                                   style="height: 38px; border-radius: 20px; padding-left: 14px;"/>
                            <button type="submit" class="b365-btn-register" style="height: 38px; padding: 0 16px;">
                                <i class="fa fa-search"></i>
                            </button>
                        </form>
                    </div>
                    <div class="col-lg-8 col-md-7 col-sm-12 text-md-right" style="overflow-x: auto; white-space: nowrap;">
                        <a href="{{ url('cassino') }}" class="btn btn-sm mb-1 {{ not busca and (cat == 'all' or not cat) ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            Todos
                        </a>
                        <a href="{{ url('cassino', null, null, {'category': 'Destaque'}) }}" class="btn btn-sm mb-1 {{ cat == 'Destaque' or cat == 'featured' or cat == 'Destaques' ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            <i class="fa fa-star text-warning"></i> Destaques
                        </a>
                        <a href="{{ url('cassino', null, null, {'category': 'Pragmatic'}) }}" class="btn btn-sm mb-1 {{ cat == 'Pragmatic' or cat == 'PRAGMATIC' ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            Pragmatic
                        </a>
                        <a href="{{ url('cassino', null, null, {'category': 'PGSOFT'}) }}" class="btn btn-sm mb-1 {{ cat == 'PGSOFT' or cat == 'PG Soft' ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            PG Soft
                        </a>
                        <a href="{{ url('cassino', null, null, {'category': 'TADA'}) }}" class="btn btn-sm mb-1 {{ cat == 'TADA' or cat == 'TaDa' ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            TaDa
                        </a>
                        <a href="{{ url('cassino', null, null, {'category': 'Crash'}) }}" class="btn btn-sm mb-1 {{ cat == 'Crash' ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            Aviator & Crash
                        </a>
                        <a href="{{ url('cassino', null, null, {'category': 'CPGAMES'}) }}" class="btn btn-sm mb-1 {{ cat == 'CPGAMES' or cat == 'CP Games' ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            CP Games
                        </a>
                        <a href="{{ url('cassino', null, null, {'category': 'WG'}) }}" class="btn btn-sm mb-1 {{ cat == 'WG' ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            WG Slots
                        </a>
                        <a href="{{ url('cassino', null, null, {'category': 'POPOK'}) }}" class="btn btn-sm mb-1 {{ cat == 'POPOK' ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            PopOK
                        </a>
                        <a href="{{ url('cassino', null, null, {'category': 'G759'}) }}" class="btn btn-sm mb-1 {{ cat == 'G759' ? 'b365-btn-register' : 'b365-btn-rewards' }}" style="border-radius: 20px; padding: 4px 14px;">
                            G759
                        </a>
                    </div>
                </div>
            </div>

            <!-- Grade de Jogos com Capas Oficiais -->
            <div class="p-3" style="background-color: var(--b365-bg-card);">
                {% if jogos|length > 0 %}
                    <div class="row">
                        {% for j in jogos %}
                            <div class="col-xl-2 col-lg-3 col-md-4 col-6 mb-4">
                                <div class="b365-game-card h-100 d-flex flex-column" style="overflow: hidden; border-radius: 8px; border: 1px solid #2e2e2e; background: #1c1c1c; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 16px rgba(0,216,122,0.2)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                                    <div style="position: relative; background: #000; padding-top: 100%; overflow: hidden;">
                                        <img src="{{ j.image|default(j.cover)|default(j.banner) }}"
                                             alt="{{ j.name }}"
                                             style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;"
                                             onerror="this.src='{{ url('imagens/sem-imagem.png') }}'"
                                             loading="lazy"/>
                                        
                                        <span class="badge" style="position: absolute; top: 6px; right: 6px; font-size: 10px; font-weight: bold; padding: 3px 6px; border-radius: 4px; background: rgba(0,0,0,0.85); color: var(--b365-yellow); border: 1px solid var(--b365-yellow);">
                                            {{ j.provider|default('Slots') }}
                                        </span>

                                        {% if j.featured %}
                                            <span class="badge" style="position: absolute; top: 6px; left: 6px; font-size: 10px; font-weight: bold; padding: 3px 6px; border-radius: 4px; background: var(--b365-teal-accent); color: #000;">
                                                ★ Destaque
                                            </span>
                                        {% endif %}
                                    </div>
                                    <div class="p-2 text-center flex-grow-1 d-flex flex-column justify-content-between" style="background: #181818;">
                                        <div class="font-weight-bold text-truncate small text-white" title="{{ j.name }}">{{ j.name }}</div>
                                        <div class="d-flex justify-content-between align-items-center mt-1" style="font-size: 11px; color: #888;">
                                            <span>RTP {{ j.rtp }}%</span>
                                            <span class="text-muted"><i class="fa fa-eye"></i> {{ j.views_count }}</span>
                                        </div>
                                        <a href="{{ url('cassino/jogar', [j.game_code|default(j.code)]) }}" class="b365-btn-bet-action w-100 mt-2" style="height: 32px; font-size: 12px; border-radius: 4px; text-decoration: none;">
                                            <i class="fa fa-play mr-1"></i> Jogar Agora
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-5 text-muted">
                        <i class="fa fa-frown-o fa-3x mb-3 text-warning"></i>
                        <h5>Nenhum jogo encontrado</h5>
                        <p class="small">Tente pesquisar por outro nome ou selecionar outra categoria.</p>
                        <a href="{{ url('cassino') }}" class="b365-btn-register mt-2">
                            Ver Todos os Jogos
                        </a>
                    </div>
                {% endif %}
            </div>

        </div>

    </div>

{% endblock %}
